@model NexusArena.Web.Models.ReceptionistDashboardViewModel

@{
    ViewData["Title"] = "Live Dashboard";
    Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";
}

<style>
    .kpi-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }
    .kpi-title { color: #aaa; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px;}
    .kpi-value { font-size: 28px; font-weight: bold; margin: 0; }
    
    .live-grid {
        background-color: #1a1a1a;
        border-radius: 12px;
        border: 1px solid #333;
        padding: 20px;
        margin-top: 25px;
    }
    
    .table-dark { background-color: transparent; color: #fff; }
    .table-dark th { color: #00ff7f; border-bottom: 1px solid #333; font-size: 13px; text-transform: uppercase; padding: 15px;}
    .table-dark td { padding: 15px; border-bottom: 1px solid #2a2a2a; vertical-align: middle; }
    
    .time-alert {
        background-color: rgba(255, 77, 77, 0.15);
        border-left: 4px solid #ff4d4d !important;
        animation: pulseRed 2s infinite;
    }
    
    @@keyframes pulseRed {
        0% { background-color: rgba(255, 77, 77, 0.05); }
        50% { background-color: rgba(255, 77, 77, 0.2); }
        100% { background-color: rgba(255, 77, 77, 0.05); }
    }

    .btn-collect {
        background-color: #00ff7f;
        color: #000;
        border: none;
        padding: 6px 12px;
        font-weight: 600;
        border-radius: 4px;
        font-size: 12px;
        cursor: pointer;
    }
    .btn-collect:hover { background-color: #00cc66; }
</style>

<div class="container-fluid mt-3">
    @if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" style="background-color: #ff4d4d; color: white; font-weight: bold; border-radius: 8px; padding: 15px;">
        @ViewBag.ErrorMessage
    </div>
}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #fff; font-weight: bold;"><i class="fas fa-broadcast-tower text-success"></i> Live Action</h2>
        <button class="btn btn-success" style="background-color: #00ff7f; color: #000; font-weight: bold; border: none; padding: 8px 15px; border-radius: 5px;">
            <i class="fas fa-plus"></i> Walk-in Booking
        </button>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Pending Cash Today</div>
                <div class="kpi-value text-danger">₹@Model.TotalPendingCash</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Today's Bookings</div>
                <div class="kpi-value text-white">@Model.TodayBookingsCount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-title">Available Turfs</div>
                <div class="kpi-value" style="color: #00ff7f;">@Model.AvailableTurfsCount</div>
            </div>
        </div>
    </div>

    <div class="live-grid">
        <h4 class="mb-3 text-white">Active Now</h4>
        <table class="table table-dark w-100">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Customer Name</th>
                    <th>Turf</th>
                    <th>Time Slot</th>
                    <th>Pending Cash</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var booking in Model.LiveBookings)
                {
                    <tr class="@(booking.IsTimeUpWarning ? "time-alert" : "")">
                        <td style="color: #aaa;">#@booking.BookingId</td>
                        <td class="text-white font-weight-bold">@booking.CustomerName</td>
                        <td style="color: #00ff7f;">@booking.TurfName</td>
                        <td>
                            @booking.TimeSlot
                            @if(booking.IsTimeUpWarning) {
                                <br><small class="text-danger font-weight-bold"><i class="fas fa-clock"></i> Time almost up!</small>
                            }
                        </td>
                        <td>
                            @if(booking.PendingAmount > 0) {
                                <span class="text-danger font-weight-bold">₹@booking.PendingAmount</span>
                            } else {
                                <span class="text-success"><i class="fas fa-check-circle"></i> Paid</span>
                            }
                        </td>
                        <td>
                            @if(booking.PendingAmount > 0) {
                                <button class="btn-collect"><i class="fas fa-hand-holding-usd"></i> Collect</button>
                            }
                            <button class="btn btn-sm btn-outline-light" style="margin-left: 8px;"><i class="fas fa-sign-out-alt"></i> Checkout</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>