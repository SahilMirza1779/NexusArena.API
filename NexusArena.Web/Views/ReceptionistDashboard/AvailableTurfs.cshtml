@{
    ViewData["Title"] = "Available Turfs";
    Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";
}

<div class="container-fluid mt-4">
    <h2 style="color: #fff;">Available Turfs</h2>
    <p style="color: #aaa;">The ones currently available for booking.</p>

    <div class="row">
        <div class="col-md-4">
            <div class="card bg-dark text-white p-3 border-success">
                <h5>Box 1</h5>
                <p>Status: <span class="text-success">Available</span></p>
                <button class="btn btn-outline-success btn-sm">Book Now</button>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card bg-dark text-white p-3 border-success">
                <h5>Box 2</h5>
                <p>Status: <span class="text-success">Available</span></p>
                <button class="btn btn-outline-success btn-sm">Book Now</button>
            </div>
        </div>
    </div>
</div>