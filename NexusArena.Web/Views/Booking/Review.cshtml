@{
    ViewData["Title"] = "Booking Review";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
    
    // Total aur Half price
    decimal totalAmount = ViewBag.TotalBill != null ? Convert.ToDecimal(ViewBag.TotalBill) : 0;
    decimal halfAmount = totalAmount / 2;
}

<style>
    .review-wrapper { max-width: 650px; margin: 40px auto; padding-bottom: 50px; }
    
    .page-header { margin-bottom: 30px; text-align: center; }
    .page-header h1 { margin: 0; color: #fff; font-size: 32px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
    .page-header h1 span { color: #00ff7f; }
    .page-header p { margin: 10px 0 0; color: #aaa; font-size: 15px; }

    .summary-card { background-color: #1a1a1a; padding: 35px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border-top: 5px solid #00ff7f; }
    
    .details-box { background-color: #0f0f0f; padding: 25px; border-radius: 10px; margin-bottom: 25px; border: 1px solid #2a2a2a; }
    .details-box p { color: #888; margin: 0 0 15px 0; font-size: 13px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; }
    
    .detail-row { color: #fff; margin: 0 0 15px 0; font-size: 20px; font-weight: 600; display: flex; align-items: center; gap: 12px; }
    .detail-row i { color: #00ff7f; font-size: 22px; width: 25px; text-align: center; }
    
    .divider { border: 0; height: 1px; background: #2a2a2a; margin-bottom: 20px; margin-top: 20px; }

    /* Payment Options Styling */
    .payment-title { color: #fff; font-size: 16px; font-weight: 700; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; }
    
    .payment-option { display: block; position: relative; padding: 18px 20px; margin-bottom: 15px; border: 2px solid #2a2a2a; border-radius: 10px; cursor: pointer; transition: 0.3s; background: #111; }
    .payment-option:hover { border-color: #555; }
    .payment-option input { position: absolute; opacity: 0; cursor: pointer; }
    
    /* Checked State */
    .payment-option input:checked ~ .option-content { color: #00ff7f; }
    .payment-option input:checked { border-color: #00ff7f; }
    .payment-option.active { border-color: #00ff7f; background: rgba(0, 255, 127, 0.05); }

    .option-content { display: flex; justify-content: space-between; align-items: center; font-size: 16px; font-weight: 700; color: #ccc; transition: 0.3s; }
    .option-desc { font-size: 12px; color: #888; font-weight: 600; margin-top: 5px; }

    .price-row { display: flex; justify-content: space-between; align-items: center; margin-top: 30px; margin-bottom: 25px; }
    .price-label { color: #aaa; font-size: 16px; font-weight: 600; }
    .price-amount { color: #00ff7f; font-size: 34px; font-weight: 800; transition: 0.3s; }

    .btn-confirm { width: 100%; background-color: #00ff7f; color: #000; border: none; padding: 16px; border-radius: 10px; font-weight: 800; font-size: 18px; cursor: pointer; transition: 0.3s; box-shadow: 0 5px 20px rgba(0, 255, 127, 0.2); letter-spacing: 1px; }
    .btn-confirm:hover { background-color: #00cc66; box-shadow: 0 8px 25px rgba(0, 255, 127, 0.4); transform: translateY(-2px); }
    
    .btn-back { display: flex; justify-content: center; align-items: center; gap: 8px; color: #888; text-decoration: none; margin-top: 20px; font-weight: 600; transition: 0.3s; }
    .btn-back:hover { color: #fff; }
</style>

<div class="review-wrapper">
    <div class="page-header">
        <h1>Review <span>Booking</span> 📋</h1>
        <p>Choose your payment option to secure the turf.</p>
    </div>

    <div class="summary-card">
        
        <div class="details-box">
            <p>Match Details</p>
            <div class="detail-row"><i class="fas fa-calendar-day"></i> @ViewBag.Date</div>
            
            @if (ViewBag.BookingMode == "Hourly")
            {
                <div class="detail-row"><i class="far fa-clock"></i> @ViewBag.StartTime to @ViewBag.EndTime</div>
            }
            else
            {
                <div class="detail-row"><i class="fas fa-trophy"></i> Tournament: @ViewBag.TournamentPackage</div>
            }
        </div>

        <form method="post" action="@Url.Action("Confirm", "Booking")" id="paymentForm">
            <input type="hidden" name="arenaId" value="@ViewBag.ArenaId" />
            <input type="hidden" name="playDate" value="@ViewBag.Date" />
            <input type="hidden" name="startTime" value="@ViewBag.StartTime" />
            <input type="hidden" name="endTime" value="@ViewBag.EndTime" />
            <input type="hidden" name="bookingMode" value="@ViewBag.BookingMode" />
            <input type="hidden" name="tournamentPackage" value="@ViewBag.TournamentPackage" />
            
            <h3 class="payment-title"><i class="fas fa-wallet" style="color: #00ff7f; margin-right: 8px;"></i> Select Payment Option</h3>

            <label class="payment-option active" id="opt-half">
                <input type="radio" name="paymentMode" value="Advance50" checked onchange="updatePrice('Half', @halfAmount)">
                <div class="option-content">
                    <span>Pay 50% Advance</span>
                    <span>₹ @halfAmount</span>
                </div>
                <div class="option-desc">Secure your slot now. Pay remaining ₹ @halfAmount at the turf.</div>
            </label>

            <label class="payment-option" id="opt-full">
                <input type="radio" name="paymentMode" value="Full" onchange="updatePrice('Full', @totalAmount)">
                <div class="option-content">
                    <span>Pay 100% Now</span>
                    <span>₹ @totalAmount</span>
                </div>
                <div class="option-desc">Complete payment online. No cash needed at turf.</div>
            </label>

            <hr class="divider" />

            <div class="price-row">
                <span class="price-label">Amount to Pay Now</span>
                <span class="price-amount" id="displayAmount">₹ @halfAmount</span>
            </div>
            
            <button type="submit" class="btn-confirm" id="btnSubmit">
                PROCEED TO PAY <i class="fas fa-arrow-right" style="margin-left: 5px;"></i>
            </button>
        </form>
        
        <a href="javascript:history.back()" class="btn-back">
            <i class="fas fa-arrow-left"></i> Go Back to Edit
        </a>
    </div>
</div>

<script>
    function updatePrice(type, amount) {
        document.getElementById('displayAmount').innerText = '₹ ' + amount;

        document.getElementById('opt-full').classList.remove('active');
        document.getElementById('opt-half').classList.remove('active');

        if(type === 'Full') document.getElementById('opt-full').classList.add('active');
        if(type === 'Half') document.getElementById('opt-half').classList.add('active');
    }
</script>