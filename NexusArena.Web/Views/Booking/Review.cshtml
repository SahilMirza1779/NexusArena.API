@{
    ViewData["Title"] = "Booking Review";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<style>
    /* Main Layout */
    .review-wrapper { max-width: 600px; margin: 40px auto; padding-bottom: 50px; }
    
    /* Header */
    .page-header { margin-bottom: 30px; text-align: center; }
    .page-header h1 { margin: 0; color: #fff; font-size: 32px; font-weight: 800; }
    .page-header h1 span { color: #00ff7f; }
    .page-header p { margin: 10px 0 0; color: #aaa; font-size: 15px; }

    /* Summary Card */
    .summary-card { background-color: #1a1a1a; padding: 35px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border-top: 5px solid #00ff7f; }
    
    .details-box { background-color: #0f0f0f; padding: 25px; border-radius: 10px; margin-bottom: 25px; border: 1px solid #2a2a2a; }
    .details-box p { color: #888; margin: 0 0 15px 0; font-size: 13px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; }
    
    .detail-row { color: #fff; margin: 0 0 15px 0; font-size: 20px; font-weight: 600; display: flex; align-items: center; gap: 12px; }
    .detail-row i { color: #00ff7f; font-size: 22px; width: 25px; text-align: center; }
    .detail-row:last-of-type { margin-bottom: 25px; }

    .divider { border: 0; height: 1px; background: #2a2a2a; margin-bottom: 20px; }

    .price-row { display: flex; justify-content: space-between; align-items: center; }
    .price-label { color: #aaa; font-size: 16px; font-weight: 600; }
    .price-amount { color: #00ff7f; font-size: 32px; font-weight: 800; }

    /* Buttons */
    .btn-confirm { width: 100%; background-color: #00ff7f; color: #000; border: none; padding: 16px; border-radius: 10px; font-weight: 800; font-size: 18px; cursor: pointer; transition: 0.3s; box-shadow: 0 5px 20px rgba(0, 255, 127, 0.2); letter-spacing: 1px; }
    .btn-confirm:hover { background-color: #00cc66; box-shadow: 0 8px 25px rgba(0, 255, 127, 0.4); transform: translateY(-2px); }
    
    .btn-back { display: flex; justify-content: center; align-items: center; gap: 8px; color: #888; text-decoration: none; margin-top: 20px; font-weight: 600; transition: 0.3s; }
    .btn-back:hover { color: #fff; }
</style>

<div class="review-wrapper">
    
    <div class="page-header">
        <h1>Review <span>Booking</span> 📋</h1>
        <p>Please verify your match details before confirming.</p>
    </div>

    <div class="summary-card">
        
        <div class="details-box">
            <p>Match Date & Time</p>
            <div class="detail-row">
                <i class="fas fa-calendar-day"></i> @ViewBag.Date
            </div>
            <div class="detail-row">
                <i class="far fa-clock"></i> @ViewBag.StartTime - @ViewBag.EndTime
            </div>

            <hr class="divider" />

            <div class="price-row">
                <span class="price-label">Total Amount</span>
                <span class="price-amount">₹ @ViewBag.Price</span>
            </div>
        </div>

        <form method="post" action="/Booking/Confirm">
            <input type="hidden" name="arenaId" value="@ViewBag.ArenaId" />
            <input type="hidden" name="slotId" value="@ViewBag.SlotId" />
            <input type="hidden" name="playDate" value="@ViewBag.Date" />
            
            <button type="submit" class="btn-confirm">
                CONFIRM BOOKING <i class="fas fa-check-circle" style="margin-left: 5px;"></i>
            </button>
        </form>
        
        <a href="javascript:history.back()" class="btn-back">
            <i class="fas fa-arrow-left"></i> Go Back
        </a>
        
    </div>
</div>