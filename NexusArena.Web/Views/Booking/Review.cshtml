@{
    ViewData["Title"] = "Booking Review";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<div style="margin-bottom: 30px;">
    <h1 style="margin: 0; font-size: 2rem; font-weight: 800; color: #fff;">Review <span style="color: #00ff66;">Booking</span> 📋</h1>
    <p style="color: #888; font-size: 1rem; margin-top: 10px;">Please verify your match details before confirming.</p>
</div>

<div style="max-width: 600px; background-color: #1a1a1a; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); border-top: 5px solid #00ff66;">
    
    <div style="background-color: #0f0f0f; padding: 20px; border-radius: 8px; margin-bottom: 25px; border: 1px solid #2a2a2a;">
        <p style="color: #aaa; margin: 0 0 10px 0; font-size: 0.9rem; text-transform: uppercase; font-weight: 600;">Match Date & Time</p>
        <h3 style="color: #fff; margin: 0 0 5px 0; font-size: 1.3rem;"><i class="fas fa-calendar-day" style="color: #00ff66; margin-right: 10px;"></i> @ViewBag.Date</h3>
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1.3rem;"><i class="far fa-clock" style="color: #00ff66; margin-right: 10px;"></i> @ViewBag.StartTime - @ViewBag.EndTime</h3>

        <hr style="border-color: #2a2a2a; margin-bottom: 20px;" />

        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #aaa; font-size: 1.1rem; font-weight: 600;">Total Amount</span>
            <span style="color: #00ff66; font-size: 1.8rem; font-weight: 800;">₹ @ViewBag.Price</span>
        </div>
    </div>

    <form method="post" action="/Booking/Confirm">
        <input type="hidden" name="arenaId" value="@ViewBag.ArenaId" />
        <input type="hidden" name="slotId" value="@ViewBag.SlotId" />
        <input type="hidden" name="playDate" value="@ViewBag.Date" />
        
        <button type="submit" style="width: 100%; background-color: #00ff66; color: #111; border: none; padding: 15px; border-radius: 8px; font-weight: 800; font-size: 1.1rem; cursor: pointer; transition: 0.3s; box-shadow: 0 4px 15px rgba(0, 255, 102, 0.3);" onmouseover="this.style.backgroundColor='#00e65c'" onmouseout="this.style.backgroundColor='#00ff66'">
            CONFIRM BOOKING
        </button>
    </form>
    
    <a href="javascript:history.back()" style="display: block; text-align: center; color: #888; text-decoration: none; margin-top: 15px; font-weight: 600; transition: 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#888'">
        <i class="fas fa-arrow-left"></i> Go Back
    </a>
</div>