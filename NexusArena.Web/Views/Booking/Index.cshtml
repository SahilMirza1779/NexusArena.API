@model List<NexusArena.Web.Controllers.SlotViewModel>
@{
    ViewData["Title"] = "Available Slots";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<div style="margin-bottom: 30px;">
    <h1 style="margin: 0; font-size: 2.2rem; font-weight: 800; color: #fff;">Book Your <span style="color: #00ff66;">Slot</span> ⏱️</h1>
    <p style="color: #888; font-size: 1rem; margin-top: 10px;">Select a date and time for your match.</p>
</div>

<div style="background-color: #1a1a1a; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); display: flex; align-items: center; gap: 20px; margin-bottom: 30px;">
    <form method="get" action="/Booking/Index" style="display: flex; align-items: center; gap: 15px; width: 100%;">
        <input type="hidden" name="arenaId" value="@ViewBag.ArenaId" />
        
        <label style="color: #fff; font-weight: bold; font-size: 1.1rem;">Select Date:</label>
        <input type="date" name="date" value="@ViewBag.SelectedDate" required
               style="padding: 12px; border-radius: 6px; border: 1px solid #333; background-color: #0f0f0f; color: #fff; outline: none; font-size: 1rem;" />
        
        <button type="submit" style="background-color: #00ff66; color: #111; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.3s;" onmouseover="this.style.backgroundColor='#00e65c'" onmouseout="this.style.backgroundColor='#00ff66'">
            Check Slots
        </button>
    </form>
</div>

@if (ViewBag.Error != null)
{
    <div style="background-color: #ff4c4c; color: #fff; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: bold;">
        @ViewBag.Error
    </div>
}

<div style="display: flex; flex-wrap: wrap; gap: 20px;">
    @if (Model != null && Model.Any())
    {
        foreach (var slot in Model)
        {
            <div style="background-color: #1a1a1a; border: 1px solid #333; padding: 20px; border-radius: 10px; width: 220px; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                <h3 style="color: #fff; margin: 0 0 10px 0; font-size: 1.2rem;">@slot.startTime - @slot.endTime</h3>
                <h2 style="color: #00ff66; margin: 0 0 20px 0;">₹ @slot.price</h2>

                @if (slot.isAvailable)
                {
                    <a href="/Booking/Review?arenaId=@ViewBag.ArenaId&date=@ViewBag.SelectedDate&slotId=@slot.slotId&startTime=@slot.startTime&endTime=@slot.endTime&price=@slot.price"
                           style="display: block; background-color: transparent; color: #00ff66; border: 1px solid #00ff66; padding: 10px; border-radius: 6px; text-decoration: none; font-weight: bold; transition: 0.3s;"
                           onmouseover="this.style.backgroundColor='#00ff66'; this.style.color='#111';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#00ff66';">
                        BOOK NOW
                    </a>
                }
                else
                {
                    <button disabled style="width: 100%; background-color: #333; color: #888; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: not-allowed;">
                        BOOKED
                    </button>
                }
            </div>
        }
    }
    else
    {
        <p style="color: #888; font-size: 1.1rem; width: 100%; text-align: center;">Is date par koi slot available nahi hai. Kripya doosri date try karein.</p>
    }
</div>