@{
    ViewData["Title"] = "Book Your Turf";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">

<style>
    .booking-wrapper { max-width: 900px; margin: 40px auto; padding-bottom: 50px; }
    .page-header { margin-bottom: 30px; text-align: center; }
    .page-header h1 { color: #fff; font-size: 36px; font-weight: 900; margin: 0; letter-spacing: 1px; text-transform: uppercase; }
    .page-header h1 span { color: #00ff66; }
    .page-header p { color: #888; margin-top: 10px; font-size: 16px; }

    .engine-card { background: linear-gradient(145deg, #111, #161616); padding: 40px; border-radius: 16px; border: 1px solid #2a2a2a; box-shadow: 0 10px 40px rgba(0,0,0,0.6); }
    
    .form-group { margin-bottom: 25px; }
    .form-label { color: #fff; font-weight: 700; font-size: 15px; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
    
    .premium-input { 
        width: 100%; padding: 15px 20px; border-radius: 8px; border: 1px solid #333; 
        background-color: #0a0a0a; color: #fff; font-size: 16px; outline: none; transition: 0.3s; 
        font-weight: 600; cursor: pointer;
    }
    .premium-input:focus, .premium-input:hover { border-color: #00ff66; box-shadow: 0 0 15px rgba(0,255,102,0.15); background-color: #0f0f0f; }
    
    .time-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    
    .mode-selector { display: flex; gap: 15px; margin-bottom: 30px; background: #0a0a0a; padding: 5px; border-radius: 10px; border: 1px solid #222; }
    .mode-btn { flex: 1; padding: 15px; text-align: center; background: transparent; color: #666; border-radius: 8px; cursor: pointer; font-weight: 800; text-transform: uppercase; transition: 0.3s; letter-spacing: 1px; }
    .mode-btn.active { background: #00ff66; color: #000; box-shadow: 0 4px 15px rgba(0,255,102,0.3); }

    .bill-card { background: #0a0a0a; border: 1px solid #222; border-radius: 12px; padding: 25px; margin-top: 30px; text-align: center; position: relative; overflow: hidden; }
    .bill-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: #00ff66; }
    .bill-title { color: #888; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; font-weight: 700; }
    .bill-amount { color: #00ff66; font-size: 42px; font-weight: 900; margin: 0; }
    
    .btn-submit { width: 100%; background: #00ff66; color: #000; border: none; padding: 18px; border-radius: 8px; font-size: 18px; font-weight: 900; text-transform: uppercase; letter-spacing: 1.5px; cursor: pointer; transition: 0.3s; margin-top: 25px; display: flex; justify-content: center; align-items: center; gap: 10px; }
    .btn-submit:hover { background: #00cc52; transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,255,102,0.4); }

    .error-alert { background-color: rgba(255, 76, 76, 0.1); border-left: 4px solid #ff4c4c; color: #ff4c4c; padding: 15px; border-radius: 6px; margin-bottom: 25px; font-weight: 600; font-size: 15px; display: flex; align-items: center; gap: 10px; }
</style>

<div class="booking-wrapper">
    <div class="page-header">
        <h1>Smart <span>Booking</span> ⏱️</h1>
        <p>Dynamic engine activated. Select your exact date and playtime.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-alert"><i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="error-alert"><i class="fas fa-exclamation-triangle"></i> @ViewBag.Error</div>
    }
    
    <div class="engine-card">
        <form method="post" action="@Url.Action("Review", "Booking")" id="bookingForm">
            <input type="hidden" name="arenaId" value="@ViewBag.ArenaId" />
            
            <div class="form-group">
                <label class="form-label"><i class="far fa-calendar-alt" style="color: #00ff66; font-size: 18px;"></i> Play Date</label>
                <input type="text" id="playDate" name="date" class="premium-input" required placeholder="Pick a Match Date" />
            </div>

            <div class="mode-selector">
                <div class="mode-btn active" id="btnHourly" onclick="switchMode('Hourly')"><i class="fas fa-stopwatch"></i> Hourly Play</div>
                <div class="mode-btn" id="btnTournament" onclick="switchMode('Tournament')"><i class="fas fa-trophy"></i> Event / Tournament</div>
            </div>

            <input type="hidden" name="bookingMode" id="bookingMode" value="Hourly" />

            <div id="hourlySection" class="time-grid">
                <div class="form-group">
                    <label class="form-label"><i class="far fa-clock" style="color: #00ff66;"></i> Start Time</label>
                    <input type="text" id="startTime" name="startTime" class="premium-input" placeholder="e.g. 14:00" />
                </div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-flag-checkered" style="color: #00ff66;"></i> End Time</label>
                    <input type="text" id="endTime" name="endTime" class="premium-input" placeholder="e.g. 16:00" />
                </div>
            </div>

            <div id="tournamentSection" class="form-group" style="display:none;">
                <label class="form-label"><i class="fas fa-box-open" style="color: #00ff66;"></i> Select Package</label>
                <select name="tournamentPackage" id="tournamentPackage" class="premium-input">
                    <option value="">-- Choose Package --</option>
                    <option value="HalfDayMorning">Morning Half-Day (7 AM - 2 PM)</option>
                    <option value="HalfDayEvening">Evening Half-Day (2 PM - 9 PM)</option>
                    <option value="FullDay">Full Day (7 AM - 10 PM)</option>
                </select>
            </div>

            <div class="bill-card">
                <div class="bill-title">Estimated Live Total</div>
                <h2 class="bill-amount">₹ <span id="displayBill">0</span></h2>
                <input type="hidden" name="totalBill" id="totalBill" value="0" />
            </div>

            <input type="hidden" name="paymentMode" value="Full" />

            <button type="button" class="btn-submit" onclick="submitBooking()">
                Review Booking <i class="fas fa-arrow-right"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let today = new Date();
            let nextMonth = new Date(today.getFullYear(), today.getMonth() + 2, 0);

            // Date Picker
            flatpickr("#playDate", {
                minDate: "today",               
                maxDate: nextMonth,        
                dateFormat: "Y-m-d",
                altInput: true,                 
                altFormat: "F j, Y",
                defaultDate: "@ViewBag.SelectedDate"
            });

            // Time Pickers
            flatpickr("#startTime", { enableTime: true, noCalendar: true, dateFormat: "H:i", time_24hr: true, onChange: calculateBill });
            flatpickr("#endTime", { enableTime: true, noCalendar: true, dateFormat: "H:i", time_24hr: true, onChange: calculateBill });
            
            document.getElementById('tournamentPackage').addEventListener('change', calculateBill);
        });

        function switchMode(mode) {
            document.getElementById('bookingMode').value = mode;
            
            if (mode === 'Hourly') {
                document.getElementById('btnHourly').classList.add('active');
                document.getElementById('btnTournament').classList.remove('active');
                document.getElementById('hourlySection').style.display = 'grid';
                document.getElementById('tournamentSection').style.display = 'none';
            } else {
                document.getElementById('btnTournament').classList.add('active');
                document.getElementById('btnHourly').classList.remove('active');
                document.getElementById('hourlySection').style.display = 'none';
                document.getElementById('tournamentSection').style.display = 'block';
            }
            calculateBill();
        }

        // Live Dynamic Price Calculator
        function calculateBill() {
            let regularRate = 1200; 
            let peakRate = 1800;    
            let total = 0;
            
            let mode = document.getElementById('bookingMode').value;
            
            if (mode === 'Hourly') {
                let start = document.getElementById('startTime').value;
                let end = document.getElementById('endTime').value;
                
                if (start && end) {
                    let startHour = parseInt(start.split(':')[0]);
                    let endHour = parseInt(end.split(':')[0]);
                    
                    if (endHour <= startHour) endHour += 24; // Agar match raat 12 baje ke baad tak hai

                    for (let h = startHour; h < endHour; h++) {
                        let current = h % 24;
                        if (current >= 7 && current < 17) total += regularRate;
                        else total += peakRate;
                    }
                }
            } else {
                let pkg = document.getElementById('tournamentPackage').value;
                if (pkg === 'HalfDayMorning') total = 5000;
                if (pkg === 'HalfDayEvening') total = 7000;
                if (pkg === 'FullDay') total = 10000;
            }

            document.getElementById('displayBill').innerText = total.toLocaleString('en-IN');
            document.getElementById('totalBill').value = total;
        }

        function submitBooking() {
            let total = parseInt(document.getElementById('totalBill').value);
            let date = document.getElementById('playDate').value;
            
            if (!date) {
                Swal.fire({ icon: 'error', title: 'Date Missing', text: 'Please select a play date first.', background: '#1a1a1a', color: '#fff' });
                return;
            }

            if (total <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Time Selection Incomplete',
                    text: 'Please select Start/End time or a Tournament package to calculate the bill.',
                    background: '#1a1a1a', color: '#fff'
                });
                return;
            }
            
            document.getElementById('bookingForm').submit();
        }
    </script>
}