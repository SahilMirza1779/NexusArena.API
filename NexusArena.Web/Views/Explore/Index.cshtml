@model List<NexusArena.Web.Controllers.ArenaViewModel>

@{
    ViewData["Title"] = "Explore Turfs";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<style>
    /* Main Layout Containers */
    .explore-container { margin-top: 20px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .page-header h2 { margin: 0; color: #fff; font-size: 24px; }
    .page-header h2 span { color: #00ff7f; }
    .page-header p { margin: 5px 0 0; color: #aaa; font-size: 14px; }

    /* Search Box Section */
    .search-container { background-color: #1a1a1a; border-radius: 12px; padding: 25px; border: 1px solid #333; box-shadow: 0 4px 15px rgba(0,0,0,0.2); margin-bottom: 30px; }
    .search-form { display: flex; gap: 15px; align-items: center; }
    
    .form-control { flex: 1; padding: 12px 15px; background-color: #222; border: 1px solid #333; color: white; border-radius: 6px; font-size: 14px; outline: none; transition: 0.3s; }
    .form-control:focus { border-color: #00ff7f; }
    
    .select-area { width: 200px; padding: 12px 15px; background-color: #222; border: 1px solid #333; color: white; border-radius: 6px; font-size: 14px; outline: none; transition: 0.3s; }
    .select-area:focus { border-color: #00ff7f; }

    /* Buttons */
    .btn-search { background-color: #00ff7f; color: #000; border: none; padding: 12px 25px; border-radius: 6px; font-weight: 600; cursor: pointer; transition: 0.3s; }
    .btn-search:hover { background-color: #00cc66; }
    
    .btn-reset { background-color: transparent; color: #aaa; border: 1px solid #555; padding: 12px 25px; border-radius: 6px; text-decoration: none; font-weight: 600; transition: 0.3s; display: inline-block; }
    .btn-reset:hover { background-color: #333; color: #fff; }

    /* Error Message */
    .error-msg { color: #ff4c4c; background-color: rgba(255, 76, 76, 0.1); padding: 12px 15px; border-radius: 6px; font-size: 14px; margin-bottom: 20px; border: 1px solid rgba(255, 76, 76, 0.2); }

    /* Turf Grid & Cards */
    .turf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 25px; }
    
    .turf-card { background-color: #1a1a1a; border-radius: 12px; border: 1px solid #333; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.3s, border-color 0.3s; }
    .turf-card:hover { transform: translateY(-5px); border-color: #444; }
    
    .turf-img-box { height: 180px; background-color: #222; display: flex; justify-content: center; align-items: center; position: relative; }
    .turf-img-box i { font-size: 50px; color: #444; }
    
    .premium-badge { position: absolute; top: 15px; right: 15px; background: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
    
    .turf-info { padding: 20px; }
    .turf-title { margin: 0 0 10px 0; color: #fff; font-size: 18px; }
    .turf-location { color: #aaa; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 6px; }
    .turf-location i { color: #00bfff; }

    .action-buttons { display: flex; gap: 10px; }
    .btn-check { flex: 1; text-align: center; background-color: transparent; color: #00ff7f; border: 1px solid #00ff7f; padding: 10px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 13px; transition: 0.3s; }
    .btn-check:hover { background-color: rgba(0, 255, 127, 0.1); }
    
    .btn-map { width: 40px; display: flex; justify-content: center; align-items: center; background-color: #2a2a2a; color: #ccc; border: 1px solid #333; border-radius: 6px; text-decoration: none; transition: 0.3s; }
    .btn-map:hover { background-color: #333; color: #fff; }

    /* No Data Container */
    .no-data { text-align: center; padding: 50px; background-color: #1a1a1a; border-radius: 12px; border: 1px dashed #444; color: #888; grid-column: 1 / -1; }
    .no-data i { font-size: 40px; color: #555; margin-bottom: 15px; }
</style>

<div class="explore-container">
    
    <div class="page-header">
        <div>
            <h2>Explore <span>Turfs</span></h2>
            <p>Find the best premium arenas near you and lock your slot.</p>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="error-msg">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
        </div>
    }

    <div class="search-container">
        <form method="get" action="/Explore/Index" class="search-form">
            
            <input type="text" name="searchTerm" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by Turf Name or City (e.g. Dream Box)">

            <select name="area" class="select-area">
                @if (string.IsNullOrEmpty(ViewBag.CurrentArea)) { <option value="" selected>All Areas</option> } else { <option value="">All Areas</option> }
                @if (ViewBag.CurrentArea == "Vesu") { <option value="Vesu" selected>Vesu</option> } else { <option value="Vesu">Vesu</option> }
                @if (ViewBag.CurrentArea == "Adajan") { <option value="Adajan" selected>Adajan</option> } else { <option value="Adajan">Adajan</option> }
                @if (ViewBag.CurrentArea == "Piplod") { <option value="Piplod" selected>Piplod</option> } else { <option value="Piplod">Piplod</option> }
                @if (ViewBag.CurrentArea == "Pal") { <option value="Pal" selected>Pal</option> } else { <option value="Pal">Pal</option> }
            </select>

            <button type="submit" class="btn-search">
                <i class="fas fa-search"></i> Search
            </button>
            
            <a href="/Explore/Index" class="btn-reset">Reset</a>
            
        </form>
    </div>

    <div class="turf-grid">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var arena in Model)
            {
                <div class="turf-card">
                    
                    <div class="turf-img-box">
                        <i class="fas fa-map-marked-alt"></i>
                        <span class="premium-badge"><i class="fas fa-star"></i> Premium</span>
                    </div>

                    <div class="turf-info">
                        <h3 class="turf-title">@arena.name</h3>
                        
                        <div class="turf-location">
                            <i class="fas fa-map-marker-alt"></i>
                            @(string.IsNullOrEmpty(arena.location) ? "Location not updated" : arena.location), @arena.city
                        </div>

                        <div class="action-buttons">
                            <a href="/Booking/CheckSlots/@arena.arenaId" class="btn-check">
                                Check Slots <i class="fas fa-arrow-right" style="margin-left: 5px;"></i>
                            </a>
                            
                            <a href="https://maps.google.com/?q=@arena.name @arena.city" target="_blank" class="btn-map" title="View on Map">
                                <i class="fas fa-map"></i>
                            </a>
                        </div>
                    </div>

                </div>
            }
        }
        else if (ViewBag.Error == null)
        {
            <div class="no-data">
                <i class="fas fa-search-minus"></i>
                <h3 style="margin: 0; color: #ccc;">No arenas match your filters</h3>
                <p style="margin: 5px 0 0; font-size: 13px;">Try changing your search text or selecting a different area.</p>
            </div>
        }
    </div>

</div>