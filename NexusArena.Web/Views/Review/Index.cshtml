@model NexusArena.Web.Controllers.ReviewPageViewModel
@{
    ViewData["Title"] = "My Reviews";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<div style="margin-bottom: 40px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;">
    <div>
        <h1 style="margin: 0; font-size: 2.5rem; font-weight: 800; color: #fff; letter-spacing: -0.5px;">Share Your <span style="color: #00ff66;">Experience</span> ⭐</h1>
        <p style="color: #888; font-size: 1.1rem; margin-top: 10px;">Rate the turfs you've played at and manage your feedback.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div style="background: rgba(0,255,102,0.1); color: #00ff66; border: 1px solid #00ff66; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: 600;">
        <i class="fas fa-check-circle"></i> @Html.Raw(TempData["Success"])
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="background: rgba(255,71,87,0.1); color: #ff4757; border: 1px solid #ff4757; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: 600;">
        <i class="fas fa-exclamation-circle"></i> @Html.Raw(TempData["Error"])
    </div>
}

<div style="display: flex; gap: 40px; flex-wrap: wrap; align-items: flex-start;">
    
    <div style="flex: 1; min-width: 350px; background: linear-gradient(145deg, #161616, #1a1a1a); padding: 35px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); border: 1px solid #2a2a2a; position: sticky; top: 20px;">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 25px; font-size: 1.4rem; font-weight: 700; display: flex; align-items: center; gap: 10px;">
            <i class="fas fa-pen-nib" style="color: #00ff66;"></i> Write a Review
        </h3>
        
        <form method="post" action="/Review/Add">
            <div style="margin-bottom: 20px;">
                <label style="color: #bbb; font-size: 0.9rem; font-weight: 600; display: block; margin-bottom: 8px;">Select Turf</label>
                <select name="arenaId" required style="width: 100%; padding: 14px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 8px; outline: none; font-size: 1rem; transition: all 0.3s ease;">
                    <option value="" disabled selected>-- Select a Turf --</option>
                    @if (Model?.Arenas != null)
                    {
                        foreach (var arena in Model.Arenas)
                        {
                            <option value="@arena.arenaId">@arena.name</option>
                        }
                    }
                </select>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="color: #bbb; font-size: 0.9rem; font-weight: 600; display: block; margin-bottom: 8px;">Your Rating</label>
                <select name="rating" required style="width: 100%; padding: 14px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 8px; outline: none; font-size: 1rem;">
                    <option value="5">⭐⭐⭐⭐⭐ - Excellent</option>
                    <option value="4">⭐⭐⭐⭐ - Good</option>
                    <option value="3">⭐⭐⭐ - Average</option>
                    <option value="2">⭐⭐ - Poor</option>
                    <option value="1">⭐ - Terrible</option>
                </select>
            </div>

            <div style="margin-bottom: 30px;">
                <label style="color: #bbb; font-size: 0.9rem; font-weight: 600; display: block; margin-bottom: 8px;">Comment</label>
                <textarea name="comment" rows="4" placeholder="How was the pitch quality and overall vibe?" required style="width: 100%; padding: 14px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 8px; outline: none; resize: vertical;"></textarea>
            </div>

            <button type="submit" style="width: 100%; background-color: #00ff66; color: #111; border: none; padding: 16px; border-radius: 8px; font-weight: 800; font-size: 1.1rem; cursor: pointer; text-transform: uppercase;">
                Submit Review
            </button>
        </form>
    </div>

    <div style="flex: 2; min-width: 400px;">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 25px; font-size: 1.4rem; font-weight: 700; border-bottom: 1px solid #2a2a2a; padding-bottom: 10px;">My Past Reviews</h3>
        
        @if (Model?.MyReviews != null && Model.MyReviews.Any())
        {
            <div style="display: flex; flex-direction: column; gap: 25px;">
                @foreach (var review in Model.MyReviews)
                {
                    <div style="background: linear-gradient(145deg, #111, #161616); padding: 25px; border-radius: 12px; border: 1px solid #2a2a2a; position: relative; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.3);">
                        
                        <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background-color: #00ff66; box-shadow: 0 0 10px #00ff66;"></div>
                        
                        <div id="displayMode_@review.reviewId" style="padding-left: 10px;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                                <div>
                                    <h4 style="margin: 0 0 8px 0; color: #fff; font-size: 1.3rem; font-weight: 800; letter-spacing: 0.5px;">@review.arenaName</h4>
                                    <div style="background: rgba(255, 204, 0, 0.1); display: inline-block; padding: 4px 10px; border-radius: 20px; border: 1px solid rgba(255, 204, 0, 0.2); font-size: 0.9rem;">
                                        @for (int i = 0; i < review.rating; i++)
                                        {
                                            <span style="color: #ffcc00;">⭐</span>
                                        }
                                    </div>
                                </div>
                                <span style="background-color: rgba(0, 255, 102, 0.1); color: #00ff66; padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; border: 1px solid rgba(0, 255, 102, 0.3);">
                                    <i class="far fa-calendar-alt" style="margin-right: 5px;"></i> @review.date.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            
                            <div style="background-color: #0a0a0a; padding: 15px; border-radius: 8px; border: 1px solid #222; margin-bottom: 20px;">
                                <p style="margin: 0; color: #ccc; font-size: 1.05rem; line-height: 1.6; font-style: italic;">"@review.comment"</p>
                            </div>
                            
                            <div style="display: flex; gap: 15px;">
                                <button onclick="toggleEdit(@review.reviewId)" style="background-color: rgba(0, 195, 255, 0.1); border: 1px solid rgba(0, 195, 255, 0.3); color: #00c3ff; border-radius: 8px; padding: 8px 20px; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                
                                <form id="deleteReviewForm_@review.reviewId" method="post" action="/Review/Delete" style="margin: 0;">
                                    <input type="hidden" name="reviewId" value="@review.reviewId" />
                                    <button type="button" onclick="confirmDelete(@review.reviewId)" style="background-color: rgba(255, 76, 76, 0.1); border: 1px solid rgba(255, 76, 76, 0.3); color: #ff4c4c; border-radius: 8px; padding: 8px 20px; font-weight: 600; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div id="editMode_@review.reviewId" style="display: none; padding-left: 10px;">
                            <form method="post" action="/Review/Edit" style="background-color: #0f0f0f; padding: 25px; border-radius: 12px; border: 1px solid #333;">
                                <h4 style="margin: 0 0 15px 0; color: #00c3ff; font-size: 1.1rem; border-bottom: 1px dashed #333; padding-bottom: 10px;">Editing Review</h4>
                                
                                <input type="hidden" name="reviewId" value="@review.reviewId" />
                                <input type="hidden" name="arenaId" value="1" />
                                
                                <div style="margin-bottom: 20px;">
                                    <label style="color: #bbb; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block;">Update Rating</label>
                                    <select name="rating" required style="width: 100%; padding: 12px; background-color: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 8px;">
                                        <option value="5" selected="@(review.rating == 5 ? "selected" : null)">⭐⭐⭐⭐⭐ (5 Stars)</option>
                                        <option value="4" selected="@(review.rating == 4 ? "selected" : null)">⭐⭐⭐⭐ (4 Stars)</option>
                                        <option value="3" selected="@(review.rating == 3 ? "selected" : null)">⭐⭐⭐ (3 Stars)</option>
                                        <option value="2" selected="@(review.rating == 2 ? "selected" : null)">⭐⭐ (2 Stars)</option>
                                        <option value="1" selected="@(review.rating == 1 ? "selected" : null)">⭐ (1 Star)</option>
                                    </select>
                                </div>
                                <div style="margin-bottom: 25px;">
                                    <label style="color: #bbb; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block;">Update Comment</label>
                                    <textarea name="comment" rows="3" required style="width: 100%; padding: 12px; background-color: #1a1a1a; border: 1px solid #333; color: #fff; border-radius: 8px;">@review.comment</textarea>
                                </div>
                                <div style="display: flex; gap: 15px;">
                                    <button type="submit" style="background-color: #00c3ff; color: #111; border: none; padding: 10px 25px; border-radius: 8px; font-weight: 800; cursor: pointer;">
                                        <i class="fas fa-save"></i> Save
                                    </button>
                                    <button type="button" onclick="toggleEdit(@review.reviewId)" style="background-color: transparent; color: #aaa; border: 1px solid #555; padding: 10px 25px; border-radius: 8px; font-weight: 800; cursor: pointer;">
                                        Cancel
                                    </button>
                                </div>
                            </form>
                        </div>

                    </div>
                }
            </div>
        }
        else
        {
            <div style="background: linear-gradient(145deg, #161616, #1a1a1a); padding: 50px 20px; text-align: center; border-radius: 16px; border: 1px dashed #3a3a3a;">
                <div style="width: 80px; height: 80px; background: rgba(0, 255, 102, 0.05); border-radius: 50%; display: flex; justify-content: center; align-items: center; margin: 0 auto 20px auto; border: 1px solid rgba(0, 255, 102, 0.1);">
                    <i class="fas fa-comment-slash" style="font-size: 2.5rem; color: #555;"></i>
                </div>
                <h3 style="color: #fff; margin: 0 0 10px 0; font-size: 1.5rem;">No reviews yet</h3>
                <p style="color: #888; margin: 0; font-size: 1rem;">Your feedback helps others choose the best turf.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleEdit(id) {
        var displayDiv = document.getElementById('displayMode_' + id);
        var editDiv = document.getElementById('editMode_' + id);
        if (displayDiv.style.display === 'none') {
        displayDiv.style.display = 'block';
        editDiv.style.display = 'none';
        } else {
        displayDiv.style.display = 'none';
        editDiv.style.display = 'block';
        }
        }

        function confirmDelete(id) {
        Swal.fire({
        title: 'Delete Review?',
        text: "This action cannot be undone.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ff4c4c',
        cancelButtonColor: '#333',
        confirmButtonText: 'Yes, delete it',
        background: '#1a1a1a',
        color: '#fff'
        }).then((result) => {
        if (result.isConfirmed) {
        document.getElementById('deleteReviewForm_' + id).submit();
        }
        });
        }
    </script>
}