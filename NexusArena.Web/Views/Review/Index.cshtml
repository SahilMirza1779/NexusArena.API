@model NexusArena.Web.Controllers.ReviewPageViewModel
@{
    ViewData["Title"] = "My Reviews";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<div style="max-width: 1000px; margin: 0 auto; padding-bottom: 40px;">
    <div style="margin-bottom: 40px; text-align: center;">
        <h1 style="margin: 0; font-size: 2.8rem; font-weight: 800; color: #fff; letter-spacing: -0.5px;">My <span style="color: #00ff66;">Reviews</span> ⭐</h1>
        <p style="color: #888; font-size: 1.1rem; margin-top: 10px;">Manage all your past match feedback from here.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background: rgba(0,255,102,0.1); color: #00ff66; border: 1px solid #00ff66; padding: 15px; border-radius: 8px; margin-bottom: 25px; font-weight: 600; text-align: center;">
            <i class="fas fa-check-circle"></i> @Html.Raw(TempData["Success"])
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: rgba(255,71,87,0.1); color: #ff4757; border: 1px solid #ff4757; padding: 15px; border-radius: 8px; margin-bottom: 25px; font-weight: 600; text-align: center;">
            <i class="fas fa-exclamation-circle"></i> @Html.Raw(TempData["Error"])
        </div>
    }

    <div>
        @if (Model?.MyReviews != null && Model.MyReviews.Any())
        {
            <!-- 🌟 FILTER & SORTING BAR -->
            <div style="display: flex; justify-content: space-between; align-items: center; background: #161616; padding: 15px 25px; border-radius: 12px; border: 1px solid #333; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                <div style="color: #fff; font-weight: 700; font-size: 1.1rem;">
                    <i class="fas fa-sliders-h" style="color: #00ff66; margin-right: 8px;"></i> Filters
                </div>
                <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                    <select id="filterRating" onchange="resetAndApplyFilters()" style="background: #0a0a0a; color: #fff; border: 1px solid #444; padding: 10px 15px; border-radius: 8px; outline: none; font-weight: 600;">
                        <option value="all">All Ratings</option>
                        <option value="5">⭐⭐⭐⭐⭐ (5 Stars)</option>
                        <option value="4">⭐⭐⭐⭐ (4 Stars)</option>
                        <option value="3">⭐⭐⭐ (3 Stars)</option>
                        <option value="2">⭐⭐ (2 Stars)</option>
                        <option value="1">⭐ (1 Star)</option>
                    </select>

                    <select id="sortOrder" onchange="applyFiltersAndSort()" style="background: #0a0a0a; color: #fff; border: 1px solid #444; padding: 10px 15px; border-radius: 8px; outline: none; font-weight: 600;">
                        <option value="newest">Newest First</option>
                        <option value="oldest">Oldest First</option>
                        <option value="highest">Highest Rating</option>
                        <option value="lowest">Lowest Rating</option>
                    </select>
                </div>
            </div>

            <!-- REVIEWS CONTAINER -->
            <div id="reviewsContainer" style="display: flex; flex-direction: column; gap: 25px;">
                @foreach (var review in Model.MyReviews)
                {
                    <!-- 🌟 DATA ATTRIBUTES ADDED FOR JS FILTERING & SORTING -->
                    <div class="review-item-container" data-rating="@review.Rating" data-date="@review.Date.ToString("yyyy-MM-ddTHH:mm:ss")" style="background: linear-gradient(145deg, #111, #161616); padding: 30px; border-radius: 16px; border: 1px solid #2a2a2a; position: relative; overflow: hidden; box-shadow: 0 5px 25px rgba(0,0,0,0.5);">
                        <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background-color: #00ff66; box-shadow: 0 0 15px #00ff66;"></div>
                        
                        <div id="displayMode_@review.ReviewId" style="padding-left: 15px;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                                <div>
                                    <h4 style="margin: 0 0 5px 0; color: #fff; font-size: 1.5rem; font-weight: 800;">@review.ArenaName</h4>
                                    <div style="font-size: 0.9rem; color: #00ff66; font-weight: 600; margin-bottom: 5px;">
                                        <i class="fas fa-ticket-alt"></i> Booking Reference: #@(review.BookingId ?? 0)
                                    </div>
                                </div>
                                <span style="background-color: rgba(0, 255, 102, 0.1); color: #00ff66; padding: 8px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 700; border: 1px solid rgba(0, 255, 102, 0.3);">
                                    <i class="far fa-calendar-alt" style="margin-right: 5px;"></i> @review.Date.ToString("dd MMM yyyy")
                                </span>
                            </div>

                            <div style="margin-bottom: 20px;">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <span style="color: #ffcc00; font-size: 1.1rem;">⭐</span>
                                }
                            </div>
                            
                            <div style="background-color: #0a0a0a; padding: 18px; border-radius: 10px; border: 1px solid #222; margin-bottom: 20px;">
                                <p style="margin: 0; color: #ddd; font-size: 1.1rem; line-height: 1.6; font-style: italic;">"@review.Comment"</p>
                            </div>
                            
                            <div style="display: flex; gap: 15px;">
                                <button onclick="toggleEdit(@review.ReviewId)" style="background-color: rgba(0, 195, 255, 0.1); border: 1px solid rgba(0, 195, 255, 0.3); color: #00c3ff; border-radius: 8px; padding: 10px 25px; font-weight: 700; cursor: pointer; transition: 0.3s;">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <form id="deleteReviewForm_@review.ReviewId" method="post" action="/Review/Delete" style="margin: 0;">
                                    <input type="hidden" name="reviewId" value="@review.ReviewId" />
                                    <button type="button" onclick="confirmDelete(@review.ReviewId)" style="background-color: rgba(255, 76, 76, 0.1); border: 1px solid rgba(255, 76, 76, 0.3); color: #ff4c4c; border-radius: 8px; padding: 10px 25px; font-weight: 700; cursor: pointer; transition: 0.3s;">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Edit Form -->
                        <div id="editMode_@review.ReviewId" style="display: none; padding-left: 15px;">
                            <form method="post" action="/Review/Edit" style="background-color: #0a0a0a; padding: 25px; border-radius: 12px; border: 1px solid #333;">
                                <h4 style="margin: 0 0 20px 0; color: #00c3ff; font-size: 1.2rem; border-bottom: 1px dashed #333; padding-bottom: 10px;">Editing Match Review</h4>
                                <input type="hidden" name="reviewId" value="@review.ReviewId" />
                                <input type="hidden" name="arenaId" value="@review.ArenaId" />
                                <div style="margin-bottom: 20px;">
                                    <label style="color: #bbb; font-size: 0.9rem; font-weight: 600; margin-bottom: 8px; display: block;">Update Rating</label>
                                    <select name="rating" required style="width: 100%; padding: 14px; background-color: #161616; border: 1px solid #333; color: #fff; border-radius: 8px;">
                                        @for (int r = 5; r >= 1; r--)
                                        {
                                            <option value="@r" selected="@(review.Rating == r ? "selected" : null)">@r Stars</option>
                                        }
                                    </select>
                                </div>
                                <div style="margin-bottom: 25px;">
                                    <label style="color: #bbb; font-size: 0.9rem; font-weight: 600; margin-bottom: 8px; display: block;">Update Comment</label>
                                    <textarea name="comment" rows="3" required style="width: 100%; padding: 14px; background-color: #161616; border: 1px solid #333; color: #fff; border-radius: 8px;">@review.Comment</textarea>
                                </div>
                                <div style="display: flex; gap: 15px;">
                                    <button type="submit" style="background-color: #00c3ff; color: #111; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 800; cursor: pointer;">Save Changes</button>
                                    <button type="button" onclick="toggleEdit(@review.ReviewId)" style="background-color: transparent; color: #aaa; border: 1px solid #555; padding: 12px 30px; border-radius: 8px; font-weight: 800; cursor: pointer;">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <!-- 🌟 PAGINATION CONTROLS -->
            <div id="paginationControls" style="display: flex; justify-content: center; gap: 10px; margin-top: 35px;">
                <!-- Buttons JS se inject honge -->
            </div>
        }
        else
        {
            <div style="background: linear-gradient(145deg, #161616, #1a1a1a); padding: 60px 20px; text-align: center; border-radius: 16px; border: 1px dashed #3a3a3a;">
                <i class="fas fa-comment-slash" style="font-size: 3.5rem; color: #444; margin-bottom: 20px;"></i>
                <h3 style="color: #fff; margin: 0 0 10px 0; font-size: 1.8rem;">No match reviews yet!</h3>
                <p style="color: #888;">Go to your Booking History to rate a match.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // -----------------------------------------------------
        // 🌟 ENTERPRISE LEVEL JS: PAGINATION, FILTER & SORTING
        // -----------------------------------------------------
        
        let currentPage = 1;
        const itemsPerPage = 5; // Ek page par 5 reviews dikhenge
        const allReviews = Array.from(document.querySelectorAll('.review-item-container'));
        const container = document.getElementById('reviewsContainer');
        const paginationContainer = document.getElementById('paginationControls');

        function resetAndApplyFilters() {
        currentPage = 1; // Filter change hone par wapas Page 1 par bhejo
        applyFiltersAndSort();
        }

        function applyFiltersAndSort() {
        if(allReviews.length === 0) return;

        const filterVal = document.getElementById('filterRating').value;
        const sortVal = document.getElementById('sortOrder').value;

        // 1. FILTERING
        let filteredReviews = allReviews.filter(card => {
        return filterVal === 'all' || card.getAttribute('data-rating') === filterVal;
        });

        // 2. SORTING
        filteredReviews.sort((a, b) => {
        const dateA = new Date(a.getAttribute('data-date'));
        const dateB = new Date(b.getAttribute('data-date'));
        const ratingA = parseInt(a.getAttribute('data-rating'));
        const ratingB = parseInt(b.getAttribute('data-rating'));

        if (sortVal === 'newest') return dateB - dateA;
        if (sortVal === 'oldest') return dateA - dateB;
        if (sortVal === 'highest') return ratingB - ratingA;
        if (sortVal === 'lowest') return ratingA - ratingB;
        });

        // 3. RE-ATTACH SORTED ITEMS TO DOM
        container.innerHTML = '';
        filteredReviews.forEach(card => container.appendChild(card));

        // 4. PAGINATION LOGIC
        const totalPages = Math.ceil(filteredReviews.length / itemsPerPage) || 1;
        if (currentPage > totalPages) currentPage = totalPages;

        const startIdx = (currentPage - 1) * itemsPerPage;
        const endIdx = startIdx + itemsPerPage;

        // Hide All, Show Paginated
        filteredReviews.forEach((card, index) => {
        if (index >= startIdx && index < endIdx) {
        card.style.display = 'block';
        } else {
        card.style.display = 'none';
        }
        });

        renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
        paginationContainer.innerHTML = '';
        if (totalPages <= 1) return;

        // Prev Button
        const prevBtn = document.createElement('button');
        prevBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
        prevBtn.disabled = currentPage === 1;
        prevBtn.style.cssText = `background: ${currentPage === 1 ? '#222' : '#00ff66'}; color: ${currentPage === 1 ? '#555' : '#000'}; border: none; padding: 10px 15px; border-radius: 8px; cursor: ${currentPage === 1 ? 'not-allowed' : 'pointer'}; font-weight: bold;`;
        prevBtn.onclick = () => { if(currentPage > 1) { currentPage--; applyFiltersAndSort(); window.scrollTo(0, 0); } };
        paginationContainer.appendChild(prevBtn);

        // Page Numbers
        for (let i = 1; i <= totalPages; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.innerText = i;
        const isActive = (i === currentPage);
        pageBtn.style.cssText = `background: ${isActive ? '#00ff66' : '#111'}; color: ${isActive ? '#000' : '#fff'}; border: 1px solid ${isActive ? '#00ff66' : '#333'}; padding: 10px 18px; border-radius: 8px; cursor: pointer; font-weight: bold;`;
        pageBtn.onclick = () => { currentPage = i; applyFiltersAndSort(); window.scrollTo(0, 0); };
        paginationContainer.appendChild(pageBtn);
        }

        // Next Button
        const nextBtn = document.createElement('button');
        nextBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.style.cssText = `background: ${currentPage === totalPages ? '#222' : '#00ff66'}; color: ${currentPage === totalPages ? '#555' : '#000'}; border: none; padding: 10px 15px; border-radius: 8px; cursor: ${currentPage === totalPages ? 'not-allowed' : 'pointer'}; font-weight: bold;`;
        nextBtn.onclick = () => { if(currentPage < totalPages) { currentPage++; applyFiltersAndSort(); window.scrollTo(0, 0); } };
        paginationContainer.appendChild(nextBtn);
        }

        // Initialize on load (Newest First lag kar aayega)
        document.addEventListener('DOMContentLoaded', () => {
        applyFiltersAndSort();
        });

        // -----------------------------------------------------
        // 🌟 EDIT / DELETE LOGIC
        // -----------------------------------------------------
        function toggleEdit(id) {
        var displayDiv = document.getElementById('displayMode_' + id);
        var editDiv = document.getElementById('editMode_' + id);
        displayDiv.style.display = (displayDiv.style.display === 'none') ? 'block' : 'none';
        editDiv.style.display = (editDiv.style.display === 'none') ? 'block' : 'none';
        }
        
        function confirmDelete(id) {
        Swal.fire({ title: 'Delete Review?', text: "This action cannot be undone.", icon: 'warning', showCancelButton: true, confirmButtonColor: '#ff4c4c', background: '#1a1a1a', color: '#fff' })
        .then((result) => { if (result.isConfirmed) document.getElementById('deleteReviewForm_' + id).submit(); });
        }
    </script>
}