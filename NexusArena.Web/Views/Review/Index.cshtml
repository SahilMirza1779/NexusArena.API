@model NexusArena.Web.Controllers.ReviewPageViewModel
@{
    ViewData["Title"] = "My Reviews";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<div style="margin-bottom: 30px;">
    <h1 style="margin: 0; font-size: 2.2rem; font-weight: 800; color: #fff;">Share Your <span style="color: #00ff66;">Experience</span> ⭐</h1>
    <p style="color: #888; font-size: 1rem; margin-top: 10px;">Rate the turfs you've played at.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background-color: #00ff66; color: #111; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: bold;">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<div style="display: flex; gap: 30px; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 300px; background-color: #1a1a1a; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
        <h3 style="color: #fff; margin-top: 0; border-bottom: 2px solid #333; padding-bottom: 10px;">Write a Review</h3>
        
        <form method="post" action="/Review/Add">
            <div style="margin-bottom: 15px;">
                <label style="color: #aaa; font-size: 0.9rem; display: block; margin-bottom: 5px;">Select Turf</label>
                <select name="arenaId" required style="width: 100%; padding: 12px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 6px; outline: none;">
                    <option value="">-- Turf Chuniye --</option>
                    @if (Model?.Arenas != null)
                    {
                        foreach (var arena in Model.Arenas)
                        {
                            <option value="@arena.arenaId">@arena.name</option>
                        }
                    }
                </select>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="color: #aaa; font-size: 0.9rem; display: block; margin-bottom: 5px;">Your Rating</label>
                <select name="rating" required style="width: 100%; padding: 12px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 6px; outline: none;">
                    <option value="5">⭐⭐⭐⭐⭐ - Excellent</option>
                    <option value="4">⭐⭐⭐⭐ - Good</option>
                    <option value="3">⭐⭐⭐ - Average</option>
                    <option value="2">⭐⭐ - Poor</option>
                    <option value="1">⭐ - Terrible</option>
                </select>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="color: #aaa; font-size: 0.9rem; display: block; margin-bottom: 5px;">Comment</label>
                <textarea name="comment" rows="4" placeholder="Turf kaisa laga? Pitch ki quality kaisi thi?" required style="width: 100%; padding: 12px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 6px; outline: none; box-sizing: border-box;"></textarea>
            </div>

            <button type="submit" style="width: 100%; background-color: #00ff66; color: #111; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.3s;" onmouseover="this.style.backgroundColor='#00e65c'" onmouseout="this.style.backgroundColor='#00ff66'">
                SUBMIT REVIEW
            </button>
        </form>
    </div>

    <div style="flex: 2; min-width: 400px;">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 20px;">My Past Reviews</h3>
        
        @if (Model?.MyReviews != null && Model.MyReviews.Any())
        {
            foreach (var review in Model.MyReviews)
            {
                <div style="background-color: #1a1a1a; padding: 20px; border-radius: 8px; margin-bottom: 15px; border-left: 4px solid #00ff66;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <h4 style="margin: 0; color: #fff; font-size: 1.2rem;">@review.arenaName</h4>
                        <span style="color: #888; font-size: 0.8rem;">@review.date.ToString("dd MMM yyyy")</span>
                    </div>
                    <div style="color: #ffcc00; margin-bottom: 10px;">
                        @for (int i = 0; i < review.rating; i++)
                        {
                            <span>⭐</span>
                        }
                    </div>
                    <p style="margin: 0; color: #ccc; font-style: italic;">"@review.comment"</p>
                </div>
            }
        }
        else
        {
            <div style="background-color: #1a1a1a; padding: 30px; text-align: center; border-radius: 8px;">
                <p style="color: #888; margin: 0;">Aapne abhi tak koi review nahi diya hai.</p>
            </div>
        }
    </div>
</div>