@model IEnumerable<NexusArena.Web.Models.BookingHistoryViewModel>

@{
    ViewData["Title"] = "My Booking History";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<style>
    .history-container { max-width: 1100px; margin: 40px auto; padding-bottom: 50px; }
    
    .page-header-wrapper { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 25px; }
    .page-header h2 { color: #fff; font-weight: 800; font-size: 32px; margin: 0; }
    .page-header h2 span { color: #00ff7f; }
    .page-header p { color: #888; margin-top: 5px; margin-bottom: 0; font-size: 14px; }

    .controls-wrapper { display: flex; align-items: center; gap: 15px; flex-wrap: wrap; }
    
    .status-tabs { display: flex; gap: 5px; background: #111; padding: 6px; border-radius: 10px; border: 1px solid #2a2a2a; }
    .tab-btn { background: transparent; color: #888; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 700; font-size: 12px; text-transform: uppercase; cursor: pointer; transition: 0.3s; letter-spacing: 0.5px; }
    .tab-btn:hover { color: #fff; background: #1a1a1a; }
    .tab-btn.active { background: #00ff7f; color: #000; box-shadow: 0 4px 15px rgba(0,255,127,0.2); }

    .custom-search { background: #0a0a0a; border: 1px solid #2a2a2a; color: #fff; padding: 10px 15px; border-radius: 8px; outline: none; font-size: 13px; min-width: 200px; transition: 0.3s; }
    .custom-search:focus { border-color: #00ff7f; }

    .table-container { background: #111; border-radius: 15px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border: 1px solid #222; overflow-x: auto; }
    .custom-table { width: 100%; border-collapse: collapse; color: #ccc; }
    .custom-table th { background: #1a1a1a; color: #00ff7f; padding: 15px; text-transform: uppercase; font-size: 12px; letter-spacing: 1px; text-align: left; border-bottom: 2px solid #333; }
    .custom-table td { padding: 15px; border-bottom: 1px solid #222; vertical-align: middle; font-size: 14px; }
    .custom-table tr:hover { background: #151515; }

    .turf-name { color: #fff; font-weight: 700; font-size: 16px; }
    .turf-city { color: #888; font-size: 12px; }

    .price-box { display: flex; flex-direction: column; gap: 3px; }
    .price-paid { color: #00ff7f; font-weight: 700; }
    .price-pending { color: #ff4757; font-size: 12px; font-weight: 600; }

    .badge { padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
    .bg-success-custom { background: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f; }
    .bg-warning-custom { background: rgba(255, 165, 0, 0.1); color: #ffa500; border: 1px solid #ffa500; }
    .bg-danger-custom { background: rgba(255, 71, 87, 0.1); color: #ff4757; border: 1px solid #ff4757; }

    .btn-cancel { background: transparent; color: #ff4757; border: 1px solid #ff4757; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; transition: 0.3s; }
    .btn-cancel:hover { background: #ff4757; color: #fff; }
    
    .btn-invoice { background: #00ff7f; color: #000; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; transition: 0.3s; text-decoration: none; display: inline-block; margin-top: 5px; }
    .btn-invoice:hover { background: #00cc66; }

    .btn-rate { background: #ffcc00; color: #000; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; transition: 0.3s; text-decoration: none; display: inline-block; margin-top: 5px; }
    .btn-rate:hover { background: #e6b800; box-shadow: 0 0 10px rgba(255, 204, 0, 0.4); }

    .pagination-container { margin-top: 25px; display: flex; justify-content: center; gap: 8px; }
    .page-btn { background: #111; color: #fff; border: 1px solid #333; padding: 8px 16px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.3s; }
    .page-btn.active { background: #00ff7f; color: #000; border-color: #00ff7f; }
    .page-btn:hover:not(.active) { background: #1a1a1a; border-color: #00ff7f; }
</style>

<div class="history-container">
    
    <div class="page-header-wrapper">
        <div class="page-header">
            <h2>My <span>Bookings</span> 🏟️</h2>
            <p>Track your matches, payments, and digital tickets.</p>
        </div>
        
        <div class="controls-wrapper">
            <input type="text" id="customSearch" class="custom-search" placeholder="Search turf, date, ID...">
            <div class="status-tabs">
                <button class="tab-btn active" onclick="filterTable('All', this)">All</button>
                <button class="tab-btn" onclick="filterTable('Upcoming', this)">Upcoming</button>
                <button class="tab-btn" onclick="filterTable('Completed', this)">Completed</button>
                <button class="tab-btn" onclick="filterTable('Cancelled', this)">Cancelled</button>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="background: rgba(0,255,127,0.1); color: #00ff7f; border: 1px solid #00ff7f; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            <i class="fas fa-check-circle"></i> @Html.Raw(TempData["Success"])
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="background: rgba(255,71,87,0.1); color: #ff4757; border: 1px solid #ff4757; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            <i class="fas fa-exclamation-circle"></i> @Html.Raw(TempData["Error"])
        </div>
    }

    <div class="table-container">
        @if (Model != null && Model.Any())
        {
            <table class="custom-table" id="bookingTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Turf Details</th>
                        <th>Date & Time</th>
                        <th>Payment Stats</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(m => m.BookingId))
                    {
                        string filterCategory = "Upcoming";
                        if (item.Status == "Cancelled" || item.Status == "Expired") filterCategory = "Cancelled";
                        else if (item.Status == "Completed") filterCategory = "Completed";

                        <tr class="table-row" data-category="@filterCategory">
                            <td style="color: #666; font-weight: 600;">#@item.BookingId</td>
                            <td>
                                <div class="turf-name">@item.ArenaName</div>
                                <div class="turf-city"><i class="fas fa-map-marker-alt"></i> @item.City</div>
                            </td>
                            <td>
                                <div style="color: #fff; font-weight: 600;">@item.PlayDate</div>
                                <div style="color: #aaa; font-size: 13px;">@item.TimeSlot</div>
                            </td>
                            <td>
                                <div class="price-box">
                                    <span style="font-size: 12px; color: #888;">Total: ₹@item.TotalAmount</span>
                                    <span class="price-paid">Paid: ₹@item.AmountPaid</span>
                                    @if (item.PendingAmount > 0 && item.Status != "Cancelled" && item.Status != "Expired")
                                    {
                                        <span class="price-pending">Due at Turf: ₹@item.PendingAmount</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger-custom">Cancelled</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge" style="background: rgba(0, 195, 255, 0.1); color: #00c3ff; border: 1px solid #00c3ff;"><i class="fas fa-check-double"></i> Completed</span>
                                }
                                else if (item.Status == "Expired")
                                {
                                    <span class="badge" style="background: rgba(136, 136, 136, 0.1); color: #888; border: 1px solid #555;"><i class="fas fa-times"></i> Expired</span>
                                }
                                else if (item.PaymentStatus == "Paid" || item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success-custom"><i class="fas fa-check"></i> Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-custom">Pending</span>
                                }
                            </td>
                            <td>
                                @if (item.CanCancel)
                                {
                                    <form id="cancel-form-@item.BookingId" method="post" action="@Url.Action("Cancel", "BookingHistory", new { bookingId = item.BookingId })" style="display:inline-block; margin-bottom:5px;">
                                        <button type="button" class="btn-cancel" onclick="confirmCancel(@item.BookingId)">Cancel</button>
                                    </form>
                                }

                                @if(item.PaymentStatus == "Paid" || item.Status == "Confirmed" || item.Status == "Completed")
                                {
                                    <a href="@Url.Action("Ticket", "BookingHistory", new { id = item.BookingId })" class="btn-invoice" target="_blank" style="display:inline-block; margin-bottom:5px;">
                                        <i class="fas fa-ticket-alt"></i> View Ticket
                                    </a>
                                    <br/>
                                    
                                    <!-- 🌟 THE FIX: Agar IsRated sach hai, toh RATED dikhao, warna Button dikhao -->
                                    @if (item.IsRated)
                                    {
                                        <span style="display:inline-block; margin-top: 5px; color: #00ff66; font-size: 12px; font-weight: 700; background: rgba(0, 255, 102, 0.1); padding: 6px 12px; border-radius: 6px; border: 1px solid rgba(0, 255, 102, 0.3);">
                                            <i class="fas fa-check-circle"></i> Rated
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-rate" onclick="openRateModal(@item.ArenaId, '@item.ArenaName', @item.BookingId)" style="display:inline-block;">
                                            <i class="fas fa-star"></i> Rate Turf
                                        </button>
                                    }
                                }
                                else if (!item.CanCancel)
                                {
                                    <span style="color: #555; font-size: 13px;">No actions</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            <div id="noResultsMsg" style="display:none; text-align: center; padding: 30px; color: #888;">
                <i class="fas fa-search" style="font-size: 24px; margin-bottom: 10px;"></i>
                <p>No bookings match your filter.</p>
            </div>

            <div id="paginationControls" class="pagination-container"></div>
        }
        else
        {
            <div style="text-align: center; padding: 40px;">
                <i class="fas fa-futbol" style="font-size: 40px; color: #333; margin-bottom: 15px;"></i>
                <h3 style="color: #fff;">No Bookings Found</h3>
                <p style="color: #888;">You haven't booked any turf matches yet.</p>
                <a href="/Explore/Index" class="btn-invoice" style="padding: 10px 20px; font-size: 14px;">Explore Turfs</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // JAVASCRIPT: FILTERING + PAGINATION COMBO
        let currentTab = 'All';
        let currentPage = 1;
        const itemsPerPage = 5; 
        
        function filterTable(category, btnElement) {
            currentTab = category;
            currentPage = 1; 
            
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            if(btnElement) btnElement.classList.add('active');

            applyFilters();
        }

        document.getElementById('customSearch')?.addEventListener('keyup', () => {
            currentPage = 1; 
            applyFilters();
        });

        function applyFilters() {
            const searchText = document.getElementById('customSearch')?.value.toLowerCase() || '';
            const rows = document.querySelectorAll('.table-row');
            let filteredRows = [];

            rows.forEach(row => {
                const category = row.getAttribute('data-category');
                const textContent = row.innerText.toLowerCase();
                
                const matchesTab = (currentTab === 'All' || category === currentTab);
                const matchesSearch = textContent.includes(searchText);

                if (matchesTab && matchesSearch) {
                    filteredRows.push(row);
                } else {
                    row.style.display = 'none';
                }
            });

            const totalPages = Math.ceil(filteredRows.length / itemsPerPage) || 1;
            if(currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx = startIdx + itemsPerPage;

            filteredRows.forEach((row, index) => {
                if (index >= startIdx && index < endIdx) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            const noResultsMsg = document.getElementById('noResultsMsg');
            if (noResultsMsg) {
                noResultsMsg.style.display = filteredRows.length === 0 ? 'block' : 'none';
            }

            renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
            const paginationContainer = document.getElementById('paginationControls');
            if (!paginationContainer) return;
            
            paginationContainer.innerHTML = '';
            if (totalPages <= 1) return; 

            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.innerText = i;
                btn.className = 'page-btn ' + (i === currentPage ? 'active' : '');
                btn.onclick = () => {
                    currentPage = i;
                    applyFilters();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                };
                paginationContainer.appendChild(btn);
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            applyFilters();
        });

        // RATE TURF FUNCTION
        async function openRateModal(arenaId, arenaName, bookingId) {
            const { value: formValues } = await Swal.fire({
                title: 'Rate ' + arenaName + ' ⭐',
                html:
                    '<div style="text-align: left; margin-bottom: 10px;"><label style="color: #bbb; font-size: 0.9rem;">Your Rating</label></div>' +
                    '<select id="swal-rating" class="swal2-input" style="display: flex; margin: 0 auto 20px auto; width: 100%;">' +
                    '<option value="5">⭐⭐⭐⭐⭐ - Excellent</option>' +
                    '<option value="4">⭐⭐⭐⭐ - Good</option>' +
                    '<option value="3">⭐⭐⭐ - Average</option>' +
                    '<option value="2">⭐⭐ - Poor</option>' +
                    '<option value="1">⭐ - Terrible</option>' +
                    '</select>' +
                    '<div style="text-align: left; margin-bottom: 10px;"><label style="color: #bbb; font-size: 0.9rem;">Your Comment</label></div>' +
                    '<textarea id="swal-comment" class="swal2-textarea" placeholder="How was the pitch quality?" style="margin: 0; width: 100%;"></textarea>',
                focusConfirm: false,
                background: '#1a1a1a',
                color: '#fff',
                showCancelButton: true,
                confirmButtonText: 'Submit Feedback',
                confirmButtonColor: '#00ff66',
                cancelButtonColor: '#333',
                preConfirm: () => {
                    return {
                        rating: document.getElementById('swal-rating').value,
                        comment: document.getElementById('swal-comment').value
                    }
                }
            });

            if (formValues) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Review/Add';

                const inputs = [
                    { name: 'arenaId', value: arenaId },
                    { name: 'bookingId', value: bookingId },
                    { name: 'rating', value: formValues.rating },
                    { name: 'comment', value: formValues.comment }
                ];

                inputs.forEach(data => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = data.name;
                    input.value = data.value;
                    form.appendChild(input);
                });

                document.body.appendChild(form);
                form.submit();
            }
        }

        // Cancel Booking Alert
        function confirmCancel(bookingId) {
            Swal.fire({
                title: 'Are you sure? 😟',
                text: "Do you really want to cancel this turf booking?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ff4757',
                cancelButtonColor: '#333',
                confirmButtonText: 'Yes, Cancel it!',
                background: '#1a1a1a',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('cancel-form-' + bookingId).submit();
                }
            })
        }
    </script>
}