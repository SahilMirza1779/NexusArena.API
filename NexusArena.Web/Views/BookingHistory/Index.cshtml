@model List<NexusArena.Web.Controllers.BookingHistoryViewModel>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<div style="margin-bottom: 40px;">
    <h1 style="margin: 0; font-size: 2.5rem; font-weight: 800; color: #fff; letter-spacing: -0.5px;">My <span style="color: #00ff66;">Bookings</span> 📅</h1>
    <p style="color: #888; font-size: 1.1rem; margin-top: 10px;">Track your past matches and manage upcoming turf reservations.</p>
</div>

<div style="background: linear-gradient(145deg, #161616, #1a1a1a); padding: 30px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); border: 1px solid #2a2a2a; overflow-x: auto;">
    @if (Model != null && Model.Any())
    {
        <table style="width: 100%; border-collapse: separate; border-spacing: 0; color: #fff; text-align: left; min-width: 800px;">
            <thead>
                <tr style="color: #888; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">
                    <th style="padding: 15px 20px; border-bottom: 2px solid #2a2a2a;">Booking ID</th>
                    <th style="padding: 15px 20px; border-bottom: 2px solid #2a2a2a;">Turf & Sport</th>
                    <th style="padding: 15px 20px; border-bottom: 2px solid #2a2a2a;">Date & Time</th>
                    <th style="padding: 15px 20px; border-bottom: 2px solid #2a2a2a;">Status</th>
                    <th style="padding: 15px 20px; border-bottom: 2px solid #2a2a2a; text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="transition: all 0.3s ease; background-color: transparent;" onmouseover="this.style.backgroundColor='#1c1c1c'; this.style.transform='scale(1.01)';" onmouseout="this.style.backgroundColor='transparent'; this.style.transform='scale(1)';">
                        <td style="padding: 20px; border-bottom: 1px solid #222; color: #777; font-weight: 700; font-size: 1.1rem;">#@item.bookingId</td>
                        <td style="padding: 20px; border-bottom: 1px solid #222;">
                            <strong style="color: #fff; display: block; font-size: 1.15rem; letter-spacing: 0.5px;">@item.arenaName</strong>
                            <span style="color: #00ff66; font-size: 0.85rem; font-weight: 600;">@item.sport</span>
                        </td>
                        <td style="padding: 20px; border-bottom: 1px solid #222;">
                            <span style="display: block; color: #ddd; font-weight: 600; font-size: 1.05rem;">@item.playDate</span>
                            <span style="color: #888; font-size: 0.9rem;"><i class="far fa-clock" style="margin-right: 5px;"></i>@item.startTime</span>
                        </td>
                        <td style="padding: 20px; border-bottom: 1px solid #222;">
                            @if (item.status == "Confirmed")
                            {
                                <span style="background-color: rgba(0, 255, 102, 0.1); color: #00ff66; padding: 8px 16px; border-radius: 30px; font-size: 0.85rem; font-weight: 700; border: 1px solid rgba(0, 255, 102, 0.3); display: inline-block; box-shadow: 0 0 10px rgba(0, 255, 102, 0.1);">
                                    <i class="fas fa-check-circle" style="margin-right: 5px;"></i> CONFIRMED
                                </span>
                            }
                            else if (item.status == "Cancelled")
                            {
                                <span style="background-color: rgba(255, 76, 76, 0.1); color: #ff4c4c; padding: 8px 16px; border-radius: 30px; font-size: 0.85rem; font-weight: 700; border: 1px solid rgba(255, 76, 76, 0.3); display: inline-block;">
                                    <i class="fas fa-times-circle" style="margin-right: 5px;"></i> CANCELLED
                                </span>
                            }
                            else
                            {
                                <span style="background-color: #333; color: #fff; padding: 8px 16px; border-radius: 30px; font-size: 0.85rem;">@item.status</span>
                            }
                        </td>
                        <td style="padding: 20px; border-bottom: 1px solid #222; text-align: right;">
                            @if (item.status == "Confirmed" && DateTime.TryParse(item.playDate, out DateTime playDt) && playDt >= DateTime.Today)
                            {
                                <form id="cancelForm_@item.bookingId" method="post" action="/BookingHistory/Cancel" style="margin: 0;">
                                    <input type="hidden" name="bookingId" value="@item.bookingId" />
                                    <button type="button" onclick="confirmCancel(@item.bookingId)" style="background-color: transparent; color: #ff4c4c; border: 1px solid #ff4c4c; padding: 8px 16px; border-radius: 6px; cursor: pointer; transition: all 0.3s ease; font-weight: 600; font-size: 0.9rem;" onmouseover="this.style.backgroundColor='#ff4c4c'; this.style.color='#fff'; this.style.boxShadow='0 4px 10px rgba(255, 76, 76, 0.3)';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ff4c4c'; this.style.boxShadow='none';">
                                        Cancel Match
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span style="color: #444; font-size: 0.9rem; font-weight: 600; background: #111; padding: 8px 16px; border-radius: 6px; border: 1px solid #222;">Closed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 50px 20px;">
            <i class="fas fa-calendar-times" style="font-size: 4rem; color: #2a2a2a; margin-bottom: 20px;"></i>
            <h3 style="color: #aaa; margin: 0 0 10px 0; font-size: 1.5rem;">No bookings found</h3>
            <p style="color: #666; margin: 0; font-size: 1.1rem;">Head over to the Explore section and lock in your first match!</p>
            <a href="/Explore/Index" style="display: inline-block; margin-top: 25px; background-color: #00ff66; color: #111; padding: 12px 25px; border-radius: 8px; text-decoration: none; font-weight: bold; transition: 0.3s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">Explore Turfs</a>
        </div>
    }
</div>

<script>
    function confirmCancel(bookingId) {
        Swal.fire({
            title: 'Cancel Booking?',
            text: "Refunds will be processed as per policy. This action cannot be undone.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ff4c4c',
            cancelButtonColor: '#333',
            confirmButtonText: 'Yes, cancel it!',
            background: '#1a1a1a',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('cancelForm_' + bookingId).submit();
            }
        });
    }
</script>   