@model List<NexusArena.Web.Controllers.BookingHistoryViewModel>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<style>
    /* ... (Keep all your existing CSS exactly the same as before) ... */
    .history-container { max-width: 1100px; margin: 30px auto; padding-bottom: 50px; }
    .header-section { margin-bottom: 40px; }
    .header-section h1 { color: #fff; font-size: 34px; font-weight: 800; margin: 0; }
    .header-section h1 span { color: #00ff7f; }
    .header-section p { color: #aaa; margin-top: 8px; font-size: 16px; }
    .ticket-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 25px; }
    .ticket-card { background: #1a1a1a; border: 1px solid #333; border-radius: 12px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.3); transition: 0.3s; display: flex; flex-direction: column; }
    .ticket-card:hover { transform: translateY(-5px); border-color: #555; }
    .ticket-top { background: #0f0f0f; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #333; }
    .booking-id { color: #888; font-weight: 700; font-size: 14px; }
    .status-badge { padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
    .status-confirmed { background: rgba(0, 255, 127, 0.15); color: #00ff7f; }
    .status-cancelled { background: rgba(255, 76, 76, 0.15); color: #ff4c4c; }
    .ticket-mid { padding: 25px 20px; flex-grow: 1; }
    .arena-title { color: #fff; font-size: 20px; font-weight: 800; margin: 0 0 5px 0; }
    .sport-text { color: #00bfff; font-size: 13px; font-weight: 600; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px; }
    .info-row { display: flex; align-items: center; gap: 12px; color: #ccc; font-size: 15px; font-weight: 600; margin-bottom: 10px; }
    .info-row i { color: #00ff7f; font-size: 18px; width: 20px; text-align: center; }
    .ticket-bot { padding: 15px 20px; background: #111; border-top: 1px solid #222; }
    .btn-cancel { width: 100%; background: transparent; color: #ff4c4c; border: 1px solid #ff4c4c; padding: 12px; border-radius: 8px; font-weight: 700; font-size: 14px; cursor: pointer; transition: 0.3s; }
    .btn-cancel:hover { background: rgba(255, 76, 76, 0.1); }
</style>

<div class="history-container">
    
    <div class="header-section">
        <h1>My <span>Bookings</span> 🎫</h1>
        <p>Manage your upcoming matches and view past history.</p>
    </div>

    <div class="ticket-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var ticket in Model)
            {
                <div class="ticket-card">
                    <div class="ticket-top">
                        <span class="booking-id">ID: #@ticket.bookingId</span>
                        <span class="status-badge @(ticket.status == "Confirmed" ? "status-confirmed" : "status-cancelled")">
                            @ticket.status
                        </span>
                    </div>
                    
                    <div class="ticket-mid">
                        <h3 class="arena-title">@ticket.arenaName</h3>
                        <div class="sport-text">@ticket.sport</div>
                        
                        <div class="info-row"><i class="fas fa-calendar-day"></i> @ticket.playDate</div>
                        <div class="info-row"><i class="far fa-clock"></i> @ticket.startTime</div>
                    </div>

                    @if (ticket.status == "Confirmed")
                    {
                        <div class="ticket-bot">
                            <form method="post" action="/BookingHistory/Cancel">
                                <input type="hidden" name="bookingId" value="@ticket.bookingId" />
                                <button type="button" class="btn-cancel" onclick="confirmCancel(this)">CANCEL BOOKING</button>
                            </form>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; text-align: center; padding: 50px; background: #1a1a1a; border-radius: 12px; border: 1px dashed #444;">
                <i class="fas fa-ticket-alt" style="font-size: 50px; color: #444; margin-bottom: 20px;"></i>
                <h3 style="color: #fff; margin: 0 0 10px 0;">No Bookings Found</h3>
                <p style="color: #888; margin-bottom: 20px;">You haven't booked any slots yet.</p>
                <a href="/Explore/Index" style="background: #00ff7f; color: #000; padding: 10px 25px; border-radius: 6px; font-weight: 800; text-decoration: none;">Explore Turfs</a>
            </div>
        }
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // 1. Function for Custom Cancel Confirmation
    function confirmCancel(buttonElement) {
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you really want to cancel this booking?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ff4c4c',
            cancelButtonColor: '#333',
            confirmButtonText: 'Yes, Cancel it!',
            background: '#1a1a1a',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                // Submit the form if user clicks Yes
                buttonElement.closest('form').submit();
            }
        })
    }

    // 2. Notifications for Success/Error
    document.addEventListener("DOMContentLoaded", function() {
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({
                title: 'Success!',
                text: '@Html.Raw(TempData["Success"])',
                icon: 'success',
                confirmButtonColor: '#00ff7f',
                background: '#1a1a1a',
                color: '#fff',
                iconColor: '#00ff7f'
            });
            </text>
        }

        @if (TempData["Error"] != null || ViewBag.Error != null)
        {
            <text>
            Swal.fire({
                title: 'Oops!',
                text: '@Html.Raw(TempData["Error"] ?? ViewBag.Error)',
                icon: 'error',
                confirmButtonColor: '#ff4c4c',
                background: '#1a1a1a',
                color: '#fff'
            });
            </text>
        }
    });
</script>