@model NexusArena.Web.Controllers.DashboardApiResponse
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<!-- STATS CARDS -->
<div style="display: flex; gap: 20px; margin-bottom: 30px;">
    <!-- Total Matches Played -->
    <div style="flex: 1; background-color: #1a1a1a; padding: 20px; border-radius: 8px; border-left: 4px solid #00ff66;">
        <h4 style="color: #aaa; margin: 0 0 10px 0;">Total Matches Played</h4>
        <h1 style="color: #fff; margin: 0; font-size: 2.5rem;">@Model.stats.totalMatchesPlayed</h1>
    </div>

    <!-- Upcoming Matches Count -->
    <div style="flex: 1; background-color: #1a1a1a; padding: 20px; border-radius: 8px; border-left: 4px solid #ffcc00;">
        <h4 style="color: #aaa; margin: 0 0 10px 0;">Upcoming Matches</h4>
        <h1 style="color: #fff; margin: 0; font-size: 2.5rem;">@Model.upcomingMatches.Count</h1>
    </div>
    
    <!-- Loyalty Points (Bonus from Sahil's API) -->
    <div style="flex: 1; background-color: #1a1a1a; padding: 20px; border-radius: 8px; border-left: 4px solid #00c3ff;">
        <h4 style="color: #aaa; margin: 0 0 10px 0;">Loyalty Points</h4>
        <h1 style="color: #fff; margin: 0; font-size: 2.5rem;">@Model.stats.loyaltyPoints</h1>
    </div>
</div>

<!-- UPCOMING MATCHES LIST -->
<div style="background-color: #1a1a1a; padding: 20px; border-radius: 8px;">
    <h3 style="color: #fff; margin-top: 0; margin-bottom: 20px;">Your Next Games</h3>

    @if (Model.upcomingMatches != null && Model.upcomingMatches.Any())
    {
        foreach (var match in Model.upcomingMatches)
        {
            <div style="background-color: #0f0f0f; padding: 15px; border-radius: 6px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; border: 1px solid #333;">
                <div>
                    <!-- Arena aur Sport ka naam -->
                    <h4 style="margin: 0; color: #00ff66; font-size: 1.1rem;">@match.arenaName (@match.sport)</h4>
                    <span style="color: #aaa; font-size: 0.9rem;"><i class="far fa-calendar-alt"></i> @match.playDate | <i class="far fa-clock"></i> @match.startTime</span>
                </div>
                <div>
                    <span style="background-color: #333; color: #fff; padding: 5px 10px; border-radius: 4px; font-size: 0.8rem; margin-right: 10px;">ID: #@match.bookingId</span>
                    <span style="background-color: #00ff66; color: #000; padding: 5px 10px; border-radius: 4px; font-size: 0.8rem; font-weight: bold;">@match.status</span>
                </div>
            </div>
        }
    }
    else
    {
        <p style="color: #888; text-align: center; margin: 20px 0;">Aapka koi aane wala match nahi hai. Turf book kijiye!</p>
    }
</div>