@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<div style="margin-bottom: 40px;">
    <h1 style="margin: 0; font-size: 2.2rem; font-weight: 800; color: #fff;">Welcome back, <span style="color: #00ff66;">Zubeir!</span> ⚡</h1>
    <p style="color: #888; font-size: 1rem; margin-top: 10px;">Book your next turf or check your upcoming matches.</p>
</div>

<div style="display: flex; gap: 25px; margin-bottom: 40px;">
    
    <div style="background-color: #1a1a1a; padding: 25px; border-radius: 8px; border-left: 5px solid #00ff66; flex: 1; box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
        <h3 style="margin: 0 0 15px 0; color: #888; font-size: 0.9rem; font-weight: 600; text-transform: uppercase;">Next Match</h3>
        <h2 style="margin: 0; font-size: 1.4rem; color: #fff;"><i class="far fa-clock" style="color: #00ff66;"></i> Tomorrow, 10:00 AM</h2>
        <p style="margin: 8px 0 0 0; color: #00ff66; font-weight: 600;">Dream Box Cricket</p>
    </div>

    <div style="background-color: #1a1a1a; padding: 25px; border-radius: 8px; border-left: 5px solid #fff; flex: 1; box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
        <h3 style="margin: 0 0 15px 0; color: #888; font-size: 0.9rem; font-weight: 600; text-transform: uppercase;">Total Matches Played</h3>
        <h2 style="margin: 0; font-size: 2.5rem; color: #fff;">12</h2>
    </div>

    <div style="background-color: #00ff66; padding: 25px; border-radius: 8px; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: 0.3s; box-shadow: 0 4px 20px rgba(0, 255, 102, 0.3);" onmouseover="this.style.backgroundColor='#00e65c'" onmouseout="this.style.backgroundColor='#00ff66'">
        <i class="fas fa-search" style="font-size: 2rem; color: #111; margin-bottom: 10px;"></i>
        <h2 style="margin: 0; color: #111; font-size: 1.2rem; font-weight: 800;">BOOK A TURF</h2>
    </div>

</div>