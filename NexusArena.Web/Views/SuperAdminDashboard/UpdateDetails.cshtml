@model NexusArena.Web.Models.AdminProfileViewModel

@{
    ViewData["Title"] = "Update Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .update-container { max-width: 700px; margin: 30px auto; }
    .form-card { background-color: #1a1a1a; border-radius: 12px; padding: 35px; border: 1px solid #333; box-shadow: 0 8px 20px rgba(0,0,0,0.3); }
    
    .form-header { text-align: center; margin-bottom: 30px; border-bottom: 1px solid #333; padding-bottom: 20px; }
    .form-header h2 { color: #fff; margin: 0; font-size: 26px; font-weight: bold; }
    .form-header p { color: #aaa; margin: 8px 0 0; font-size: 14px; }

    .form-group { margin-bottom: 22px; }
    .form-group label { display: block; margin-bottom: 8px; color: #00ff7f; font-weight: 600; font-size: 13px; letter-spacing: 0.5px; text-transform: uppercase;}
    .form-control { width: 100%; padding: 14px 15px; background: #222; border: 1px solid #444; border-radius: 8px; color: #fff; font-size: 15px; transition: all 0.3s ease; }
    .form-control:focus { border-color: #00ff7f; outline: none; background: #2a2a2a; box-shadow: 0 0 8px rgba(0, 255, 127, 0.2); }

    .btn-group { display: flex; gap: 15px; margin-top: 35px; }
    .btn-save { flex: 1; background: #00ff7f; color: #000; border: none; padding: 14px; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer; transition: 0.3s; text-align: center; }
    .btn-save:hover { background: #00cc66; transform: translateY(-2px); box-shadow: 0 4px 15px rgba(0, 255, 127, 0.3); color: #000; }
    
    .btn-cancel { flex: 1; background: #333; color: #fff; border: 1px solid #555; padding: 14px; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer; transition: 0.3s; text-align: center; text-decoration: none;}
    .btn-cancel:hover { background: #444; color: #fff; text-decoration: none; }
</style>

<div class="update-container">
    <div class="form-card">
        <div class="form-header">
            <h2><i class="fas fa-user-edit" style="color: #00ff7f; margin-right: 10px;"></i> Update Profile</h2>
            <p>Modify your admin details here.</p>
        </div>

        <form asp-action="UpdateDetails" method="post">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" asp-for="FullName" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Display Name</label>
                <input type="text" asp-for="DisplayName" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" asp-for="Email" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input type="text" asp-for="Phone" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Location</label>
                <input type="text" asp-for="Location" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Role <span style="color:#777; font-size:11px; text-transform:none;">(Not Editable)</span></label>
                <input type="text" asp-for="Role" class="form-control" readonly style="background: #1a1a1a; color: #777; cursor: not-allowed; border-color: #333;" />
            </div>

            <div class="btn-group">
                <a href="/SuperAdminDashboard/AdminDetails" class="btn-cancel"><i class="fas fa-times"></i> Cancel</a>
                <button type="submit" class="btn-save"><i class="fas fa-save"></i> Save Changes</button>
            </div>
        </form>
    </div>
</div>