@model List<NexusArena.Web.Models.ManageReviewViewModel>

@{
    ViewData["Title"] = "Platform Reviews";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .reviews-container { margin-top: 20px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .page-header h2 { margin: 0; color: #fff; font-size: 24px; }
    .page-header p { margin: 5px 0 0; color: #aaa; font-size: 14px; }

    .table-container { background-color: #1a1a1a; border-radius: 12px; padding: 25px; border: 1px solid #333; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 15px; text-align: left; border-bottom: 1px solid #2a2a2a; color: #cccccc; font-size: 14px; }
    th { color: #00ff7f; font-weight: 600; text-transform: uppercase; font-size: 13px; letter-spacing: 1px; }
    tr:hover td { background-color: #222; }

    /* Stars CSS */
    .star-filled { color: #ffd700; font-size: 14px; }
    .star-empty { color: #555; font-size: 14px; }

    .comment-box { 
        background: #2a2a2a; 
        padding: 8px 12px; 
        border-radius: 6px; 
        font-style: italic; 
        font-size: 13px; 
        color: #bbb;
        max-width: 250px;
        word-wrap: break-word;
    }

    .btn-delete { background: transparent; color: #ff4d4d; border: 1px solid #ff4d4d; padding: 5px 12px; border-radius: 4px; cursor: pointer; font-weight: 600; transition: 0.3s; }
    .btn-delete:hover { background: rgba(255, 77, 77, 0.1); }
</style>

<div class="reviews-container">
    <div class="page-header">
        <div>
            <h2>Manage Reviews & Ratings</h2>
            <p>View and manage all user reviews and ratings received on the platform.</p>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th style="width: 15%;">User Name</th>
                    <th style="width: 15%;">Arena Name</th>
                    <th style="width: 15%;">Rating</th>
                    <th style="width: 30%;">Comment</th>
                    <th style="width: 10%;">Date</th>
                    <th style="width: 10%;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var review in Model)
                    {
                        <tr>
                            <td>#@review.Id</td>
                            <td style="font-weight:600; color:#fff;">@review.UserName</td>
                            <td style="color:#00bfff;">@review.ArenaName</td>
                            <td>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <i class="fas fa-star star-filled"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star star-empty"></i>
                                    }
                                }
                            </td>
                            <td>
                                <div class="comment-box">"@review.Comment"</div>
                            </td>
                            <td style="font-size: 12px; color: #888;">
                                @review.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <button class="btn-delete" onclick="deleteReview(@review.Id)">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align:center; padding: 40px; color: #888;">
                            No reviews have been received on the platform yet!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function deleteReview(id) {
        if (confirm("Do you really want to delete this review? It cannot be restored!")) {
            fetch('/SuperAdminDashboard/DeletePlatformReview/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    window.location.reload(); 
                } else {
                    alert("An error occurred while deleting the review!");
                }
            })
            .catch(err => {
                console.error(err);
                alert("Server error!");
            });
        }
    }
</script>