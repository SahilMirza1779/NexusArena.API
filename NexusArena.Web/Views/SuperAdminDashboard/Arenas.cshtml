@model List<NexusArena.Web.Models.ArenaListViewModel>

@{
    ViewData["Title"] = "All Arenas";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .arena-container {
        margin-top: 20px;
    }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
    .page-header h2 { margin: 0; color: #fff; }
    .page-header p { margin: 5px 0 0; color: #aaa; font-size: 14px; }

    .table-container {
        background-color: #1a1a1a;
        border-radius: 12px;
        padding: 25px;
        border: 1px solid #333;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    table {
        width: 100%;
        border-collapse: collapse;
    }
    th, td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #2a2a2a;
        color: #cccccc;
        font-size: 14px;
    }
    th {
        color: #00ff7f;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 1px;
    }
    tr:hover td {
        background-color: #222;
    }
    
    /* Status Badges */
    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
    }
    .badge.pending { background-color: rgba(255, 152, 0, 0.1); color: #ff9800; border: 1px solid #ff9800; }
    .badge.active { background-color: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f; }
    .badge.unknown { background-color: rgba(170, 170, 170, 0.1); color: #aaa; border: 1px solid #aaa; }

    .manage-btn {
        background: transparent;
        color: #00ff7f;
        border: 1px solid #00ff7f;
        padding: 6px 15px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
    }
    .manage-btn:hover {
        background: rgba(0, 255, 127, 0.1);
    }
</style>

<div class="arena-container">
    <div class="page-header">
        <div>
            <h2>Manage Arenas</h2>
            <p>All Turfers registered on the platform and their live status.</p>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Arena Name</th>
                    <th>Owner Name</th>
                    <th>City</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var arena in Model)
                    {
                        <tr>
                            <td>#@arena.Id</td>
                            <td style="font-weight:600; color:#fff;">@arena.ArenaName</td>
                            <td>@arena.OwnerName</td>
                            <td>@arena.City</td>
                            <td>
                                @if (arena.Status == "Active")
                                {
                                    <span class="badge active">Active</span>
                                }
                                else if (arena.Status == "Pending")
                                {
                                    <span class="badge pending">Pending</span>
                                }
                                else
                                {
                                    <span class="badge unknown">@arena.Status</span>
                                }
                            </td>
                            <td>
                                <a href="/SuperAdminDashboard/Manage/@arena.Id" class="manage-btn" style="text-decoration: none; display: inline-block;">Manage <i class="fas fa-cog"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding: 40px; color: #888;">
                            No arena was found registered in the database.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>