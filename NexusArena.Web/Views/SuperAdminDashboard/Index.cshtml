@model NexusArena.Web.Models.DashboardStatsViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-top: 25px;
    }
    .stat-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        border-color: #00ff7f;
        box-shadow: 0 8px 25px rgba(0, 255, 127, 0.1);
    }
    .stat-info h3 {
        margin: 0;
        font-size: 32px;
        color: #ffffff;
        letter-spacing: 1px;
    }
    .stat-info p {
        margin: 5px 0 0;
        color: #aaaaaa;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1px;
    }
    .stat-icon {
        font-size: 38px;
        color: #00ff7f;
        background: rgba(0, 255, 127, 0.05);
        padding: 15px;
        border-radius: 12px;
    }

    .recent-section {
        margin-top: 40px;
        background-color: #1a1a1a;
        border-radius: 12px;
        padding: 25px;
        border: 1px solid #333;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .recent-section h4 {
        margin-top: 0;
        color: #ffffff;
        border-bottom: 1px solid #333;
        padding-bottom: 15px;
        font-size: 18px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }
    th, td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #2a2a2a;
        color: #cccccc;
        font-size: 14px;
    }
    th {
        color: #00ff7f;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 1px;
    }
    tr:hover td {
        background-color: #222;
    }
    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .badge.pending { background-color: rgba(255, 152, 0, 0.1); color: #ff9800; border: 1px solid #ff9800; }
    .badge.active { background-color: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f; }
    
    .action-btn {
        background: #00ff7f;
        color: #000;
        border: none;
        padding: 6px 15px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
    }
    .action-btn:hover {
        background: #00cc66;
    }

    .modal-overlay {
        display: none; 
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(5px);
    }
    .modal-content {
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 30px;
        width: 400px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        color: #fff;
    }
    .modal-content h3 { margin-top: 0; color: #00ff7f; border-bottom: 1px solid #333; padding-bottom: 10px; }
    .modal-details { margin: 20px 0; font-size: 15px; color: #ccc; }
    .modal-details p { margin: 8px 0; }
    .modal-details strong { color: #fff; }
    .modal-actions { display: flex; gap: 15px; margin-top: 25px; }
    
    .btn-approve { background: #00ff7f; color: #000; border: none; padding: 10px; flex: 1; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.3s; }
    .btn-approve:hover { background: #00cc66; }
    
    .btn-reject { background: transparent; color: #ff4d4d; border: 1px solid #ff4d4d; padding: 10px; flex: 1; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.3s; }
    .btn-reject:hover { background: rgba(255, 77, 77, 0.1); }
</style>

<div>
    <h2 style="margin-top:0; color:#fff;">Overview</h2>
    <p style="color:#aaa; font-size:14px;">Platform's real-time statistics and pending approvals.</p>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.TotalPlayers</h3>
                <p>TOTAL PLAYERS</p>
            </div>
            <div class="stat-icon"><i class="fas fa-users"></i></div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.RegisteredOwners</h3>
                <p>REGISTERED OWNERS</p>
            </div>
            <div class="stat-icon"><i class="fas fa-user-tie"></i></div>
        </div>
        
        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.TotalReceptionists</h3>
                <p>TOTAL RECEPTIONISTS</p>
            </div>
            <div class="stat-icon"><i class="fas fa-headset"></i></div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.ActiveArenas</h3>
                <p>ACTIVE ARENAS</p>
            </div>
            <div class="stat-icon"><i class="fas fa-building"></i></div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.PlatformRevenue</h3>
                <p>PLATFORM REVENUE</p>
            </div>
            <div class="stat-icon"><i class="fas fa-wallet"></i></div>
        </div>
    </div>

    <div class="recent-section">
        <h4><i class="fas fa-clipboard-list" style="color:#00ff7f; margin-right:8px;"></i> Pending Approvals</h4>
        <table>
            <thead>
                <tr>
                    <th>Arena Name</th>
                    <th>Owner</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PendingApprovals != null && Model.PendingApprovals.Count > 0)
                {
                    foreach (var arena in Model.PendingApprovals)
                    {
                        <tr>
                            <td>@arena.ArenaName</td>
                            <td>@arena.OwnerName</td>
                            <td>@arena.Category</td>
                            <td><span class="badge pending">@arena.Status</span></td>
                            <td>
                                <button class="action-btn" onclick="openReviewModal(@arena.Id, '@arena.ArenaName', '@arena.OwnerName', '@arena.Category')">
                                 Review
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding: 30px; color: #888;">
                            No new arena is pending approval.   
                        </td>
                    </tr>
                }
            </tbody>
            </table>
    </div>
</div>
<div id="reviewModal" class="modal-overlay">
    <div class="modal-content">
        <h3>Review Arena</h3>
        <div class="modal-details">
            <p><strong>Arena Name:</strong> <span id="modalArenaName"></span></p>
            <p><strong>Owner:</strong> <span id="modalOwnerName"></span></p>
            <p><strong>Category:</strong> <span id="modalCategory"></span></p>
        </div>
        <div class="modal-actions">
            <input type="hidden" id="modalArenaId" />
            <button class="btn-approve" onclick="approveArena()">Approve <i class="fas fa-check"></i></button>
            <button class="btn-reject" onclick="closeModal()">Close / Reject <i class="fas fa-times"></i></button>
        </div>
    </div>
</div>

<script>
    function openReviewModal(id, arenaName, ownerName, category) {
        document.getElementById('modalArenaId').value = id;
        document.getElementById('modalArenaName').innerText = arenaName;
        document.getElementById('modalOwnerName').innerText = ownerName;
        document.getElementById('modalCategory').innerText = category;
        
        document.getElementById('reviewModal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('reviewModal').style.display = 'none';
    }

    function approveArena() {
        var arenaId = document.getElementById('modalArenaId').value;
        var approveBtn = document.querySelector('.btn-approve');
        
        approveBtn.disabled = true;
        approveBtn.innerHTML = 'Approving... <i class="fas fa-spinner fa-spin"></i>';

        fetch('/SuperAdminDashboard/ApproveArena/' + arenaId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if(data.success) {
                closeModal();
                window.location.reload(); 
            } else {
                alert('Oops! Approval me koi issue aaya.');
                approveBtn.disabled = false;
                approveBtn.innerHTML = 'Approve <i class="fas fa-check"></i>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Server error!');
        });
    }
</script>