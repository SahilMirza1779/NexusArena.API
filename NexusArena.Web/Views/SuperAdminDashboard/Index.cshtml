@model NexusArena.Web.Models.DashboardStatsViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-top: 25px;
    }
    .stat-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        border-color: #00ff7f;
        box-shadow: 0 8px 25px rgba(0, 255, 127, 0.1);
    }
    .stat-info h3 {
        margin: 0;
        font-size: 32px;
        color: #ffffff;
        letter-spacing: 1px;
    }
    .stat-info p {
        margin: 5px 0 0;
        color: #aaaaaa;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1px;
    }
    .stat-icon {
        font-size: 38px;
        color: #00ff7f;
        background: rgba(0, 255, 127, 0.05);
        padding: 15px;
        border-radius: 12px;
    }

    .recent-section {
        margin-top: 40px;
        background-color: #1a1a1a;
        border-radius: 12px;
        padding: 25px;
        border: 1px solid #333;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .recent-section h4 {
        margin-top: 0;
        color: #ffffff;
        border-bottom: 1px solid #333;
        padding-bottom: 15px;
        font-size: 18px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }
    th, td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #2a2a2a;
        color: #cccccc;
        font-size: 14px;
    }
    th {
        color: #00ff7f;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 1px;
    }
    tr:hover td {
        background-color: #222;
    }
    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .badge.pending { background-color: rgba(255, 152, 0, 0.1); color: #ff9800; border: 1px solid #ff9800; }
    .badge.active { background-color: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f; }
    
    .action-btn {
        background: #00ff7f;
        color: #000;
        border: none;
        padding: 6px 15px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
    }
    .action-btn:hover {
        background: #00cc66;
    }
</style>

<div>
    <h2 style="margin-top:0; color:#fff;">Overview</h2>
    <p style="color:#aaa; font-size:14px;">Platform's real-time statistics and pending approvals.</p>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.TotalPlayers</h3>
                <p>TOTAL PLAYERS</p>
            </div>
            <div class="stat-icon"><i class="fas fa-users"></i></div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.RegisteredOwners</h3>
                <p>REGISTERED OWNERS</p>
            </div>
            <div class="stat-icon"><i class="fas fa-user-tie"></i></div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.ActiveArenas</h3>
                <p>ACTIVE ARENAS</p>
            </div>
            <div class="stat-icon"><i class="fas fa-building"></i></div>
        </div>

        <div class="stat-card">
            <div class="stat-info">
                <h3>@Model.PlatformRevenue</h3>
                <p>PLATFORM REVENUE</p>
            </div>
            <div class="stat-icon"><i class="fas fa-wallet"></i></div>
        </div>
    </div>

    <div class="recent-section">
        <h4><i class="fas fa-clipboard-list" style="color:#00ff7f; margin-right:8px;"></i> Pending Approvals</h4>
        <table>
            <thead>
                <tr>
                    <th>Arena Name</th>
                    <th>Owner</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Spartan Box Cricket</td>
                    <td>Sufiyan</td>
                    <td>Box Cricket</td>
                    <td><span class="badge pending">Pending</span></td>
                    <td><button class="action-btn">Review</button></td>
                </tr>
                <tr>
                    <td>Kickoff Football Turf</td>
                    <td>Ali</td>
                    <td>Football</td>
                    <td><span class="badge active">Active</span></td>
                    <td><button class="action-btn" style="background:#333; color:#fff;">Manage</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>