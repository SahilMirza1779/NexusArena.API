@{
    ViewData["Title"] = "Broadcast Notifications";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .broadcast-container { margin-top: 20px; max-width: 800px; }
    .page-header { margin-bottom: 30px; }
    .page-header h2 { margin: 0; color: #fff; font-size: 24px; }
    .page-header p { margin: 5px 0 0; color: #aaa; font-size: 14px; }

    .form-card { background-color: #1a1a1a; border-radius: 12px; padding: 30px; border: 1px solid #333; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
    
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 8px; color: #00ff7f; font-weight: 600; font-size: 14px; letter-spacing: 0.5px; }
    
    .form-control { width: 100%; padding: 12px 15px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; font-size: 14px; transition: border-color 0.3s; }
    .form-control:focus { border-color: #00ff7f; outline: none; background: #2a2a2a; }
    
    textarea.form-control { resize: vertical; min-height: 120px; }

    .btn-broadcast { background: #00ff7f; color: #000; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; font-size: 15px; cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; gap: 8px; }
    .btn-broadcast:hover { background: #00cc66; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0, 255, 127, 0.3); }
    .btn-broadcast:disabled { background: #555; cursor: not-allowed; transform: none; box-shadow: none; }

    #statusMessage { margin-top: 15px; font-size: 14px; font-weight: 600; display: none; padding: 10px; border-radius: 6px; }
    .success-msg { background: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f; }
    .error-msg { background: rgba(255, 77, 77, 0.1); color: #ff4d4d; border: 1px solid #ff4d4d; }
</style>

<div class="broadcast-container">
    <div class="page-header">
        <h2><i class="fas fa-bullhorn" style="color: #00ff7f; margin-right: 10px;"></i> Send Platform Broadcast</h2>
        <p>Send important announcements to all users or owners on the platform with a single click.</p>
    </div>

    <div class="form-card">
        <div class="form-group">
            <label for="targetAudience">Target Audience</label>
            <select id="targetAudience" class="form-control">
                <option value="All">All (Users & Owners)</option>
                <option value="Users">Only Players / Users</option>
                <option value="Owners">Only Arena Owners</option>
            </select>
        </div>

        <div class="form-group">
            <label for="broadcastMessage">Announcement Message</label>
            <textarea id="broadcastMessage" class="form-control" placeholder="Type your message here (e.g., Holi Special 50% Off!)..."></textarea>
        </div>

        <button id="sendBtn" class="btn-broadcast" onclick="sendBroadcast()">
            <i class="fas fa-paper-plane"></i> Send Now
        </button>

        <div id="statusMessage"></div>
    </div>
</div>

<script>
    function sendBroadcast() {
        const audience = document.getElementById("targetAudience").value;
        const message = document.getElementById("broadcastMessage").value;
        const btn = document.getElementById("sendBtn");
        const statusDiv = document.getElementById("statusMessage");

        if (!message.trim()) {
            showStatus("Please type the message!", false);
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';

        const formData = new FormData();
        formData.append('targetAudience', audience);
        formData.append('message', message);

        fetch('/SuperAdminDashboard/SendPlatformBroadcast', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                showStatus("Awesome! The broadcast has been sent successfully.", true);
                document.getElementById("broadcastMessage").value = "";
            } else {
                showStatus("Error: There was a problem sending the broadcast.", false);
            }
        })
        .catch(err => {
            console.error(err);
            showStatus("Server error! Please try again later.", false);
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Now';
        });
    }

    function showStatus(text, isSuccess) {
        const statusDiv = document.getElementById("statusMessage");
        statusDiv.style.display = "block";
        statusDiv.innerText = text;
        statusDiv.className = isSuccess ? "success-msg" : "error-msg";
        
        setTimeout(() => {
            statusDiv.style.display = "none";
        }, 5000);
    }
</script>