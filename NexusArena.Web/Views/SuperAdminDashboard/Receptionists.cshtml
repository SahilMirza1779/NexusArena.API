@model List<NexusArena.Web.Models.ManageReceptionistViewModel>

@{
    ViewData["Title"] = "Platform Receptionists";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .receptionist-container { margin-top: 20px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .page-header h2 { margin: 0; color: #fff; font-size: 24px; }
    .page-header p { margin: 5px 0 0; color: #aaa; font-size: 14px; }

    .table-container { background-color: #1a1a1a; border-radius: 12px; padding: 25px; border: 1px solid #333; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 15px; text-align: left; border-bottom: 1px solid #2a2a2a; color: #cccccc; font-size: 14px; }
    th { color: #00ff7f; font-weight: 600; text-transform: uppercase; font-size: 13px; letter-spacing: 1px; }
    tr:hover td { background-color: #222; }

    .badge { padding: 5px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; display: inline-block; }
    .badge.active { background: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f; }
    .badge.blocked { background: rgba(255, 77, 77, 0.1); color: #ff4d4d; border: 1px solid #ff4d4d; }

    .btn-block { background: transparent; color: #ff4d4d; border: 1px solid #ff4d4d; padding: 5px 12px; border-radius: 4px; cursor: pointer; font-weight: 600; transition: 0.3s; }
    .btn-block:hover { background: rgba(255, 77, 77, 0.1); }
    .btn-unblock { background: transparent; color: #00ff7f; border: 1px solid #00ff7f; padding: 5px 12px; border-radius: 4px; cursor: pointer; font-weight: 600; transition: 0.3s; }
    .btn-unblock:hover { background: rgba(0, 255, 127, 0.1); }
</style>

<div class="receptionist-container">
    <div class="page-header">
        <div>
            <h2>Manage Receptionists</h2>
            <p>List of receptionists managing ground bookings at the arenas.</p>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th style="width: 10%;">ID</th>
                    <th style="width: 30%;">Name</th>
                    <th style="width: 35%;">Contact Info</th>
                    <th style="width: 10%;">Status</th>
                    <th style="width: 15%;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var rec in Model)
                    {
                        <tr>
                            <td>#@rec.Id</td>
                            <td style="font-weight:600; color:#fff; font-size: 15px;">@rec.Name</td>
                            <td>
                                <div style="color: #fff;"><i class="fas fa-envelope" style="color: #888; font-size: 12px; margin-right: 5px;"></i> @rec.Email</div>
                                <div style="color: #aaa; font-size: 13px; margin-top: 4px;"><i class="fas fa-phone" style="color: #888; font-size: 12px; margin-right: 5px;"></i> @rec.Phone</div>
                            </td>
                            <td>
                                @if (rec.IsActive)
                                {
                                    <span class="badge active">Active</span>
                                }
                                else
                                {
                                    <span class="badge blocked">Blocked</span>
                                }
                            </td>
                            <td>
                                @if (rec.IsActive)
                                {
                                    <button class="btn-block" onclick="toggleStatus(@rec.Id, 'Block')">
                                        <i class="fas fa-user-slash"></i> Block
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-unblock" onclick="toggleStatus(@rec.Id, 'Unblock')">
                                        <i class="fas fa-user-check"></i> Unblock
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding: 40px; color: #888;">
                            No receptionist was found in the database!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function toggleStatus(id, action) {
        let confirmMsg = action === 'Block' 
            ? "Do you want to block this receptionist?" 
            : "Do you want to unblock this receptionist?";

        if (confirm(confirmMsg)) {
            fetch('/SuperAdminDashboard/ToggleReceptionistStatus/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    window.location.reload(); 
                } else {
                    alert("An error occurred while updating the status!");
                }
            })
            .catch(err => {
                console.error(err);
                alert("Server error!");
            });
        }
    }
</script>