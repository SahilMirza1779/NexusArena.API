@{
    ViewData["Title"] = "Nexus Arena - Book Your Turf";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body, html {
            margin: 0; padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at 50% 40%, #0a4d2e 0%, #05150a 50%, #000000 100%);
            background-attachment: fixed;
            color: #fff;
            overflow-x: hidden;
            min-height: 100vh;
        }

        .hero-section {
            position: relative;
            height: 100vh; width: 100%;
            display: flex; align-items: center; justify-content: center;
            z-index: 1;
        }

        .custom-navbar {
            position: fixed; top: 0; width: 100%;
            padding: 20px 50px; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
            transition: all 0.4s ease;
        }
        .custom-navbar.scrolled {
            background: rgba(5, 10, 5, 0.9);
            backdrop-filter: blur(10px);
            padding: 10px 50px;
            box-shadow: 0 4px 30px rgba(0,0,0,0.8);
            border-bottom: 1px solid rgba(0, 255, 127, 0.1);
        }

        .nav-buttons .btn-login {
            background: transparent; color: #fff;
            border: 1px solid rgba(255,255,255,0.3);
            padding: 8px 25px; border-radius: 30px; margin-right: 15px;
            text-decoration: none; font-weight: 600; transition: 0.3s;
        }
        .nav-buttons .btn-login:hover { background: rgba(255,255,255,0.1); border-color: #fff; }

        .nav-buttons .btn-register {
            background: #00ff7f; color: #000;
            padding: 8px 30px; border-radius: 30px;
            text-decoration: none; font-weight: 700;
            box-shadow: 0 0 15px rgba(0,255,127,0.4); transition: 0.3s;
        }
        .nav-buttons .btn-register:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(0,255,127,0.6); }

        .hero-content {
            text-align: center; width: 100%; max-width: 1000px;
            padding: 0 20px; margin-top: -50px;
        }
        .hero-title {
            font-size: 5rem; font-weight: 900; text-transform: uppercase;
            letter-spacing: 2px; margin-bottom: 20px; line-height: 1.1;
        }
        .hero-title span { color: #00ff7f; text-shadow: 0 0 20px rgba(0,255,127,0.3); }
        .hero-subtitle {
            font-size: 1.2rem; color: #ddd; max-width: 700px;
            margin: 0 auto 40px auto; font-weight: 400; text-shadow: 0 2px 4px rgba(0,0,0,0.8);
        }

        .booking-widget {
            background: rgba(20, 30, 20, 0.6);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(0,255,127,0.2);
            border-radius: 50px; padding: 10px;
            display: flex; align-items: center; justify-content: space-between;
            max-width: 800px; margin: 0 auto;
            box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        }
        .widget-item {
            flex: 1; padding: 10px 20px;
            border-right: 1px solid rgba(255,255,255,0.1); text-align: left;
        }
        .widget-item:last-child { border-right: none; }
        .widget-label {
            display: block; font-size: 11px; text-transform: uppercase;
            color: #00ff7f; font-weight: 700; letter-spacing: 1px; margin-bottom: 5px;
        }
        .widget-select {
            background: transparent; border: none; color: #fff;
            font-size: 16px; font-weight: 600; width: 100%;
            outline: none; cursor: pointer; appearance: none;
        }
        .widget-select option { background: #1a1a1a; color: #fff; }
        .btn-search {
            background: #00ff7f; color: #000; border: none;
            height: 55px; width: 55px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; cursor: pointer; transition: 0.3s; margin-left: 10px;
        }
        .btn-search:hover { transform: scale(1.05); box-shadow: 0 0 20px rgba(0,255,127,0.5); }
    </style>
</head>
<body>

    <nav class="custom-navbar" id="navbar">
        <a href="/" class="nav-logo">
            <img src="~/images/logo.jpg" alt="Nexus Arena" style="height: 50px; object-fit: contain;" />
        </a>
        <div class="nav-buttons">
            <a asp-controller="Account" asp-action="Login" class="btn-login">Log In</a>
            <button type="button" class="btn-register" data-bs-toggle="modal" data-bs-target="#roleSelectionModal" style="border:none;">Register</button>
        </div>
    </nav>

    <section class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">Unleash Your <span>Game</span></h1>
            <p class="hero-subtitle">
                Book the best turfs in your city instantly, or partner with us to manage your arena like a pro. The ultimate sports ecosystem is here.
            </p>

            <div class="booking-widget">
                <div class="widget-item">
                    <span class="widget-label">City</span>
                    <select class="widget-select">
                        <option value="surat" selected>Surat</option>
                        <option value="mumbai">Mumbai</option>
                        <option value="ahmedabad">Ahmedabad</option>
                    </select>
                </div>
                <div class="widget-item">
                    <span class="widget-label">Sport</span>
                    <select class="widget-select">
                        <option value="">Any Sport</option>
                        <option value="cricket">Box Cricket</option>
                        <option value="football">Football</option>
                        <option value="pool">8-Ball Pool</option>
                    </select>
                </div>
                <div class="widget-item">
                    <span class="widget-label">Date</span>
                    <input type="date" class="widget-select" style="color-scheme: dark;">
                </div>
                <button class="btn-search"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </section>
    <div class="modal fade" id="roleSelectionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: #1a1a1a; border: 1px solid #333; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.8);">
                <div class="modal-header" style="border-bottom: 1px solid #333; padding: 20px;">
                    <h5 class="modal-title" style="color: #fff; font-weight: 700; letter-spacing: 1px;">
                        Join <span style="color: #00ff7f;">Nexus Arena</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding: 30px;">
                    <p style="color: #aaa; text-align: center; margin-bottom: 25px;">Choose how you want to use the platform.</p>
                    
                    <div class="d-grid gap-3">
                        <a asp-controller="Landing" asp-action="OwnerApplication" 
                           style="background: #222; border: 1px solid #00ff7f; color: #00ff7f; text-decoration: none; padding: 20px; border-radius: 15px; text-align: center; transition: 0.3s;"
                           onmouseover="this.style.background='#00ff7f'; this.style.color='#000';" 
                           onmouseout="this.style.background='#222'; this.style.color='#00ff7f';">
                            <i class="fas fa-building" style="font-size: 30px; margin-bottom: 10px; display: block;"></i>
                            <span style="font-weight: 700; font-size: 18px;">Register as Turf Owner</span>
                            <small style="display: block; font-size: 12px; margin-top: 5px; opacity: 0.8;">Partner with us & manage your arena</small>
                        </a>

                        <a asp-controller="Account" asp-action="Register" 
                           style="background: #222; border: 1px solid #3498db; color: #3498db; text-decoration: none; padding: 20px; border-radius: 15px; text-align: center; transition: 0.3s;"
                           onmouseover="this.style.background='#3498db'; this.style.color='#fff';" 
                           onmouseout="this.style.background='#222'; this.style.color='#3498db';">
                            <i class="fas fa-user-astronaut" style="font-size: 30px; margin-bottom: 10px; display: block;"></i>
                            <span style="font-weight: 700; font-size: 18px;">Register as Player</span>
                            <small style="display: block; font-size: 12px; margin-top: 5px; opacity: 0.8;">Book turfs and start playing</small>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.addEventListener('scroll', function() {
            var navbar = document.getElementById('navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>