@{
    ViewData["Title"] = "Nexus Arena - Book Your Turf";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            background-color: #080808;
            color: #fff;
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            background-image: radial-gradient(circle at 50% 30%, rgba(0, 255, 127, 0.08), transparent 60%);
        }

        .custom-navbar { padding: 20px 50px; display: flex; justify-content: space-between; align-items: center; }
        .logo-img { height: 45px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,255,127,0.3); }
        .nav-btns .btn-login { color: #fff; border: 1px solid #555; padding: 8px 24px; border-radius: 20px; text-decoration: none; margin-right: 15px; transition: 0.3s; }
        .nav-btns .btn-login:hover { border-color: #00ff7f; color: #00ff7f; }
        .nav-btns .btn-register { background: #00ff7f; color: #000; font-weight: 700; padding: 8px 24px; border-radius: 20px; text-decoration: none; transition: 0.3s; box-shadow: 0 0 15px rgba(0,255,127,0.4); }
        .nav-btns .btn-register:hover { background: #00cc66; transform: scale(1.05); }

        .hero-title { font-weight: 900; font-size: 4rem; text-align: center; margin-top: 50px; text-transform: uppercase; letter-spacing: 2px; }
        .text-glow { color: #00ff7f; text-shadow: 0 0 20px rgba(0,255,127,0.6); }
        .hero-sub { text-align: center; color: #aaa; font-size: 1.1rem; margin-top: 15px; margin-bottom: 40px; }

        .search-glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,127,0.1);
            border-radius: 50px;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            max-width: 800px;
            margin: 0 auto;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
        }
        .search-item { flex: 1; padding: 10px 20px; border-right: 1px solid rgba(255,255,255,0.1); }
        .search-item:last-child { border-right: none; }
        .search-label { font-size: 0.7rem; color: #00ff7f; font-weight: 700; text-transform: uppercase; margin-bottom: 5px; }
        .search-input { background: transparent; border: none; color: #fff; font-weight: 600; width: 100%; outline: none; }
        .btn-search-icon { background: #00ff7f; color: #000; border: none; width: 50px; height: 50px; border-radius: 50%; font-size: 1.2rem; transition: 0.3s; }
        .btn-search-icon:hover { background: #00cc66; transform: scale(1.1); box-shadow: 0 0 15px rgba(0,255,127,0.5); }

        .showcase-section { margin-top: 60px; padding: 0 80px 80px 80px; position: relative; }
        .showcase-title { font-weight: 800; font-size: 1.8rem; margin-bottom: 25px; border-left: 4px solid #00ff7f; padding-left: 15px; }
        
        .iconic-card {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            height: 500px; 
            cursor: pointer;
            border: 1px solid #333;
            transition: all 0.4s ease;
        }
        .iconic-card:hover {
            border-color: #00ff7f;
            box-shadow: 0 15px 50px rgba(0, 255, 127, 0.25);
            transform: scale(1.01);
        }
        .iconic-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s ease;
        }
        .iconic-card:hover .iconic-img {
            transform: scale(1.05); 
        }
        .iconic-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.5) 60%, transparent 100%);
            padding: 50px 40px 30px 40px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        .iconic-info h3 { font-weight: 900; font-size: 2.5rem; margin-bottom: 10px; text-shadow: 2px 2px 10px rgba(0,0,0,0.8); }
        .iconic-info p { color: #ddd; font-size: 1.2rem; margin-bottom: 0; font-weight: 600; }
        
        .iconic-price-tag {
            background: rgba(0, 255, 127, 0.15);
            color: #00ff7f;
            border: 1px solid #00ff7f;
            padding: 12px 30px;
            border-radius: 30px;
            font-weight: 900;
            font-size: 1.4rem;
            backdrop-filter: blur(8px);
            box-shadow: 0 0 20px rgba(0,255,127,0.2);
        }
        
        .carousel-control-prev, .carousel-control-next { width: 5%; z-index: 5; }
        .carousel-control-prev-icon, .carousel-control-next-icon { 
            background-color: #00ff7f; 
            border-radius: 50%; 
            padding: 25px; 
            background-size: 50%;
        }

        .modal-content { background-color: #111; border: 1px solid #333; border-radius: 20px; overflow: hidden; }
        .modal-header { border-bottom: 1px solid #333; background: #1a1a1a; }
        .modal-title { color: #00ff7f; font-weight: 800; }
        .modal-body-img { width: 100%; height: 300px; object-fit: cover; border-radius: 12px; margin-bottom: 20px; }
        .modal-feature { background: #222; padding: 10px 15px; border-radius: 8px; font-size: 0.9rem; font-weight: 600; color: #00ff7f; margin-right: 10px; margin-bottom: 10px; display: inline-block; border: 1px solid #333; }
        .btn-book-modal { background: #00ff7f; color: #000; font-weight: 800; width: 100%; padding: 15px; border: none; border-radius: 12px; font-size: 1.1rem; transition: 0.3s; margin-top: 20px; }
        .btn-book-modal:hover { background: #00cc66; box-shadow: 0 0 20px rgba(0,255,127,0.4); transform: scale(1.02); }
    </style>
</head>
<body>

    <nav class="custom-navbar">
        <img src="/images/logo.png" alt="Nexus Arena" class="logo-img" onerror="this.src='https://via.placeholder.com/150x50/111/00ff7f?text=NEXUS+ARENA'">
        <div class="nav-btns">
            <a href="/Account/Login" class="btn-login">Log In</a>
            <a href="/Account/Register" class="btn-register">Register</a>
        </div>
    </nav>

    <div class="container mt-4">
        <h1 class="hero-title">Unleash Your <span class="text-glow">Game</span></h1>
        <p class="hero-sub">Book the best turfs instantly, or partner with us to manage your arena like a pro.<br>The ultimate sports ecosystem is here.</p>

        <div class="search-glass">
            <div class="search-item">
                <div class="search-label">City</div>
                <input type="text" class="search-input" value="Surat" placeholder="Enter City">
            </div>
            <div class="search-item">
                <div class="search-label">Sport</div>
                <input type="text" class="search-input" placeholder="Any Sport">
            </div>
            <div class="search-item">
                <div class="search-label">Date</div>
                <input type="date" class="search-input" style="color-scheme: dark;">
            </div>
            <button class="btn-search-icon"><i class="fas fa-search"></i></button>
        </div>
    </div>

    <div class="showcase-section">
        <h3 class="showcase-title">Featured Arenas</h3>
        
        <div id="arenaCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
            <div class="carousel-inner" style="border-radius: 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.8);">
                
                <div class="carousel-item active" data-bs-interval="7000">
                    <div class="iconic-card" onclick="openDetails('Surat Premium Arena', 'Surat, Gujarat', '₹ 1200/hr', 'https://images.unsplash.com/photo-1575361204480-aadea25e6e68?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80')">
                        <img src="https://images.unsplash.com/photo-1575361204480-aadea25e6e68?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" class="iconic-img" alt="Turf">
                        <div class="iconic-overlay">
                            <div class="iconic-info">
                                <h3>Surat Premium Arena</h3>
                                <p><i class="fas fa-map-marker-alt text-glow me-2"></i> Surat, Gujarat</p>
                            </div>
                            <div class="iconic-price-tag">₹ 1200 / hr</div>
                        </div>
                    </div>
                </div>

                <div class="carousel-item" data-bs-interval="7000">
                    <div class="iconic-card" onclick="openDetails('Nexus Box Cricket', 'Vesu, Surat', '₹ 1000/hr', 'https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80')">
                        <img src="https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" class="iconic-img" alt="Turf">
                        <div class="iconic-overlay">
                            <div class="iconic-info">
                                <h3>Nexus Box Cricket</h3>
                                <p><i class="fas fa-map-marker-alt text-glow me-2"></i> Vesu, Surat</p>
                            </div>
                            <div class="iconic-price-tag">₹ 1000 / hr</div>
                        </div>
                    </div>
                </div>

                <div class="carousel-item" data-bs-interval="7000">
                    <div class="iconic-card" onclick="openDetails('Elite Football Ground', 'Adajan, Surat', '₹ 1500/hr', 'https://images.unsplash.com/photo-1459865264687-595d652de67e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80')">
                        <img src="https://images.unsplash.com/photo-1459865264687-595d652de67e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" class="iconic-img" alt="Turf">
                        <div class="iconic-overlay">
                            <div class="iconic-info">
                                <h3>Elite Football Ground</h3>
                                <p><i class="fas fa-map-marker-alt text-glow me-2"></i> Adajan, Surat</p>
                            </div>
                            <div class="iconic-price-tag">₹ 1500 / hr</div>
                        </div>
                    </div>
                </div>

                <div class="carousel-item" data-bs-interval="7000">
                    <div class="iconic-card" onclick="openDetails('Pro Tennis Court', 'Piplod, Surat', '₹ 800/hr', 'https://images.unsplash.com/photo-1622279457486-62dcc4a431d6?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80')">
                        <img src="https://images.unsplash.com/photo-1622279457486-62dcc4a431d6?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" class="iconic-img" alt="Turf">
                        <div class="iconic-overlay">
                            <div class="iconic-info">
                                <h3>Pro Tennis Court</h3>
                                <p><i class="fas fa-map-marker-alt text-glow me-2"></i> Piplod, Surat</p>
                            </div>
                            <div class="iconic-price-tag">₹ 800 / hr</div>
                        </div>
                    </div>
                </div>

            </div>
            
            <button class="carousel-control-prev" type="button" data-bs-target="#arenaCarousel" data-bs-slide="prev" style="left: -30px;">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#arenaCarousel" data-bs-slide="next" style="right: -30px;">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>

    <div class="modal fade" id="turfModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Turf Name</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <img src="" id="modalImg" class="modal-body-img" alt="Turf Image">
                    
                    <div class="row">
                        <div class="col-md-8">
                            <h4 style="font-weight: 800; color: #fff; margin-bottom: 5px;" id="modalLocation">Location</h4>
                            
                            <p style="color: #e0e0e0; font-size: 1rem; line-height: 1.6; margin-bottom: 20px; font-weight: 500;">
                                Experience the best sporting action on our premium quality artificial grass. Equipped with floodlights and excellent seating arrangements. Perfect for your next match!
                            </p>
                            
                            <div>
                                <span class="modal-feature"><i class="fas fa-parking"></i> Free Parking</span>
                                <span class="modal-feature"><i class="fas fa-tint"></i> Drinking Water</span>
                                <span class="modal-feature"><i class="fas fa-lightbulb"></i> Floodlights</span>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <h2 style="color: #00ff7f; font-weight: 900;" id="modalPrice">₹ 0/hr</h2>
                            <p style="color: #aaa; font-weight: 600;">Available Today</p>
                        </div>
                    </div>
                    
                    <button class="btn-book-modal" onclick="window.location.href='/Account/Login'">
                        Book Now <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var myCarousel = document.querySelector('#arenaCarousel');
            var carousel = new bootstrap.Carousel(myCarousel, {
                interval: 7000,
                ride: 'carousel'
            });
        });

        function openDetails(name, location, price, imgUrl) {
            document.getElementById('modalTitle').innerText = name;
            document.getElementById('modalLocation').innerText = location;
            document.getElementById('modalPrice').innerText = price;
            document.getElementById('modalImg').src = imgUrl;

            var myModal = new bootstrap.Modal(document.getElementById('turfModal'));
            myModal.show();
        }
    </script>
</body>
</html>