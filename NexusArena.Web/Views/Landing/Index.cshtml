@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nexus Arena - Book Your Turf</title>
    <link rel="icon" type="image/jpg" href="~/images/logo.jpg">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Montserrat', sans-serif; background-color: #0f0f0f; color: #fff; overflow-x: hidden; }

        .navbar {
            display: flex; justify-content: space-between; align-items: center;
            padding: 15px 50px; background: rgba(26, 26, 26, 0.85);
            backdrop-filter: blur(12px); position: fixed; width: 100%; top: 0; z-index: 100;
            border-bottom: 1px solid #222;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }
        
        .nav-logo {
            height: 45px; 
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 255, 127, 0.3);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: block;
        }
        .nav-logo:hover {
            box-shadow: 0 0 20px rgba(0, 255, 127, 0.8);
            transform: scale(1.05) translateY(-2px);
            filter: brightness(1.1);
        }

        .nav-buttons { display: flex; gap: 15px; align-items: center; }
        
        .btn-login { background: transparent; color: #fff; border: 1px solid #555; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.3s; }
        .btn-login:hover { border-color: #00ff7f; color: #00ff7f; background: rgba(0, 255, 127, 0.05); }
        
        .btn-register { background: #00ff7f; color: #000; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.3s; box-shadow: 0 0 10px rgba(0, 255, 127, 0.4); }
        .btn-register:hover { transform: translateY(-2px); box-shadow: 0 0 20px rgba(0, 255, 127, 0.8); }

        .hero {
            height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;
            background: 
                radial-gradient(circle at center, rgba(0, 255, 127, 0.08) 0%, #0f0f0f 60%),
                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 40px 40px, 40px 40px;
            padding: 0 20px;
        }
        .hero h1 { font-size: 55px; font-weight: 800; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 2px; }
        .hero h1 span { color: #00ff7f; text-shadow: 0 0 25px rgba(0, 255, 127, 0.6); }
        .hero p { font-size: 18px; color: #aaa; max-width: 600px; margin-bottom: 40px; line-height: 1.6; }

        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(8px);
            display: flex; justify-content: center; align-items: center;
            opacity: 0; visibility: hidden; transition: 0.4s ease; z-index: 999;
        }
        .modal-overlay.active { opacity: 1; visibility: visible; }
        
        .modal-content {
            background: #111; padding: 40px; border-radius: 16px; border: 1px solid #333;
            text-align: center; max-width: 600px; width: 90%;
            transform: translateY(30px) scale(0.95); transition: 0.4s ease; box-shadow: 0 15px 40px rgba(0,255,127,0.15);
            position: relative;
        }
        .modal-overlay.active .modal-content { transform: translateY(0) scale(1); }
        
        .close-btn { position: absolute; top: 15px; right: 20px; color: #666; font-size: 24px; cursor: pointer; transition: 0.3s; }
        .close-btn:hover { color: #ff4d4d; transform: rotate(90deg); }

        .modal-content h2 { margin-bottom: 10px; font-size: 26px; color: #fff; }
        .modal-content p { color: #aaa; margin-bottom: 30px; font-size: 15px; }

        .role-cards { display: flex; gap: 20px; justify-content: center; }
        
        .role-card {
            background: #1a1a1a; border: 2px solid #2a2a2a; border-radius: 12px; padding: 30px 20px;
            width: 220px; cursor: pointer; transition: 0.3s; text-decoration: none; color: #fff;
            position: relative; overflow: hidden;
        }
        .role-card i { font-size: 45px; margin-bottom: 15px; color: #555; transition: 0.3s; }
        .role-card h3 { font-size: 19px; margin-bottom: 8px; font-weight: 700; }
        .role-card span { font-size: 13px; color: #888; }

        .role-card:hover { border-color: #00ff7f; background: rgba(0, 255, 127, 0.05); transform: translateY(-8px); box-shadow: 0 15px 25px rgba(0, 255, 127, 0.15); }
        .role-card:hover i { color: #00ff7f; transform: scale(1.1); }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="brand">
            <a href="/Landing/Index" style="text-decoration: none;">
                <img src="~/images/logo.jpg" alt="Nexus Arena Logo" class="nav-logo" />
            </a>
        </div>
        <div class="nav-buttons">
            <button class="btn-login" onclick="window.location.href='/Account/Login'">Login</button>
            <button class="btn-register" onclick="openModal()">Register</button>
        </div>
    </nav>

    <div class="hero">
        <h1>Unleash Your <span>Game</span></h1>
        <p>Book the best turfs in your city instantly, or partner with us to manage your arena like a pro. The ultimate sports ecosystem is here.</p>
        <button class="btn-register" style="padding: 15px 40px; font-size: 18px; letter-spacing: 1px;" onclick="openModal()">Get Started</button>
    </div>

    <div class="modal-overlay" id="registerModal">
        <div class="modal-content">
            <i class="fas fa-times close-btn" onclick="closeModal()"></i>
            <h2>How do you want to join?</h2>
            <p>Select your account type to proceed with registration.</p>
            
            <div class="role-cards">
                <a href="/Account/PlayerRegistration" class="role-card">
                    <i class="fas fa-running"></i>
                    <h3>As a Player</h3>
                    <span>Book turfs & play</span>
                </a>

                <a href="/Landing/OwnerApplication" class="role-card">
                    <i class="fas fa-building"></i>
                    <h3>As an Owner</h3>
                    <span>List & manage your turf</span>
                </a>
            </div>
        </div>
    </div>

    <script>
        const modal = document.getElementById('registerModal');

        function openModal() {
            modal.classList.add('active');
        }

        function closeModal() {
            modal.classList.remove('active');
        }

        window.onclick = function(event) {
            if (event.target == modal) {
                closeModal();
            }
        }
    </script>
</body>
</html>