@model NexusArena.Web.Models.ManageReceptionistViewModel
@{
    ViewData["Title"] = "Edit Staff";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<style>
    body {
        background-color: #121212;
        color: white;
    }

    .card {
        background-color: #1e1e1e;
        border: 1px solid #333;
        padding: 25px;
        border-radius: 8px;
        color: white;
        margin-bottom: 20px;
    }

    .form-control {
        background-color: #2b2b2b;
        border: 1px solid #444;
        color: white;
    }

        .form-control:focus {
            background-color: #333;
            border-color: #00e676;
            box-shadow: none;
            color: white;
        }

    .btn-green {
        background-color: #219653;
        color: white;
        font-weight: bold;
        padding: 10px;
        border: none;
    }

        .btn-green:hover {
            background-color: #27ae60;
            color: white;
        }
</style>

<div class="container-fluid mt-4">
    <h2 class="text-success fw-bold mb-4">Edit Staff Member</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <h5 class="mb-4 fw-bold">Update Details for @Model.FullName</h5>
                <form asp-action="EditStaff" method="post">
                    <input type="hidden" name="originalEmail" value="@ViewBag.OriginalEmail" />

                    <div class="mb-3">
                        <label class="form-label text-light">Full Name</label>
                        <input type="text" asp-for="FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light">Email Address</label>
                        <input type="email" asp-for="Email" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-light">Phone Number</label>
                        <input type="text" asp-for="Phone" class="form-control" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-green w-50 rounded">Save Changes</button>
                        <a href="/OwnerDashboard/Staff" class="btn btn-secondary w-50 rounded" style="padding: 10px;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>