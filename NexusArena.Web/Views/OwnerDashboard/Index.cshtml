@model NexusArena.MVC.Models.OwnerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

@section Styles {
    <style>
        body {
            background-color: #121212;
            color: white;
        }

        .stat-card {
            background-color: var(--panel-bg, #1e1e1e);
            border-radius: 10px;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid var(--border-color, #333);
        }

            .stat-card h3 {
                margin: 0;
                font-size: 28px;
                font-weight: bold;
            }

            .stat-card p {
                margin: 0;
                color: var(--text-muted, #aaa);
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .stat-card .icon-box {
                background-color: rgba(0, 230, 118, 0.1);
                color: var(--accent-green, #00e676);
                width: 50px;
                height: 50px;
                border-radius: 10px;
                display: flex;
                justify-content: center;
                align-items: center;
                font-size: 24px;
            }

        .dark-table-container {
            background-color: var(--panel-bg, #1e1e1e);
            border-radius: 10px;
            padding: 20px;
            border: 1px solid var(--border-color, #333);
            margin-top: 30px;
        }

        .dark-table {
            width: 100%;
            color: var(--text-main, white);
        }

            .dark-table th {
                color: var(--accent-green, #00e676);
                font-size: 12px;
                text-transform: uppercase;
                border-bottom: 1px solid var(--border-color, #333);
                padding: 15px 10px;
            }

            .dark-table td {
                padding: 15px 10px;
                border-bottom: 1px solid var(--border-color, #333);
                font-size: 14px;
                vertical-align: middle;
            }

        .badge-active {
            background-color: rgba(0, 230, 118, 0.2);
            color: var(--accent-green, #00e676);
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            border: 1px solid var(--accent-green, #00e676);
        }

        .badge-pending {
            background-color: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            border: 1px solid #ffc107;
        }

        .btn-cancel {
            background-color: transparent;
            color: #ff4d4d;
            border: 1px solid #ff4d4d;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: bold;
            transition: 0.3s;
            cursor: pointer;
            width: 100%;
        }

            .btn-cancel:hover {
                background-color: #ff4d4d;
                color: white;
            }

        .reason-select {
            background-color: #2b2b2b;
            color: white;
            border: 1px solid #444;
            border-radius: 4px;
            padding: 4px;
            font-size: 11px;
            width: 100%;
            margin-bottom: 5px;
        }

            .reason-select:focus {
                outline: none;
                border-color: #ff4d4d;
            }
    </style>
}

<div>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning mt-2">@ViewBag.Error</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2">@TempData["Success"]</div>
    }
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div>
                <h3>₹ @(Model?.TodayRevenue ?? 0)</h3>
                <p>Today's Revenue</p>
            </div>
            <div class="icon-box"><i class="fas fa-wallet"></i></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div>
                <h3>@(string.IsNullOrEmpty(Model?.LiveOccupancy) ? "0%" : Model.LiveOccupancy)</h3>
                <p>Live Occupancy</p>
            </div>
            <div class="icon-box"><i class="fas fa-users"></i></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div>
                <h3>@(Model?.UpcomingBookings?.Count ?? 0)</h3>
                <p>Upcoming Bookings</p>
            </div>
            <div class="icon-box"><i class="fas fa-calendar-check"></i></div>
        </div>
    </div>
</div>

<div class="dark-table-container">
    <h5 style="color: white; margin-bottom: 20px;"><i class="fas fa-clipboard-list" style="color: var(--accent-green, #00e676);"></i> Upcoming Bookings</h5>
    <table class="dark-table">
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Facility</th>
                <th>Time Slot</th>
                <th>Status</th>
                <th style="width: 150px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.UpcomingBookings != null && Model.UpcomingBookings.Any())
            {
                foreach (var booking in Model.UpcomingBookings)
                {
                    <tr>
                        <td>@booking.CustomerName</td>
                        <td>@booking.FacilityName</td>
                        <td>@booking.TimeSlot</td>
                        <td>
                            @if (booking.Status == "Confirmed")
                            {
                                <span class="badge-active">@booking.Status</span>
                            }
                            else
                            {
                                <span class="badge-pending">@booking.Status</span>
                            }
                        </td>
                        <td>
                            <form asp-action="CancelBooking" asp-controller="OwnerDashboard" method="post" style="margin: 0;">
                                <input type="hidden" name="bookingId" value="@booking.BookingId" />

                                <select name="cancelReason" class="reason-select" onchange="checkOtherReason(this)" required>
                                    <option value="" disabled selected>-- Select Reason --</option>
                                    <option value="Rain / Bad Weather">Rain / Bad Weather</option>
                                    <option value="Maintenance Issue">Maintenance Issue</option>
                                    <option value="Customer Requested">Customer Requested</option>
                                    <option value="Other">Other</option>
                                </select>

                                <button type="submit" class="btn-cancel" onclick="return confirm('Cancel booking and send notification to customer?');">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center text-muted">No upcoming bookings today.</td></tr>
            }
        </tbody>
    </table>
</div>

<script>
    function checkOtherReason(selectElement) {
        // Agar user ne dropdown me "Other" select kiya
        if (selectElement.value === "Other") {
            // Javascript ka prompt popup khulega
            let customReason = prompt("Please type your custom cancellation reason:");

            // Agar user ne reason daala aur OK dabaya
            if (customReason != null && customReason.trim() !== "") {
                // Dropdown me on-the-fly ek naya option add karenge
                let newOption = document.createElement("option");
                newOption.value = "Other: " + customReason;
                newOption.text = "Other: " + customReason;
                newOption.selected = true; // Usko automatically select bhi kar denge
                selectElement.add(newOption);
            } else {
                // Agar cancel kiya ya khaali chhod diya, to wapas default pe set kardo
                selectElement.value = "";
            }
        }
    }
</script>