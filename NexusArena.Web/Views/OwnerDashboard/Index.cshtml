@{
}
@{
    ViewData["Title"] = "Dashboard";
    // Master Page ko yahan link kiya hai
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

@section Styles {
    <style>
        .stat-card {
            background-color: var(--panel-bg);
            border-radius: 10px;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid var(--border-color);
        }

            .stat-card h3 {
                margin: 0;
                font-size: 28px;
                font-weight: bold;
            }

            .stat-card p {
                margin: 0;
                color: var(--text-muted);
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .stat-card .icon-box {
                background-color: rgba(0, 230, 118, 0.1);
                color: var(--accent-green);
                width: 50px;
                height: 50px;
                border-radius: 10px;
                display: flex;
                justify-content: center;
                align-items: center;
                font-size: 24px;
            }

        .dark-table-container {
            background-color: var(--panel-bg);
            border-radius: 10px;
            padding: 20px;
            border: 1px solid var(--border-color);
            margin-top: 30px;
        }

        .dark-table {
            width: 100%;
            color: var(--text-main);
        }

            .dark-table th {
                color: var(--accent-green);
                font-size: 12px;
                text-transform: uppercase;
                border-bottom: 1px solid var(--border-color);
                padding: 15px 10px;
            }

            .dark-table td {
                padding: 15px 10px;
                border-bottom: 1px solid var(--border-color);
                font-size: 14px;
            }

        .badge-active {
            background-color: rgba(0, 230, 118, 0.2);
            color: var(--accent-green);
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            border: 1px solid var(--accent-green);
        }
    </style>
}

<div>
    <h4 class="mb-1 text-white">Overview</h4>
    <p class="text-muted" style="font-size: 14px;">Real-time statistics of your arenas and bookings.</p>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div>
                <h3 id="todayRevenueVal">₹0</h3>
                <p>Today's Revenue</p>
            </div>
            <div class="icon-box"><i class="fas fa-wallet"></i></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div>
                <h3 id="occupancyVal">0%</h3>
                <p>Live Occupancy</p>
            </div>
            <div class="icon-box"><i class="fas fa-users"></i></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div>
                <h3 id="upcomingCountVal">0</h3>
                <p>Upcoming Bookings</p>
            </div>
            <div class="icon-box"><i class="fas fa-calendar-check"></i></div>
        </div>
    </div>
</div>

<div class="dark-table-container">
    <h5 style="color: white; margin-bottom: 20px;"><i class="fas fa-clipboard-list" style="color: var(--accent-green);"></i> Upcoming Bookings</h5>
    <table class="dark-table">
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Facility</th>
                <th>Time Slot</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody id="bookingsTableBody">
            <tr><td colspan="4" class="text-center">Loading data...</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ⚠️ Apne Web API ka exact URL yahan daalna
            const apiUrl = "https://localhost:5092/api/OwnerDashboard/stats";

            // Testing ke liye apna JWT token yahan daal do
            const token = "TUMHARA_JWT_TOKEN_YAHAN_AAYEGA";

            fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById("todayRevenueVal").innerText = "₹" + data.todayRevenue;
                document.getElementById("occupancyVal").innerText = data.liveOccupancy;
                document.getElementById("upcomingCountVal").innerText = data.upcomingBookings.length;

                const tableBody = document.getElementById("bookingsTableBody");
                tableBody.innerHTML = "";

                if (data.upcomingBookings.length === 0) {
                    tableBody.innerHTML = `<tr><td colspan="4" class="text-center text-muted">No upcoming bookings today.</td></tr>`;
                } else {
                    data.upcomingBookings.forEach(booking => {
                        const row = `<tr>
                            <td>${booking.customerName}</td>
                            <td>${booking.facilityName}</td>
                            <td>${booking.timeSlot}</td>
                            <td><span class="badge-active">${booking.status}</span></td>
                        </tr>`;
                        tableBody.innerHTML += row;
                    });
                }
            })
            .catch(error => {
                console.error("Error fetching data:", error);
                document.getElementById("bookingsTableBody").innerHTML = `<tr><td colspan="4" class="text-center text-danger">Failed to load API data.</td></tr>`;
            });
        });
    </script>
}