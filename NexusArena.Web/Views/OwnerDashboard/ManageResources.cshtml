@model NexusArena.MVC.Models.ResourceViewModel
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="container mt-4">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    <div class="card bg-dark text-white p-4">
        <h4>Add New Resource</h4>
        <form asp-action="AddResource" asp-controller="OwnerDashboard" method="post">
            <div class="mb-3">
                <label>Resource Name</label>
                <input asp-for="ResourceName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Max Players (Capacity)</label>
                <input asp-for="Capacity" type="number" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Save Resource</button>
        </form>
    </div>
</div>