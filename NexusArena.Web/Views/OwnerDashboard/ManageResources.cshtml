@model NexusArena.MVC.Models.ResourceViewModel

@{
    ViewData["Title"] = "Manage Resources";
    Layout = "_OwnerLayout";
}

<div class="container-fluid">
    <h2 style="color: #00ff7f;">Manage Arenas & Resources</h2>
    <hr style="border-color: #333;" />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="background-color: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f;">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" style="background-color: rgba(255, 77, 77, 0.1); color: #ff4d4d; border: 1px solid #ff4d4d;">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
        </div>
    }

    <div class="card p-4 mb-5" style="background-color: #1a1a1a; color: #fff; border: 1px solid #333; border-radius: 8px;">
        
        <div class="alert mb-4" style="background-color: #222; border-left: 4px solid #00ff7f; color: #ccc;">
            <i class="fas fa-info-circle text-info"></i>
            <strong>Note:</strong> Your arena's name and address have been verified by the system. You can only add and update the facilities (turfs/tables) within it here.
        </div>

        <h4 class="mb-4" style="color: #00ff7f;">Add New Facility (Turf/Table)</h4>

        <form asp-action="AddResource" asp-controller="OwnerDashboard" method="post">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="ResourceName" class="form-label text-light">Facility Name</label>
                    <input asp-for="ResourceName" class="form-control" style="background-color: #222; color: #fff; border: 1px solid #444;" placeholder="e.g. Turf 1, Pool Table A" required />
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="ResourceType" class="form-label text-light">Type (Sport)</label>
                    <select asp-for="ResourceType" class="form-control" style="background-color: #222; color: #fff; border: 1px solid #444;">
                        <option value="Box Cricket">Box Cricket</option>
                        <option value="Pool">Pool Table</option>
                        <option value="Bowling">Bowling Alley</option>
                        <option value="Snooker">Snooker</option>
                        <option value="Football">Turf Football</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="BasePricePerHour" class="form-label text-light">Price Per Hour (₹)</label>
                    <input asp-for="BasePricePerHour" type="number" class="form-control" style="background-color: #222; color: #fff; border: 1px solid #444;" placeholder="₹" required />
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="Capacity" class="form-label text-light">Capacity</label>
                    <input asp-for="Capacity" type="number" class="form-control" style="background-color: #222; color: #fff; border: 1px solid #444;" placeholder="Max Players" required />
                </div>
            </div>

            <input type="hidden" asp-for="IsActive" value="true" />

            <div class="mt-3">
                <button type="submit" class="btn" style="background-color: #00ff7f; color: black; font-weight: bold; border-radius: 6px;">
                    <i class="fas fa-plus"></i> Add Facility
                </button>
            </div>
        </form>
    </div>

    <div class="mt-5 mb-5">
        <h3 style="color: #00ff7f;"><i class="fas fa-list"></i> Existing Turfs & Tables</h3>

        <div class="table-responsive mt-3" style="border-radius: 8px; overflow: hidden; border: 1px solid #333;">
            <table class="table table-dark table-hover mb-0" style="background-color: #1a1a1a;">
                <thead style="background-color: #222; color: #ccc;">
                    <tr>
                        <th style="padding: 15px;">Resource Name</th>
                        <th style="padding: 15px;">Type</th>
                        <th style="padding: 15px;">Price/Hr</th>
                        <th style="padding: 15px;">Capacity</th>
                        <th style="padding: 15px;">Status</th>
                        <th style="padding: 15px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.ResourceList != null)
                    {
                        var list = (List<NexusArena.MVC.Models.ResourceViewModel>)ViewBag.ResourceList;
                        if (list.Count > 0)
                        {
                            foreach (var item in list)
                            {
                                <tr style="border-bottom: 1px solid #333;">
                                    <td style="padding: 15px; vertical-align: middle;"><strong>@item.ResourceName</strong></td>
                                    <td style="padding: 15px; vertical-align: middle;">@item.ResourceType</td>
                                    <td style="padding: 15px; vertical-align: middle;">₹@item.BasePricePerHour</td>
                                    <td style="padding: 15px; vertical-align: middle;">@item.Capacity Players</td>
                                    <td style="padding: 15px; vertical-align: middle;">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge" style="background-color: rgba(0, 255, 127, 0.1); color: #00ff7f; border: 1px solid #00ff7f; padding: 6px 12px; border-radius: 20px;">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: rgba(255, 77, 77, 0.1); color: #ff4d4d; border: 1px solid #ff4d4d; padding: 6px 12px; border-radius: 20px;">Inactive</span>
                                        }
                                    </td>
                                    <td style="padding: 15px; vertical-align: middle;">
                                        <button class="btn btn-sm" style="background: transparent; border: 1px solid #00ff7f; color: #00ff7f; margin-right: 5px;" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm" style="background: transparent; border: 1px solid #ff4d4d; color: #ff4d4d;" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center" style="color: #888; padding: 30px;">
                                    No resources found. No Turf or Table has been added yet. <br />
                                    Add a new resource using the form above.
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center" style="color: #ff4d4d; padding: 30px;">
                                Cannot connect to API to fetch resources.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>