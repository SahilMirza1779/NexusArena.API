@model NexusArena.MVC.Models.ResourceViewModel
@{
    ViewData["Title"] = "Manage Arenas & Resources";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<style>
    body {
        background-color: #121212;
        color: white;
    }

    .card {
        background-color: #1e1e1e;
        border: none;
        padding: 25px;
        border-radius: 8px;
        color: white;
    }

        .card h5 {
            color: #ffffff;
            margin-bottom: 20px;
            font-weight: 600;
        }

    .form-label {
        color: #e0e0e0;
        font-size: 0.95rem;
        margin-bottom: 5px;
        display: inline-block;
    }

    .form-control, .form-select {
        background-color: #2b2b2b;
        border: 1px solid #444;
        color: white !important;
    }

    .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        padding: 8px 10px;
        background-color: #2b2b2b;
        border: 1px solid #444;
        border-radius: 5px;
    }

    .checkbox-item {
        color: white;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

    .btn-green {
        background-color: #00e676;
        color: black;
        font-weight: bold;
        padding: 10px;
        border: none;
    }

    table {
        color: white;
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    th {
        border-bottom: 2px solid #444;
        padding: 12px 10px;
        color: #cccccc;
        font-size: 0.85rem;
    }

    td {
        border-bottom: 1px solid #333;
        padding: 15px 10px;
        vertical-align: middle;
    }

    .btn-edit {
        background-color: transparent;
        color: #4dabf7;
        border: 1px solid #4dabf7;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        text-decoration: none;
    }

    .btn-delete {
        background-color: transparent;
        color: #ff4d4d;
        border: 1px solid #ff4d4d;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        cursor: pointer;
    }
</style>

<div class="container mt-4">
    <h2 class="text-success fw-bold">Manage Arenas & Resources</h2>

    <div class="card shadow-sm mt-4">
        <h5>Add New Business</h5>
        <form asp-action="AddResource" method="post" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Business Name</label>
                <input type="text" name="ResourceName" class="form-control" required />
            </div>
            <div class="col-md-5">
                <label class="form-label">Type (Sports)</label>
                <div class="checkbox-group">
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Box Cricket"> Box Cricket</label>
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Box Football"> Box Football</label>
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Bowling"> Bowling</label>
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Pool"> Pool</label>
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Pickleball"> Pickleball</label>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-green w-100 rounded">+ Add Business</button>
            </div>
        </form>
    </div>

    <table class="mt-4">
        <thead>
            <tr><th>Business Name</th><th>Type (Sports)</th><th>Action</th></tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.ResourceList)
            {
                <tr>
                    <td>@item.ResourceName</td>
                    <td>@item.ResourceType</td>
                    <td>
                        <div style="display:flex; gap:10px;">
                            <a href="/OwnerDashboard/EditResource?resourceName=@item.ResourceName" class="btn-edit">Edit</a>
                            <form asp-action="DeleteResource" method="post">
                                <input type="hidden" name="resourceName" value="@item.ResourceName" />
                                <button type="submit" class="btn-delete" onclick="return confirm('Pakka delete karna hai?');">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>