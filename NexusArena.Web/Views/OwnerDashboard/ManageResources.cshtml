@model NexusArena.MVC.Models.ResourceViewModel
@{
    ViewData["Title"] = "Manage Arenas & Resources";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<style>
    body {
        background-color: #121212;
        color: white;
    }

    .card {
        background-color: #1e1e1e;
        border: none;
        padding: 25px;
        border-radius: 8px;
        color: white;
    }

        .card h5 {
            color: #ffffff;
            margin-bottom: 20px;
            font-weight: 600;
        }

    .form-label {
        color: #e0e0e0;
        font-size: 0.95rem;
        margin-bottom: 5px;
        display: inline-block;
    }

    .form-control, .form-select {
        background-color: #2b2b2b;
        border: 1px solid #444;
        color: white !important;
    }

        .form-control:focus, .form-select:focus {
            background-color: #333;
            border-color: #00e676;
            box-shadow: none;
            color: white;
        }

    /* Checkbox styling */
    .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        padding: 8px 10px;
        background-color: #2b2b2b;
        border: 1px solid #444;
        border-radius: 5px;
    }

    .checkbox-item {
        color: white;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

        .checkbox-item input[type="checkbox"] {
            accent-color: #00e676;
            cursor: pointer;
        }

    .btn-green {
        background-color: #00e676;
        color: black;
        font-weight: bold;
        padding: 10px;
        border: none;
    }

        .btn-green:hover {
            background-color: #00c853;
        }

    table {
        color: white;
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    th {
        border-bottom: 2px solid #444;
        padding: 12px 10px;
        color: #cccccc;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    td {
        border-bottom: 1px solid #333;
        padding: 15px 10px;
        font-size: 0.95rem;
    }

    .text-custom-green {
        color: #00e676;
    }
</style>

<div class="container mt-4">
    <h2 class="text-custom-green fw-bold">Owner Portal</h2>
    <h3 class="mb-4">Manage Arenas & Resources</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2">@TempData["Error"]</div>
    }

    <!-- Add New Business Form -->
    <div class="card shadow-sm">
        <h5>Add New Business</h5>
        <!-- Form par id lagayi hai taaki JS ise pehchan sake -->
        <form asp-action="AddResource" method="post" class="row g-3" id="addBusinessForm">
            <div class="col-md-4">
                <label class="form-label">Business Name</label>
                <!-- Id 'businessNameInput' lagayi duplicate check ke liye -->
                <input type="text" name="ResourceName" id="businessNameInput" class="form-control" required placeholder="e.g. Premium Turf 1" />
            </div>

            <div class="col-md-5">
                <label class="form-label">Type (Sports)</label>
                <!-- Dropdown hata kar Multiple Checkboxes laga diye -->
                <div class="checkbox-group">
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Box Cricket"> Box Cricket</label>
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Box Football"> Box Football</label>
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Bowling"> Bowling</label>
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Pool"> Pool</label>
                    <label class="checkbox-item"><input type="checkbox" name="SelectedSports" value="Pickleball"> Pickleball</label>
                </div>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-green w-100 rounded">+ Add Business</button>
            </div>
        </form>
    </div>

    <!-- Existing Table -->
    <h4 class="mt-5 mb-3">Existing Businesses</h4>
    <table id="businessTable">
        <thead>
            <tr>
                <th>Business Name</th>
                <th>Type (Sports)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{
                var resourceList = ViewBag.ResourceList as List<NexusArena.MVC.Models.ResourceViewModel> ?? new List<NexusArena.MVC.Models.ResourceViewModel>();
            }
            @foreach (var item in resourceList)
            {
                <tr>
                    <td>@item.ResourceName</td>
                    <td>@item.ResourceType</td>
                    <td>
                        <span class="badge" style="background-color: rgba(0, 230, 118, 0.15); color: #00e676; border: 1px solid #00e676; padding: 6px 12px;">Active</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Duplicate Name Check aur Checkbox Validation ka Script -->
<script>
    document.getElementById('addBusinessForm').addEventListener('submit', function(e) {
        var newName = document.getElementById('businessNameInput').value.trim().toLowerCase();

        // 1. Table se purane saare naam nikal kar check karo
        var tableRows = document.querySelectorAll('#businessTable tbody tr');
        var isDuplicate = false;

        tableRows.forEach(function(row) {
            var nameCell = row.cells[0]; // Pehla column (Business Name)
            if(nameCell && nameCell.innerText) {
                var existingName = nameCell.innerText.trim().toLowerCase();
                if(existingName === newName) {
                    isDuplicate = true;
                }
            }
        });

        if(isDuplicate) {
            e.preventDefault(); // Form submit hone se roko
            alert("⚠️ Ye Business Name already added hai! Kripya koi aur naam daaliye."); // Popup dikhao
            return false;
        }

        // 2. Check karo ki kam se kam 1 sport select kiya hai ya nahi
        var checkboxes = document.querySelectorAll('input[name="SelectedSports"]:checked');
        if(checkboxes.length === 0) {
            e.preventDefault(); // Form submit hone se roko
            alert("⚠️ Kam se kam ek Sport select karna zaroori hai!");
            return false;
        }
    });
</script>