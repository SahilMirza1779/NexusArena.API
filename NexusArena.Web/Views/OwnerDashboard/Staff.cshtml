@model NexusArena.MVC.Models.StaffPageViewModel
@{
    ViewData["Title"] = "Manage Staff";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="container-fluid mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card p-4 text-white" style="background-color: #1a1d20; border: 1px solid #333; border-radius: 10px;">
                <h4 class="mb-4">Add New Staff</h4>
                <form asp-action="AddStaff" asp-controller="OwnerDashboard" method="post">

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input asp-for="NewStaff.FullName" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Rahul Sharma" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input asp-for="NewStaff.Email" type="email" class="form-control bg-dark text-white border-secondary" placeholder="staff@example.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input asp-for="NewStaff.Phone" type="text" maxlength="10" class="form-control bg-dark text-white border-secondary" placeholder="9876543210" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Temporary Password</label>
                        <input asp-for="NewStaff.Password" type="password" class="form-control bg-dark text-white border-secondary" placeholder="Enter password for staff login" required />
                    </div>

                    <button type="submit" class="btn btn-success w-100">Register Staff</button>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card p-4 text-white" style="background-color: #1a1d20; border: 1px solid #333; border-radius: 10px;">
                <h4 class="mb-4">Existing Staff Members</h4>
                <div class="table-responsive">
                    <table class="table table-dark table-hover border-secondary">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.StaffList != null && Model.StaffList.Count > 0)
                            {
                                @foreach (var staff in Model.StaffList)
                                {
                                    <tr>
                                        <td>@staff.FullName</td>
                                        <td>@staff.Email</td>
                                        <td>@staff.Phone</td>
                                        <td>
                                            @if (staff.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-info">Edit</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No staff members registered yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>