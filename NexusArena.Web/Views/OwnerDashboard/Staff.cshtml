@model NexusArena.MVC.Models.StaffPageViewModel
@{
    ViewData["Title"] = "Manage Staff";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<style>
    body {
        background-color: #121212;
        color: white;
    }

    .card {
        background-color: #1e1e1e;
        border: 1px solid #333;
        padding: 25px;
        border-radius: 8px;
        color: white;
        margin-bottom: 20px;
    }

    .form-control {
        background-color: #2b2b2b;
        border: 1px solid #444;
        color: white;
    }

        .form-control:focus {
            background-color: #333;
            border-color: #00e676;
            box-shadow: none;
            color: white;
        }

    .btn-green {
        background-color: #219653;
        color: white;
        font-weight: bold;
        padding: 10px;
        border: none;
    }

        .btn-green:hover {
            background-color: #27ae60;
            color: white;
        }

    .btn-edit {
        background-color: transparent;
        color: #4dabf7;
        border: 1px solid #4dabf7;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        text-decoration: none;
        display: inline-block;
    }

        .btn-edit:hover {
            background-color: #4dabf7;
            color: #121212;
        }

    table {
        width: 100%;
        color: white;
        border-collapse: collapse;
    }

    th {
        border-bottom: 2px solid #444;
        padding: 12px 10px;
        color: #ccc;
        font-size: 0.9rem;
        font-weight: bold;
    }

    td {
        border-bottom: 1px solid #333;
        padding: 15px 10px;
        font-size: 0.9rem;
        vertical-align: middle;
    }

    .badge-active {
        background-color: rgba(0, 230, 118, 0.2);
        color: #00e676;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        border: 1px solid #00e676;
    }
</style>

<div class="container-fluid mt-4">
    <h2 class="text-success fw-bold mb-4">Owner Portal</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <h5 class="mb-4 fw-bold">Add New Staff</h5>
                <form asp-action="RegisterStaff" method="post">
                    <div class="mb-3">
                        <label class="form-label text-light">Full Name</label>
                        <input type="text" name="FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light">Email Address</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light">Phone Number</label>
                        <input type="text" name="Phone" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-light">Temporary Password</label>
                        <input type="password" name="Password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-green w-100 rounded">Register Staff</button>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <h5 class="mb-4 fw-bold">Existing Staff Members</h5>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.StaffList != null)
                            {
                                foreach (var staff in Model.StaffList)
                                {
                                    <tr>
                                        <td>@staff.FullName</td>
                                        <td>@staff.Email</td>
                                        <td>@staff.Phone</td>
                                        <td><span class="badge-active">Active</span></td>
                                        <td>
                                            <a href="/OwnerDashboard/EditStaff?email=@staff.Email" class="btn-edit">Edit</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>