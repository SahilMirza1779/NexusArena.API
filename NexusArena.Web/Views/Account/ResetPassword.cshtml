@{
    ViewData["Title"] = "Create New Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Create New Password - Nexus Arena</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0a0a0a; color: #fff; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .reset-card { background: #1a1a1a; padding: 40px; border-radius: 20px; border: 1px solid #333; width: 100%; max-width: 450px; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
        
        .input-wrapper { position: relative; margin-bottom: 20px; }
        
        .input-wrapper i.icon-left { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #888; font-size: 16px; transition: 0.3s; pointer-events: none; }
        
        .input-wrapper i.icon-right { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #888; font-size: 16px; transition: 0.3s; cursor: pointer; pointer-events: auto; }
        .input-wrapper i.icon-right:hover { color: #fff; }

        .custom-input { background: #222; border: 1px solid #444; color: #fff; padding: 14px 45px; border-radius: 12px; width: 100%; font-size: 15px; transition: all 0.3s; }
        .custom-input:focus { border-color: #00ff7f; box-shadow: 0 0 15px rgba(0, 255, 127, 0.15); outline: none; background: #2a2a2a; }
        
        .custom-input:focus + i.icon-left { color: #00ff7f; } 
        
        .btn-submit { background: #00ff7f; color: #000; font-weight: 800; width: 100%; padding: 14px; border: none; border-radius: 12px; transition: 0.3s; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; }
        .btn-submit:hover { background: #00cc66; transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0, 255, 127, 0.4); }
    </style>
</head>
<body>
    <div class="reset-card">
        <div class="text-center mb-4">
            <h3 style="font-weight: 900; color: #fff; letter-spacing: 1px;">New <span style="color: #00ff7f;">Password</span></h3>
            <p style="color: #aaa; font-size: 14px;">Set a new secure password for your account.</p>
            <span class="badge bg-dark border border-secondary text-light mt-2 p-2">@ViewBag.VerifiedEmail</span>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" style="background: rgba(255,0,0,0.1); border: 1px solid red; color: #ff4d4d; font-size: 14px; border-radius: 10px;">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account" asp-action="SaveNewPassword" method="post">
            <input type="hidden" name="email" value="@ViewBag.VerifiedEmail" />

            <label style="font-size: 11px; color: #aaa; margin-bottom: 8px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">New Password</label>
            <div class="input-wrapper">
                <input type="password" id="newPassword" name="newPassword" class="custom-input" placeholder="Enter new password" required minlength="6" />
                <i class="fas fa-lock icon-left"></i>
                <i class="fas fa-eye icon-right" onclick="toggleVisibility('newPassword', this)"></i>
            </div>

            <label style="font-size: 11px; color: #aaa; margin-bottom: 8px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">Confirm Password</label>
            <div class="input-wrapper">
                <input type="password" id="confirmPassword" name="confirmPassword" class="custom-input" placeholder="Re-enter new password" required minlength="6" />
                <i class="fas fa-check-circle icon-left"></i>
                <i class="fas fa-eye icon-right" onclick="toggleVisibility('confirmPassword', this)"></i>
            </div>

            <button type="submit" class="btn-submit mt-3">Save & Login <i class="fas fa-sign-in-alt ms-2"></i></button>
        </form>
    </div>

    <script>
        function toggleVisibility(inputId, iconElement) {
            var input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
                iconElement.style.color = "#00ff7f";
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
                iconElement.style.color = "#888"; 
            }
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        @if (ViewBag.Success != null)
        {
            <text>
            Swal.fire({
                title: 'Success!',
                text: '@ViewBag.Success',
                icon: 'success',
                background: '#1a1a1a',
                color: '#fff',
                iconColor: '#00ff7f',
                confirmButtonColor: '#00ff7f',
                confirmButtonText: '<span style="color: #000; font-weight: bold;">Go to Login</span> <i class="fas fa-sign-in-alt" style="color: #000;"></i>',
                allowOutsideClick: false 
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Login", "Account")';
                }
            });
            </text>
        }
    </script>
</body>
</html>
