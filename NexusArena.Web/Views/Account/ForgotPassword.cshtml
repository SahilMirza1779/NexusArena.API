@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Forgot Password - Nexus Arena</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0a0a0a; color: #fff; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .reset-card { background: #1a1a1a; padding: 40px; border-radius: 20px; border: 1px solid #333; width: 100%; max-width: 450px; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
        
        .input-wrapper { position: relative; margin-bottom: 25px; }
        .input-wrapper i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #888; font-size: 16px; transition: 0.3s; pointer-events: none; }
        
        .custom-input { background: #222; border: 1px solid #444; color: #fff; padding: 14px 15px 14px 45px; border-radius: 12px; width: 100%; font-size: 15px; transition: all 0.3s; }
        .custom-input:focus { border-color: #00ff7f; box-shadow: 0 0 15px rgba(0, 255, 127, 0.15); outline: none; background: #2a2a2a; }
        
        .custom-input:focus + i { color: #00ff7f; } 
        
        .btn-submit { background: #00ff7f; color: #000; font-weight: 800; width: 100%; padding: 14px; border: none; border-radius: 12px; transition: 0.3s; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; }
        .btn-submit:hover { background: #00cc66; transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0, 255, 127, 0.4); }

        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus, 
        input:-webkit-autofill:active{
            -webkit-box-shadow: 0 0 0 30px #222 inset !important; 
            -webkit-text-fill-color: #fff !important; 
            transition: background-color 5000s ease-in-out 0s; 
        }
    </style>
</head>
<body>
    <div class="reset-card">
        <div class="text-center mb-4">
            <h3 style="font-weight: 900; color: #fff; letter-spacing: 1px;">Reset <span style="color: #00ff7f;">Password</span></h3>
            <p style="color: #aaa; font-size: 14px;">Enter your email to receive a new password.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" style="background: rgba(255,0,0,0.1); border: 1px solid red; color: #ff4d4d; font-size: 14px; border-radius: 10px;">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <label style="font-size: 11px; color: #aaa; margin-bottom: 8px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">Registered Email Address</label>
            
            <div class="input-wrapper">
                <input type="email" name="email" class="custom-input" placeholder="johndoe@example.com" required />
                <i class="fas fa-envelope"></i>
            </div>

            <button type="submit" class="btn-submit">Send OTP <i class="fas fa-paper-plane ms-2"></i></button>
        </form>
        
        <div class="text-center mt-4">
            <a asp-action="Login" style="color: #888; text-decoration: none; font-size: 14px; transition: 0.3s;" onmouseover="this.style.color='#00ff7f'" onmouseout="this.style.color='#888'">
                <i class="fas fa-arrow-left me-1"></i> Back to Login
            </a>
        </div>
    </div>
</body>
</html>