@{
    ViewData["Title"] = "Login - Nexus Arena";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
            body {
                background-color: #121212; 
                color: #ffffff;
                font-family: 'Montserrat', sans-serif;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                margin: 0;
            }
            .login-container {
                background-color: #1e1e1e;
                padding: 40px;
                border-radius: 12px;
                box-shadow: 0 8px 32px rgba(0, 255, 127, 0.1);
                width: 100%;
                max-width: 400px;
                text-align: center;
            }
            .logo {
                font-size: 28px;
                font-weight: 700;
                margin-bottom: 30px;
                letter-spacing: 2px;
            }
            .logo span {
                color: #00ff7f;
            }
            .form-group {
                margin-bottom: 20px;
                text-align: left;
            }
            .form-control {
                width: 100%;
                padding: 12px;
                background-color: #2a2a2a;
                border: 1px solid #333;
                border-radius: 6px;
                color: white;
                box-sizing: border-box;
                margin-top: 5px;
            }
            .form-control:focus {
                outline: none;
                border-color: #00ff7f;
            }
            .btn-login {
                width: 100%;
                padding: 14px;
                background-color: #00ff7f;
                color: #121212;
                border: none;
                border-radius: 6px;
                font-weight: 600;
                font-size: 16px;
                cursor: pointer;
                transition: 0.3s;
                margin-top: 10px;
            }
            .btn-login:hover {
                background-color: #00cc66;
                box-shadow: 0 0 15px rgba(0, 255, 127, 0.4);
            }
            .error-msg {
                color: #ff4c4c;
                font-size: 14px;
                margin-bottom: 15px;
            }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="logo">NEXUS <span>ARENA</span></div>
        
        @if (ViewBag.Error != null)
        {
            <div class="error-msg">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="Enter your email" required />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter password" required />
            </div>
            <button type="submit" class="btn-login">SYSTEM LOGIN</button>
        </form>
    </div>

</body>
</html>