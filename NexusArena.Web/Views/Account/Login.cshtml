@{
    ViewData["Title"] = "System Login";
    Layout = null; 
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Login - Nexus Arena</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0a0a0a; color: #fff; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .login-card { background: #1a1a1a; padding: 40px; border-radius: 20px; border: 1px solid #333; width: 100%; max-width: 450px; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
        
        .input-wrapper { position: relative; margin-bottom: 20px; }
        .input-wrapper i.icon-left { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #888; font-size: 16px; transition: 0.3s; pointer-events: none; }
        .input-wrapper i.icon-right { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #888; font-size: 16px; transition: 0.3s; cursor: pointer; pointer-events: auto; }
        .input-wrapper i.icon-right:hover { color: #fff; }

        .custom-input { background: #222; border: 1px solid #444; color: #fff; padding: 14px 45px; border-radius: 12px; width: 100%; font-size: 15px; transition: all 0.3s; box-sizing: border-box; }
        .custom-input:focus { border-color: #00ff7f; box-shadow: 0 0 15px rgba(0, 255, 127, 0.15); outline: none; background: #2a2a2a; }
        .custom-input:focus + i.icon-left { color: #00ff7f; }

        .btn-submit { background: #00ff7f; color: #000; font-weight: 800; width: 100%; padding: 14px; border: none; border-radius: 12px; transition: 0.3s; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; }
        .btn-submit:hover { background: #00cc66; transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0, 255, 127, 0.4); }

        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus, 
        input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 30px #222 inset !important; 
            -webkit-text-fill-color: #fff !important; 
            transition: background-color 5000s ease-in-out 0s; 
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <img src="/images/logo.jpg" alt="Nexus Arena Logo" style="height: 70px; object-fit: contain; margin-bottom: 15px; border-radius: 8px;" />
            
            <h3 style="font-weight: 800; color: #fff; letter-spacing: 1px;">System Login</h3>
            <p style="color: #aaa; font-size: 14px;">Access your Nexus Arena dashboard</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" style="background: rgba(255,0,0,0.1); border: 1px solid red; color: #ff4d4d; font-size: 14px; border-radius: 10px;">
                @ViewBag.Error
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="background: rgba(0,255,127,0.1); border: 1px solid #00ff7f; color: #00ff7f; font-size: 14px; border-radius: 10px;">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" onsubmit="saveCredentials()">
            
            <div class="input-wrapper">
                <input type="email" id="loginEmail" name="email" class="custom-input" placeholder="Email Address" required />
                <i class="fas fa-envelope icon-left"></i>
            </div>

            <div class="input-wrapper">
                <input type="password" id="loginPassword" name="password" class="custom-input" placeholder="Password" required />
                <i class="fas fa-lock icon-left"></i>
                <i class="fas fa-eye icon-right" onclick="toggleVisibility('loginPassword', this)"></i>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                <div class="d-flex align-items-center">
                    <input type="checkbox" id="rememberMe" name="rememberMe" style="cursor: pointer; accent-color: #00ff7f; transform: scale(1.2);" />
                    <label for="rememberMe" style="color: #aaa; font-size: 13px; margin-left: 10px; cursor: pointer;">Remember me</label>
                </div>
                <a asp-controller="Account" asp-action="ForgotPassword" style="color: #00ff7f; text-decoration: none; font-size: 13px; font-weight: 600; transition: 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#00ff7f'">Forgot Password?</a>
            </div>

            <button type="submit" class="btn-submit">LOGIN NOW</button>
        </form>

        <div class="text-center mt-4">
            <a href="/" style="color: #888; text-decoration: none; font-size: 14px; transition: 0.3s;" onmouseover="this.style.color='#00ff7f'" onmouseout="this.style.color='#888'">
                <i class="fas fa-arrow-left me-1"></i> Back to Homepage
            </a>
        </div>
    </div>

    <script>
        function toggleVisibility(inputId, iconElement) {
            var input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.remove("fa-eye");
                iconElement.classList.add("fa-eye-slash");
                iconElement.style.color = "#00ff7f";
            } else {
                input.type = "password";
                iconElement.classList.remove("fa-eye-slash");
                iconElement.classList.add("fa-eye");
                iconElement.style.color = "#888";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (localStorage.getItem("nexusSavedEmail")) {
                document.getElementById("loginEmail").value = localStorage.getItem("nexusSavedEmail");
                document.getElementById("loginPassword").value = localStorage.getItem("nexusSavedPassword");
                document.getElementById("rememberMe").checked = true;
            }
        });

        function saveCredentials() {
            var emailBox = document.getElementById("loginEmail").value;
            var passBox = document.getElementById("loginPassword").value;
            var checkBox = document.getElementById("rememberMe").checked;

            if (checkBox) {
                localStorage.setItem("nexusSavedEmail", emailBox);
                localStorage.setItem("nexusSavedPassword", passBox);
            } else {
                localStorage.removeItem("nexusSavedEmail");
                localStorage.removeItem("nexusSavedPassword");
            }
        }
    </script>
</body>
</html>