@{
    ViewData["Title"] = "Player Registration";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Register - Nexus Arena</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0a0a0a; color: #fff; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; padding: 20px 0; }
        .register-card { background: #1a1a1a; padding: 40px; border-radius: 20px; border: 1px solid #333; width: 100%; max-width: 500px; box-shadow: 0 10px 40px rgba(0,0,0,0.8); }
        .form-label { font-size: 12px; color: #aaa; margin-bottom: 5px; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px; }
        .form-control, .form-select { background: #222; border: 1px solid #444; color: #fff; padding: 12px; border-radius: 10px; margin-bottom: 10px; width: 100%; }
        .form-control:focus, .form-select:focus { border-color: #3498db; box-shadow: 0 0 10px rgba(52, 152, 219, 0.3); background: #222; color: #fff; outline: none; }
        .form-select option { background: #1a1a1a; color: #fff; }
        .btn-submit { background: #3498db; color: #fff; font-weight: 700; width: 100%; padding: 12px; border: none; border-radius: 10px; transition: 0.3s; margin-top: 10px; }
        .btn-submit:hover { background: #2980b9; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4); }
        
        .invalid-feedback { font-size: 12px; color: #ff4d4d; margin-bottom: 15px; }
        .was-validated .form-control:invalid, .was-validated .form-select:invalid { border-color: #ff4d4d; background-image: none; }
        .was-validated .form-control:valid, .was-validated .form-select:valid { border-color: #00ff7f; background-image: none; }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="text-center mb-4">
            <h3 style="font-weight: 800; color: #fff;">Join <span style="color: #3498db;">Nexus Arena</span></h3>
            <p style="color: #aaa; font-size: 14px;">Register as a Player & start booking</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" style="background: rgba(255,0,0,0.1); border: 1px solid red; color: #ff4d4d; font-size: 14px;">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post" class="needs-validation" novalidate>
            
            <label class="form-label">Full Name</label>
            <input type="text" name="fullName" class="form-control" placeholder="e.g. Sahil Mirza" required minlength="3" />
            <div class="invalid-feedback">Please enter your valid full name.</div>

            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="player@example.com" required />
            <div class="invalid-feedback">Please enter a proper email address.</div>

            <label class="form-label">Mobile Number</label>
            <input type="text" name="phone" class="form-control" placeholder="10-digit mobile number" required pattern="[0-9]{10}" maxlength="10" />
            <div class="invalid-feedback">Please enter exactly 10 digits.</div>

            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">City</label>
                    <select name="city" class="form-select" required>
                        <option value="" disabled>Select City</option>
                        <option value="Surat" selected>Surat</option>
                        <option value="Mumbai">Mumbai</option>
                        <option value="Ahmedabad">Ahmedabad</option>
                        <option value="Pune">Pune</option>
                    </select>
                    <div class="invalid-feedback">City is required.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Favorite Sport</label>
                    <select name="favoriteSport" class="form-select" required>
                        <option value="" disabled selected>Select Sport</option>
                        <option value="Cricket">Cricket</option>
                        <option value="Football">Football</option>
                        <option value="Tennis">Tennis</option>
                        <option value="Pool">8-Ball Pool</option>
                    </select>
                    <div class="invalid-feedback">Sport is required.</div>
                </div>
            </div>

            <div style="background: rgba(52, 152, 219, 0.1); border-left: 3px solid #3498db; padding: 12px; margin-bottom: 20px; border-radius: 5px; margin-top: 15px;">
                <small style="color: #3498db;"><i class="fas fa-lock me-1"></i> A secure password will be automatically generated and sent to your Email ID.</small>
            </div>

            <button type="submit" class="btn-submit">Register Now <i class="fas fa-arrow-right ms-2"></i></button>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Login" style="color: #aaa; text-decoration: none; font-size: 14px;">Already have an account? <span style="color: #3498db;">Login</span></a>
        </div>
    </div>

    <script>
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')

            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
</body>
</html>