@model NexusArena.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_PlayerLayout.cshtml";
}

<div style="max-width: 1000px; margin: 0 auto; padding-bottom: 40px;">
    
    <div style="margin-bottom: 40px;">
        <h1 style="margin: 0; font-size: 2.5rem; font-weight: 800; color: #fff; letter-spacing: -0.5px;">My <span style="color: #00ff66;">Profile</span> 👤</h1>
        <p style="color: #888; font-size: 1.1rem; margin-top: 10px;">Manage your personal details and account security.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background: rgba(0,255,102,0.1); color: #00ff66; border: 1px solid #00ff66; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: 600;">
            <i class="fas fa-check-circle"></i> @Html.Raw(TempData["Success"])
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: rgba(255,71,87,0.1); color: #ff4757; border: 1px solid #ff4757; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: 600;">
            <i class="fas fa-exclamation-circle"></i> @Html.Raw(TempData["Error"])
        </div>
    }

    <div style="display: grid; grid-template-columns: minmax(300px, 1fr) minmax(400px, 2fr); gap: 30px; align-items: start;">
        
        <div style="background: linear-gradient(145deg, #161616, #1a1a1a); padding: 40px 30px; border-radius: 16px; border: 1px solid #2a2a2a; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <div style="width: 130px; height: 130px; background: rgba(0, 255, 102, 0.1); border: 2px solid #00ff66; border-radius: 50%; margin: 0 auto 25px auto; display: flex; align-items: center; justify-content: center; font-size: 3.5rem; color: #00ff66; font-weight: bold; box-shadow: 0 0 20px rgba(0, 255, 102, 0.2);">
                @(string.IsNullOrEmpty(Model?.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
            </div>
            <h3 style="color: #fff; margin: 0 0 10px 0; font-size: 1.5rem; font-weight: 700;">@(Model?.FullName ?? "User Name")</h3>
            <span style="background-color: rgba(0, 195, 255, 0.1); color: #00c3ff; padding: 6px 15px; border-radius: 20px; font-size: 0.85rem; font-weight: 700; border: 1px solid rgba(0, 195, 255, 0.3);">Player Account</span>
        </div>

        <div style="background: linear-gradient(145deg, #111, #161616); padding: 40px; border-radius: 16px; border: 1px solid #2a2a2a; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <h3 style="color: #fff; margin-top: 0; margin-bottom: 25px; font-size: 1.4rem; font-weight: 700; border-bottom: 1px solid #2a2a2a; padding-bottom: 15px;">
                <i class="fas fa-user-edit" style="color: #00ff66; margin-right: 10px;"></i> Edit Details
            </h3>

            <form method="post" action="/Profile/Update">
                <div style="margin-bottom: 25px;">
                    <label style="color: #bbb; font-size: 0.9rem; font-weight: 600; display: block; margin-bottom: 8px;">Full Name</label>
                    <input asp-for="FullName" type="text" required style="width: 100%; padding: 14px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 8px; outline: none; font-size: 1rem; transition: 0.3s;" onfocus="this.style.borderColor='#00ff66'" onblur="this.style.borderColor='#333'">
                    <span asp-validation-for="FullName" style="color: #ff4c4c; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
                </div>

                <div style="margin-bottom: 25px;">
                    <label style="color: #bbb; font-size: 0.9rem; font-weight: 600; display: block; margin-bottom: 8px;">Email Address</label>
                    <input asp-for="Email" type="email" required style="width: 100%; padding: 14px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 8px; outline: none; font-size: 1rem; transition: 0.3s;" onfocus="this.style.borderColor='#00ff66'" onblur="this.style.borderColor='#333'">
                    <span asp-validation-for="Email" style="color: #ff4c4c; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
                </div>

                <div style="margin-bottom: 30px;">
                    <label style="color: #bbb; font-size: 0.9rem; font-weight: 600; display: block; margin-bottom: 8px;">Phone Number</label>
                    <input asp-for="PhoneNumber" type="text" style="width: 100%; padding: 14px; background-color: #0f0f0f; border: 1px solid #333; color: #fff; border-radius: 8px; outline: none; font-size: 1rem; transition: 0.3s;" onfocus="this.style.borderColor='#00ff66'" onblur="this.style.borderColor='#333'">
                    <span asp-validation-for="PhoneNumber" style="color: #ff4c4c; font-size: 0.85rem; margin-top: 5px; display: block;"></span>
                </div>

                <button type="submit" style="width: 100%; background-color: #00ff66; color: #111; border: none; padding: 14px 30px; border-radius: 8px; font-weight: 800; font-size: 1rem; cursor: pointer; transition: 0.3s; box-shadow: 0 4px 15px rgba(0, 255, 102, 0.2);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(0, 255, 102, 0.4)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0, 255, 102, 0.2)';">
                    <i class="fas fa-save" style="margin-right: 5px;"></i> Save Changes
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}