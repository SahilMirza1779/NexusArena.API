<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Arena</title>
    <link rel="icon" type="image/jpg" href="~/images/logo.jpg">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            margin: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: #121212; 
            color: #ffffff;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 260px;
            background-color: #1a1a1a;
            border-right: 1px solid #333;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 25px 20px;
            text-align: center;
            border-bottom: 1px solid #333;
            background: linear-gradient(180deg, rgba(0, 255, 127, 0.05) 0%, rgba(26, 26, 26, 1) 100%);
        }
        
        .sidebar-logo {
            max-width: 160px; 
            height: auto;
            display: inline-block;
            border-radius: 12px; 
            box-shadow: 0 0 10px rgba(0, 255, 127, 0.2);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
        }
        
        .sidebar-logo:hover {
            box-shadow: 0 0 20px rgba(0, 255, 127, 0.8), 0 0 40px rgba(0, 255, 127, 0.4); 
            transform: scale(1.08) translateY(-3px);
            filter: brightness(1.1);
        }

        .nav-links {
            list-style: none;
            padding: 0;
            margin: 20px 0;
            overflow-y: auto;
        }
        .nav-links li { margin-bottom: 10px; }
        .nav-links a {
            display: block;
            padding: 15px 25px;
            color: #ccc;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }
        .nav-links a:hover, .nav-links a.active {
            background-color: #2a2a2a;
            color: #00ff7f;
            border-left: 4px solid #00ff7f;
        }
        .nav-links i { margin-right: 15px; width: 20px; text-align: center; }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        
        .topbar {
            height: 70px;
            background-color: #1a1a1a;
            border-bottom: 1px solid #333;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }
        .topbar .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }
        .logout-btn {
            color: #ff4c4c;
            text-decoration: none;
            font-weight: 600;
        }

        .page-content {
            padding: 30px;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 45px;
            background-color: #1a1a1a;
            min-width: 200px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.5);
            border: 1px solid #333;
            border-radius: 8px;
            z-index: 1000;
            overflow: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
        }

        .dropdown-content.show {
            display: block;
            transform: translateY(0);
        }

        .dropdown-item {
            color: #ddd;
            padding: 12px 18px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            transition: background 0.2s;
        }

        .dropdown-item i { width: 18px; color: #00ff7f; text-align: center; }

        .dropdown-item:hover { background-color: #2a2a2a; color: #fff; text-decoration: none; }

        .dropdown-divider { height: 1px; background-color: #333; margin: 0; }

        .logout-text { color: #ff4d4d !important; }
        .logout-text i { color: #ff4d4d !important; }
        .logout-text:hover { background-color: rgba(255, 77, 77, 0.1) !important; }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.8/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.8/dist/sweetalert2.all.min.js"></script>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand">
            <a href="/SuperAdminDashboard/Index">
                <img src="~/images/logo.jpg" alt="Nexus Arena Logo" class="sidebar-logo" />
            </a>
        </div>
        <ul class="nav-links">
            <li class="nav-item">
                <a class="nav-link" href="/SuperAdminDashboard/Index">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <li class="nav-item"><a class="nav-link" href="/SuperAdminDashboard/Arenas"><i class="fas fa-building"></i> Arenas</a></li>
            <li class="nav-item"><a class="nav-link" href="/SuperAdminDashboard/Owners"><i class="fas fa-user-tie"></i> Owners</a></li>
            <li class="nav-item"><a class="nav-link" href="/SuperAdminDashboard/Categories"><i class="fas fa-list"></i> Categories</a></li>
            <li class="nav-item"><a class="nav-link" href="/SuperAdminDashboard/Users"><i class="fas fa-users"></i> Users</a></li>
            <li class="nav-item">
                <a class="nav-link" href="/SuperAdminDashboard/Receptionists">
                    <i class="fas fa-id-badge"></i> Receptionists
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/SuperAdminDashboard/Reviews">
                    <i class="fas fa-star"></i> Reviews
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/SuperAdminDashboard/Revenue">
                    <i class="fas fa-wallet"></i> Revenue
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/SuperAdminDashboard/Broadcast">
                    <i class="fas fa-bullhorn"></i> Broadcast
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div>
                <h3 style="margin:0; color:#00ff7f;">SuperAdmin Portal</h3>
            </div>
            <div class="profile-dropdown-wrapper" style="position: relative; display: inline-block;">
                <button class="profile-btn" onclick="toggleProfileDropdown()" style="background: none; border: none; color: #fff; font-size: 16px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-user-circle" style="font-size: 22px;"></i> Boss Sahil <i class="fas fa-caret-down" style="font-size: 14px; margin-left: 5px;"></i>
                </button>
    
                <div id="profileMenu" class="dropdown-content">
                    <a href="/SuperAdminDashboard/AdminDetails" class="dropdown-item">
                        <i class="fas fa-id-card"></i> Admin Details
                    </a>
                    <a href="/SuperAdminDashboard/UpdateDetails" class="dropdown-item">
                        <i class="fas fa-user-edit"></i> Update Details
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="javascript:void(0)" class="dropdown-item logout-text" onclick="confirmLogout()">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </div>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleProfileDropdown() {
            document.getElementById("profileMenu").classList.toggle("show");
        }

        function confirmLogout() {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to log out?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ff4d4d', 
                cancelButtonColor: '#444',     
                confirmButtonText: '<i class="fas fa-sign-out-alt"></i> Yes, Logout',
                cancelButtonText: 'Cancel',
                background: '#1a1a1a',         
                color: '#ffffff',              
                iconColor: '#ffc107',          
                borderRadius: '12px'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Account/Login';
                }
            });
        }

        window.onclick = function(event) {
            if (!event.target.closest('.profile-btn')) {
                var dropdowns = document.getElementsByClassName("dropdown-content");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }

        function confirmSuspend(arenaId) {
            Swal.fire({
            title: 'Deactivate Arena?',
            text: "Are you sure you want to suspend this arena?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ff4d4d',
            cancelButtonColor: '#333',
            confirmButtonText: 'Yes, Suspend it!',
            background: '#1a1a1a', 
            color: '#fff',
            iconColor: '#ff4d4d'
            }).then((result) => {
                if (result.isConfirmed) {
                    performSuspend(arenaId);
                }
            });
        }

        function performSuspend(id) {
            fetch('/SuperAdminDashboard/SuspendArena/' + id, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
            if(data.success) {
                Swal.fire({
                    title: 'Suspended!',
                    text: 'Arena has been deactivated.',
                    icon: 'success',
                    background: '#1a1a1a',
                    color: '#fff',
                    confirmButtonColor: '#00ff7f'
                }).then(() => window.location.reload());
            }
            }); 
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>