<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Arena</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            margin: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: #121212; 
            color: #ffffff;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar-logo {
            max-width: 160px; 
            height: auto;
            display: inline-block;
            filter: drop-shadow(0 0 3px rgba(0, 255, 127, 0.2));
        }
        .sidebar-brand {
            padding: 20px;
            font-size: 24px;
            font-weight: 700;
            text-align: center;
            border-bottom: 1px solid #333;
        }
        .sidebar-brand span { color: #00ff7f; }
        
        .nav-links {
            list-style: none;
            padding: 0;
            margin: 20px 0;
        }
        .nav-links li { margin-bottom: 10px; }
        .nav-links a {
            display: block;
            padding: 15px 25px;
            color: #ccc;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }
        .nav-links a:hover, .nav-links a.active {
            background-color: #2a2a2a;
            color: #00ff7f;
            border-left: 4px solid #00ff7f;
        }
        .nav-links i { margin-right: 15px; width: 20px; text-align: center; }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        
        .topbar {
            height: 70px;
            background-color: #1a1a1a;
            border-bottom: 1px solid #333;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }
        .topbar .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }
        .logout-btn {
            color: #ff4c4c;
            text-decoration: none;
            font-weight: 600;
        }

        .page-content {
            padding: 30px;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand" style="padding: 15px 0; border-bottom: 1px solid #333; text-align: center;">
            <img src="~/images/logo.jpg" alt="Nexus Arena Logo" class="sidebar-logo" />
        </div>
        <ul class="nav-links">
            <li class="nav-item">
                <a class="nav-link" href="/SuperAdminDashboard/Index">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <a href="/SuperAdminDashboard/Arenas"><i class="fas fa-building"></i> Arenas</a>
            <a href="/SuperAdminDashboard/Owners"><i class="fas fa-user-tie"></i> Owners</a>
            <a href="/SuperAdminDashboard/Categories"><i class="fas fa-list"></i> Categories</a>
            <a href="/SuperAdminDashboard/Users"><i class="fas fa-users"></i> Users</a>
            <li class="nav-item">
                <a class="nav-link" href="/SuperAdminDashboard/Receptionists">
                    <i class="fas fa-id-badge"></i> Receptionists
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/SuperAdminDashboard/Reviews">
                    <i class="fas fa-star"></i> Reviews
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div>
                <h3 style="margin:0; color:#00ff7f;">SuperAdmin Portal</h3>
            </div>
            <div class="user-profile">
                <span><i class="fas fa-user-circle" style="font-size: 24px;"></i> Boss Sahil</span>
                <a href="/Account/Login" class="logout-btn" style="margin-left: 20px;"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </div>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>
    </div>

</body>
</html>