@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@{
    string loggedInName = "User";
    var jwToken = Context.Request.Cookies["JWToken"];

    if (!string.IsNullOrEmpty(jwToken))
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(jwToken);

            var nameClaim = jwt.Claims.FirstOrDefault(c => c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value;

            if (!string.IsNullOrWhiteSpace(nameClaim))
            {
                loggedInName = nameClaim;
            }
            else
            {
                var emailClaim = jwt.Claims.FirstOrDefault(c => c.Type == "sub")?.Value;
                if (!string.IsNullOrWhiteSpace(emailClaim) && emailClaim.Contains("@"))
                {
                    loggedInName = emailClaim.Split('@')[0];
                    loggedInName = char.ToUpper(loggedInName[0]) + loggedInName.Substring(1);
                }
            }
        }
        catch
        {
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Arena</title>
    <link rel="icon" type="image/jpg" href="~/images/logo.jpg">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        body {
            margin: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: #121212; 
            color: #ffffff;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 260px;
            background-color: #1a1a1a;
            border-right: 1px solid #333;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 25px 20px;
            text-align: center;
            border-bottom: 1px solid #333;
            background: linear-gradient(180deg, rgba(0, 255, 127, 0.05) 0%, rgba(26, 26, 26, 1) 100%);
        }
        
        .sidebar-logo {
            max-width: 160px; 
            height: auto;
            display: inline-block;
            border-radius: 12px; 
            box-shadow: 0 0 10px rgba(0, 255, 127, 0.2);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
        }
        
        .sidebar-logo:hover {
            box-shadow: 0 0 20px rgba(0, 255, 127, 0.8), 0 0 40px rgba(0, 255, 127, 0.4); 
            transform: scale(1.08) translateY(-3px);
            filter: brightness(1.1);
        }

        .nav-links {
            list-style: none;
            padding: 0;
            margin: 20px 0;
            overflow-y: auto;
        }
        .nav-links li { margin-bottom: 10px; }
        .nav-links a {
            display: block;
            padding: 15px 25px;
            color: #ccc;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }
        .nav-links a:hover, .nav-links a.active {
            background-color: #2a2a2a;
            color: #00ff7f;
            border-left: 4px solid #00ff7f;
        }
        .nav-links i { margin-right: 15px; width: 20px; text-align: center; }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        
        .topbar {
            height: 70px;
            background-color: #1a1a1a;
            border-bottom: 1px solid #333;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .page-content {
            padding: 30px;
        }

        .dropdown-menu-dark {
            background-color: #1a1a1a !important;
            border: 1px solid #333 !important;
            border-radius: 12px !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8) !important;
            padding: 12px 0 !important;
            margin-top: 10px !important;
        }
        .dropdown-menu-dark .dropdown-item {
            padding: 14px 20px !important;
            font-weight: 500;
            font-size: 15px;
            color: #ccc !important;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .dropdown-menu-dark .dropdown-item:hover {
            background-color: #252525 !important;
            color: #00ff7f !important;
        }
        .dropdown-menu-dark .dropdown-item i {
            color: #888;
            width: 22px;
            text-align: center;
            font-size: 18px;
            transition: 0.3s;
        }
        .dropdown-menu-dark .dropdown-item:hover i {
            color: #00ff7f;
        }
        
        .dropdown-menu-dark .logout-text { color: #ff4d4d !important; font-weight: 600; }
        .dropdown-menu-dark .logout-text i { color: #ff4d4d !important; }
        .dropdown-menu-dark .logout-text:hover,
        .dropdown-menu-dark .logout-text:hover i {
            color: #ff4d4d !important;
            background-color: rgba(255, 77, 77, 0.08) !important;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand">
            <a href="/ReceptionistDashboard/Index">
                <img src="~/images/logo.jpg" alt="Nexus Arena Logo" class="sidebar-logo" />
            </a>
        </div>
        <ul class="nav-links">
            <li class="nav-item">
                <a asp-controller="ReceptionistDashboard" asp-action="Index" class="nav-link">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="ReceptionistDashboard" asp-action="Bookings" class="nav-link">
                    <i class="fas fa-calendar-alt"></i> Bookings
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="ReceptionistDashboard" asp-action="AvailableTurfs" class="nav-link">
                    <i class="fas fa-futbol"></i> Available Turfs
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div>
                <h3 style="margin:0; color:#00ff7f; font-weight: 700;">Receptionist Portal</h3>
            </div>
            
            <div class="dropdown">
                <button class="btn text-white d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border: none; box-shadow: none; padding: 5px 10px; transition: 0.3s;">
                    <i class="fas fa-user-circle" style="font-size: 26px; color: #00ff7f;"></i>
                    <span style="font-weight: 600; font-size: 16px;">@loggedInName</span>
                    <i class="fas fa-chevron-down ms-1" style="font-size: 12px; color: #888;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" style="min-width: 240px;">
                    <li>
                        <a class="dropdown-item" href="/ReceptionistDashboard/Profile">
                            <i class="fas fa-id-badge"></i> Profile Details
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" style="border-color: #333; margin: 10px 0;"></li>
                    <li>
                        <a class="dropdown-item logout-text" href="javascript:void(0)" onclick="confirmLogout()">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        function confirmLogout() {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to log out?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ff4d4d', 
                cancelButtonColor: '#444',     
                confirmButtonText: '<i class="fas fa-sign-out-alt"></i> Yes, Logout',
                cancelButtonText: 'Cancel',
                background: '#1a1a1a',         
                color: '#ffffff',              
                iconColor: '#ffc107',          
                borderRadius: '12px'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Account/Logout';
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>