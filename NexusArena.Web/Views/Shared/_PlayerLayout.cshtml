<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Arena</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            margin: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: #0f0f0f;
            color: #ffffff;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }
        .sidebar {
            width: 260px;
            background-color: #1a1a1a;
            border-right: 1px solid #2a2a2a;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 15px rgba(0, 0, 0, 0.5);
        }
        .sidebar-brand {
            padding: 30px 20px 20px 20px;
            text-align: center;
            border-bottom: 1px solid #2a2a2a;
        }
        .sidebar-brand img {
            max-width: 180px;
            height: auto;
            filter: drop-shadow(0 0 10px rgba(0, 255, 102, 0.2));
        }
        .nav-links {
            list-style: none;
            padding: 0;
            margin: 20px 0;
        }
        .nav-links li { margin-bottom: 5px; }
        .nav-links a {
            display: block;
            padding: 16px 25px;
            color: #b3b3b3;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .nav-links a:hover, .nav-links a.active {
            background-color: #252525;
            color: #00ff66;
            border-left: 5px solid #00ff66;
        }
        .nav-links i { margin-right: 15px; width: 20px; text-align: center; color: #00ff66; }
        
        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        .topbar {
            height: 70px;
            background-color: #1a1a1a;
            border-bottom: 1px solid #2a2a2a;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }
        .topbar .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            font-weight: 600;
        }
        .wallet-badge {
            background-color: #0f0f0f;
            padding: 8px 15px;
            border-radius: 6px;
            font-size: 14px;
            border: 1px solid #00ff66;
            color: #00ff66;
            box-shadow: 0 0 8px rgba(0, 255, 102, 0.2);
        }
        .logout-btn {
            background-color: #2a2a2a;
            padding: 8px 15px;
            border-radius: 6px;
            color: #ff4c4c;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }
        .logout-btn:hover { background-color: #ff4c4c; color: white; }
        .page-content {
            padding: 40px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <img src="~/images/logo.jpg" alt="Nexus Arena Logo" />
        </div>
        <ul class="nav-links">  
            <li><a href="/UserDashboard/Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "UserDashboard" ? "active" : "")"><i class="fas fa-home"></i> My Dashboard</a></li>
            <li><a href="/Explore/Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Explore" ? "active" : "")"><i class="fas fa-search"></i> Explore Turfs</a></li>
            <li><a href="/BookingHistory/Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "BookingHistory" ? "active" : "")"><i class="fas fa-calendar-check"></i> My Bookings</a></li>
            <li><a href="/Review/Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Review" ? "active" : "")"><i class="fas fa-star"></i> Reviews</a></li>
            <li><a href="/Profile/Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Profile" ? "active" : "")"><i class="fas fa-user-cog"></i> My Profile</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div>
                <h3 style="margin:0; font-weight: 700; color: #fff;">Player Zone</h3>
            </div>
            <div class="user-profile">
                
                <div style="position: relative; margin-right: 20px; cursor: pointer;" onclick="toggleNotifications(event)">
                    <i class="fas fa-bell" style="font-size: 1.4rem; color: #fff; transition: 0.3s;" onmouseover="this.style.color='#00ff66'" onmouseout="this.style.color='#fff'"></i>
                    
                    <span id="notif-badge" style="position: absolute; top: -5px; right: -8px; background: #ff4c4c; color: #fff; font-size: 0.65rem; font-weight: 800; padding: 2px 6px; border-radius: 50%; display: none; box-shadow: 0 0 8px rgba(255, 76, 76, 0.5);">0</span>
                    
                    <div id="notif-dropdown" style="display: none; position: absolute; right: -10px; top: 35px; width: 340px; background: #161616; border: 1px solid #333; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.8); z-index: 1000; overflow: hidden; cursor: default;" onclick="event.stopPropagation()">
                        <div style="padding: 15px 20px; background: #1a1a1a; border-bottom: 1px solid #2a2a2a; display: flex; justify-content: space-between; align-items: center;">
                            <h4 style="margin: 0; color: #fff; font-size: 1.05rem; font-weight: 800;">System Alerts</h4>
                            <i class="fas fa-check-double" style="font-size: 0.8rem; color: #00ff66; cursor: pointer;" title="Mark all read"></i>
                        </div>
                        
                        <div id="notif-list" style="max-height: 350px; overflow-y: auto; padding: 0;">
                            <div style='padding: 20px; text-align: center; color: #666;'><i class='fas fa-spinner fa-spin'></i> Loading...</div>
                        </div>
                        
                        <a href="#" style="display: block; text-align: center; padding: 12px; background: #111; color: #00c3ff; font-size: 0.85rem; font-weight: 700; text-decoration: none; border-top: 1px solid #2a2a2a; transition: 0.3s;" onmouseover="this.style.background='#1a1a1a'" onmouseout="this.style.background='#111'">View Full History</a>
                    </div>
                </div>
                <div class="wallet-badge"><i class="fas fa-wallet"></i> ₹ 1,200</div>
                <a href="/Profile/Index" style="color: #fff; text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#00ff66'" onmouseout="this.style.color='#fff'">
                    <i class="fas fa-user-circle" style="font-size: 24px; color: #00ff66; vertical-align: middle;"></i> Zubeir
                </a>
                <a href="/Account/Login" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </div>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    title: 'Success!',
                    html: '@Html.Raw(TempData["Success"])', 
                    icon: 'success',
                    background: '#1a1a1a',
                    color: '#fff',
                    confirmButtonColor: '#00ff66'
                });
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    title: 'Oops...',
                    html: '@Html.Raw(TempData["Error"])', 
                    icon: 'error',
                    background: '#1a1a1a',
                    color: '#fff',
                    confirmButtonColor: '#ff4c4c'
                });
            });
        </script>
    }

    <script>
        function toggleNotifications(e) {
            e.stopPropagation();
            var dropdown = document.getElementById("notif-dropdown");
            dropdown.style.display = dropdown.style.display === "none" || dropdown.style.display === "" ? "block" : "none";
        }

        window.onclick = function(event) {
            if (!event.target.closest('.user-profile')) {
                var dropdown = document.getElementById("notif-dropdown");
                if(dropdown) dropdown.style.display = "none";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            fetch('/Notification/Fetch')
                .then(response => response.json())
                .then(res => {
                    if (res.count && res.count > 0) {
                        var badge = document.getElementById("notif-badge");
                        badge.innerText = res.count;
                        badge.style.display = "inline-block";
                    }

                    var notifList = document.getElementById("notif-list");
                    if (res.data && res.data.length > 0) {
                        notifList.innerHTML = ""; 
                        res.data.forEach(n => {
                            var bg = "rgba(0, 195, 255, 0.05)";
                            var border = "3px solid #00c3ff";
                            
                            var itemHtml = `
                                <div style="padding: 15px 20px; border-bottom: 1px solid #222; background: ${bg}; border-left: ${border}; transition: 0.3s;" onmouseover="this.style.background='#1a1a1a'" onmouseout="this.style.background='${bg}'">
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                                        <h5 style="margin: 0; color: #fff; font-size: 0.95rem; font-weight: 700;">${n.title}</h5>
                                        <span style="color: #666; font-size: 0.75rem;">${n.date}</span>
                                    </div>
                                    <p style="margin: 0; color: #aaa; font-size: 0.85rem; line-height: 1.4;">${n.message}</p>
                                </div>
                            `;
                            notifList.innerHTML += itemHtml;
                        });
                    } else {
                        notifList.innerHTML = "<div style='padding: 30px; text-align: center; color: #666;'><i class='fas fa-bell-slash' style='font-size: 2rem; margin-bottom: 10px;'></i><br/>No alerts for you.</div>";
                    }
                })
                .catch(err => console.log("Silent error:", err));
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>